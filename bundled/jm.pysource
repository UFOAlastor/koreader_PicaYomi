{"files":{"api.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/jm/api.lua\n-- 内置源 B 的 API 客户端\n--\n-- 通用返回结构为 { code, data }，data 需要经本源的 crypto 模块解码后再解析。\n--\n-- KOReader 侧需要注意:\n--   1. 不依赖自动 gzip 解压 -> 请求头显式要求 identity\n--   2. 图片走独立 CDN，不使用 API 域名\n--   3. 域名可能变动 -> 从配置源拉取并逐个探测可用性\n\nlocal json = ctx.json\nlocal logger = ctx.logger\nlocal _ = ctx.translate\nlocal T = ctx.text.template\nlocal HttpClient = ctx.http\nlocal config = ctx.config\nlocal SecretStore = ctx.secrets\nlocal Redact = ctx.redact\nlocal JN = ctx.values\n\nlocal Headers = require(\"headers\")\nlocal Crypto = require(\"crypto\")\n\nlocal Api = {}\n\nApi.current_domain = nil\nApi.img_host = nil\nApi.cookies = {}\nApi.album_cache = {}\n-- 专辑缓存的写入序号 (用于有界淘汰最久未写入的一条, 见 rememberAlbum)\nlocal album_cache_seq = {}\nApi.domains_checked = false\n-- 上一次请求把候选域名全试遍了还是失败 -> 下一次必须先重新发现, 不能走快路径\n-- (否则永远拿同一个死域名重试, 远端配置源里换过的新域名永远拿不到)\nApi.domain_discovery_needed = false\n-- 登录态必须显式记录: 普通请求也会下发会话 Cookie, 不能用\"有 Cookie\"判断已登录\nApi.logged_in = false\nApi.username = nil\n\nlocal DEFAULT_TIMEOUT = 15\n\n--- 墙钟 (秒, 带小数)\n--- 用 os.clock 量网络会得到 0.0s —— 那是 CPU 时间, 不是等待时间\n--- (老账: 0.9.5 之前整条链路的耗时都是这么量错的)。\nlocal function now()\n    local ok, socket = pcall(function() return {gettime=ctx.clock.now} end)\n    if ok and type(socket) == \"table\" and socket.gettime then\n        return socket.gettime()\n    end\n    return os.time()\nend\n\n-- ============================================================================\n-- HTTP 基础设施\n-- ============================================================================\n\nlocal Cookie = ctx.cookie\n\nlocal function cookieHeader()\n    return Cookie.toHeader(Api.cookies)\nend\n\n--- Cookie jar 的稳定指纹\n-- pairs 的遍历顺序不稳定, 不能直接拿 toHeader() 的结果比\"变没变\"。\nlocal function cookie_fingerprint()\n    if type(Api.cookies) ~= \"table\" then return \"\" end\n    local keys = {}\n    for k in pairs(Api.cookies) do keys[#keys + 1] = tostring(k) end\n    table.sort(keys)\n    local parts = {}\n    for _i, k in ipairs(keys) do\n        parts[#parts + 1] = k .. \"=\" .. tostring(Api.cookies[k])\n    end\n    return table.concat(parts, \"; \")\nend\n\nlocal cookie_fp = \"\"\nlocal last_cookie_save = 0\n-- 服务端可能每个响应都轮换 Cookie。每次都加密 + 写 config.json 在 e-ink 存储上\n-- 是明显的浪费; 60 秒内的中间变化先留在内存里, 到期后第一次响应再落盘。\nlocal COOKIE_SAVE_INTERVAL = 60\nApi._session_loaded = false\n\n--- 从磁盘恢复会话 Cookie (加密存储, 见 util/secret_store.lua)\nfunction Api.loadSavedCookies()\n    local raw = SecretStore.get(\"jm_cookies\")\n    if type(raw) ~= \"string\" or raw == \"\" then return false end\n    local ok, decoded = pcall(json.decode, raw)\n    if not ok or type(decoded) ~= \"table\" then return false end\n    Api.cookies = decoded\n    cookie_fp = cookie_fingerprint()\n    return true\nend\n\n--- 保存会话 Cookie; 没有变化时不写盘 (JM 可能每个响应都重发 Set-Cookie)\n-- @param force true = 跳过节流 (登录成功时用)\nfunction Api.saveCookies(force)\n    local fp = cookie_fingerprint()\n    if fp == cookie_fp then return true end\n    if fp == \"\" then\n        SecretStore.clear(\"jm_cookies\")\n        cookie_fp = \"\"\n        return true\n    end\n\n    local now = os.time()\n    if not force and last_cookie_save > 0\n        and (now - last_cookie_save) < COOKIE_SAVE_INTERVAL then\n        -- cookie_fp 不更新: 到期后的下一次调用会重新比较并落盘\n        return true\n    end\n\n    local ok, encoded = pcall(json.encode, Api.cookies)\n    if not ok or not encoded then return false end\n    local saved = SecretStore.set(\"jm_cookies\", encoded)\n    if saved then\n        cookie_fp = fp\n        last_cookie_save = now\n    end\n    return saved\nend\n\n--- 懒加载磁盘上的会话 (源初始化 / 第一次判断登录态时)\nfunction Api.ensureSessionLoaded()\n    if Api._session_loaded then return end\n    Api._session_loaded = true\n    Api.loadSavedCookies()\nend\n\n--- 当前内存里的 Cookie 是否代表一个**登录过**的会话\n-- 只看 Cookie 不够: 匿名浏览也会拿到 Cookie。jm_session 标记由登录成功写入,\n-- 退出时清掉 —— 它本身不是敏感信息。\nfunction Api.hasSavedSession()\n    Api.ensureSessionLoaded()\n    return config:get(\"jm_session\") == true and next(Api.cookies) ~= nil\nend\n\n--- 收集响应里的 Set-Cookie\n-- 漏掉会话 cookie 会导致所有需要登录的接口(收藏等)被当成匿名请求\n-- → 401 或\"成功但空列表\"。\nlocal function absorbCookies(resp)\n    if not resp or not resp.headers then return end\n    local n = Cookie.absorb(Api.cookies, resp.headers)\n    if n > 0 then\n        if logger.enabled then logger.dbg(\"Picayomi SourceB: 吸收 \" .. n .. \" 个 cookie\") end\n        -- 只持久化**登录后**的 Cookie: 匿名浏览的 Cookie 不该让下次启动\n        -- 误判为已登录 (登录本身在 Api.login 里显式保存)。\n        if Api.logged_in then\n            pcall(Api.saveCookies)\n        end\n    end\nend\n\n--- 原始请求 (返回解析后的响应体字符串)\nlocal function rawRequest(method, url, headers, body, timeout)\n    local resp, err = HttpClient:request(method, url, headers, body, timeout or DEFAULT_TIMEOUT)\n    if not resp then\n        return nil, err\n    end\n    absorbCookies(resp)\n    return resp\nend\n\n-- ============================================================================\n-- 域名发现与选择\n-- ============================================================================\n\n--- 从配置源拉取并解密域名列表\nfunction Api.fetchDomainsFromConfig()\n    for _idx, url in ipairs(Headers.DOMAIN_CONFIG_URLS) do\n        local resp = rawRequest(\"GET\", url, {\n            [\"user-agent\"] = Headers.UA,\n            [\"Accept-Encoding\"] = \"identity\",\n            [\"Accept\"] = \"*/*\",\n        }, nil, 10)\n\n        if resp and resp.body and #resp.body > 0 and (resp.status_code or 0) == 200 then\n            local text = Crypto.decrypt(resp.body, Headers.DOMAIN_SECRET)\n            if text then\n                local ok, parsed = pcall(json.decode, text)\n                if ok and parsed and type(parsed.Server) == \"table\" then\n                    local list = {}\n                    for _i, d in ipairs(parsed.Server) do\n                        local nd = Headers.normalizeDomain(d)\n                        if nd then table.insert(list, nd) end\n                    end\n                    if #list > 0 then\n                        if logger.enabled then logger.info(\"Picayomi SourceB: 从配置源获取到 \" .. #list .. \" 个域名\") end\n                        return list\n                    end\n                end\n            end\n        end\n    end\n    return {}\nend\n\n--- 候选域名 (配置缓存 -> 远端配置 -> 内置兜底)\nfunction Api.candidateDomains()\n    local override = ctx.getSetting(\"base_url\", \"\")\n    if override ~= \"\" then\n        assert(override:match(\"^https://[%w%.%-]+/?$\"), \"API 地址必须为 HTTPS 域名\")\n        return { Headers.normalizeDomain(override) }\n    end\n    local cached = config:get(\"jm_domains\")\n    if type(cached) == \"table\" and #cached > 0 then\n        return cached\n    end\n    return Headers.FALLBACK_DOMAINS\nend\n\n--- 探测某个域名是否可用\nlocal function probeDomain(domain)\n    local ts = Headers.timestamp()\n    local resp = rawRequest(\"GET\", \"https://\" .. domain .. \"/latest?page=1\",\n        Headers.apiHeaders(ts), nil, 10)\n    if not resp or (resp.status_code or 0) ~= 200 or not resp.body then\n        return false\n    end\n    local ok, parsed = pcall(json.decode, resp.body)\n    return ok and parsed and parsed.code == 200\nend\n\n--- 选择可用域名 (结果写入配置, 下次直接复用)\nfunction Api.ensureDomain(force)\n    if ctx.getSetting(\"base_url\", \"\") ~= \"\" then\n        Api.current_domain = Api.candidateDomains()[1]\n        return Api.current_domain\n    end\n    if Api.current_domain and not force then\n        return Api.current_domain\n    end\n\n    -- 快路径: 直接复用上次成功的域名, **不探测、也不联网拉配置源**。\n    --\n    -- 真机 2026-10-18 的账: 一次 收藏接口 花了 7.2s, 而同一个请求在 Mac 上\n    -- 只要 1.2s。差额的大头不在 HTTP, 在\"第一次请求之前先把域名发现跑一遍\":\n    -- 拉配置源 (最多 2 个 URL × 10s 超时) + 逐个 probeDomain (每个 probe 又是\n    -- 一次完整请求)。可配置里明明记着上次成功的域名 —— rememberDomain 每次\n    -- 请求成功都会写回, 这个发现流程在绝大多数情况下纯属白跑。\n    --\n    -- 域名真失效也不要紧: request() 会按候选表换下一个; 全都失败时它会把\n    -- current_domain 清掉, 下一次请求才会走下面这套完整发现 —— 那才是它\n    -- 该出现的场合 (缓存和内置兜底都不可用)。\n    if not force and not Api.domain_discovery_needed then\n        local cached = Api.candidateDomains()\n        local first = type(cached) == \"table\" and cached[1]\n        if first then\n            Api.current_domain = first\n            Api.domains_checked = true\n            if logger.enabled then logger.info(\"Picayomi SourceB: 直接复用上次的域名 \" .. first .. \" (跳过探测)\") end\n            return first\n        end\n    end\n\n    -- 走到这里 = 缓存与内置兜底全不可用, 或者上一轮已经全试遍: 该真正发现了\n    Api.domain_discovery_needed = false\n\n    local candidates = {}\n    local seen = {}\n    local function add(list)\n        for _idx, d in ipairs(list or {}) do\n            local nd = Headers.normalizeDomain(d)\n            if nd and not seen[nd] then\n                seen[nd] = true\n                table.insert(candidates, nd)\n            end\n        end\n    end\n\n    add(Api.candidateDomains())\n    add(Api.fetchDomainsFromConfig())\n    add(Headers.FALLBACK_DOMAINS)\n\n    for _idx, d in ipairs(candidates) do\n        if probeDomain(d) then\n            Api.current_domain = d\n            Api.domains_checked = true\n            if logger.enabled then logger.info(\"Picayomi SourceB: 使用域名 \" .. d) end\n            return d\n        end\n    end\n\n    -- 探测失败也要落标记: 否则每个请求都会重新拉配置源 + 逐个探测 (每次几十秒),\n    -- 反而把\"暂时连不上\"放大成\"卡死\"。下次 Api.ensureDomain(true) 才会重试。\n    Api.domains_checked = true\n    logger.err(\"Picayomi SourceB: 没有可用域名\")\n    return nil\nend\n\n--- 记住可用域名 (供源在成功请求后写回配置)\nlocal function rememberDomain(domain)\n    local list = { domain }\n    local seen = { [domain] = true }\n    for _idx, d in ipairs(config:get(\"jm_domains\") or {}) do\n        if not seen[d] then\n            seen[d] = true\n            table.insert(list, d)\n        end\n    end\n    config:set(\"jm_domains\", list)\nend\n\n-- ============================================================================\n-- 接口调用\n-- ============================================================================\n\n--- 一次失败的请求值不值得换个域名再试\n--\n-- 520/521/522/524 是 Cloudflare 家族的\"回源失败\" (源站超时 / 连不上 / 挂了),\n-- 429 是限流; 连响应都拿不到 (连接被重置 / 超时 / TLS 失败) 同理。\n-- 401/403/404 **不在其中**: 那是登录态或路径的问题, 换域名只会把会话丢掉,\n-- 越试越糟 (401 有单独的\"用磁盘凭据重登\"链路)。\nlocal function is_transient(status)\n    if not status then return true end\n    return status == 429 or (status >= 500 and status <= 599)\nend\n\n--- 本次请求的域名尝试顺序: 当前域名 -> 候选表 -> 内置兜底 (去重)\nlocal function domainPlan()\n    if ctx.getSetting(\"base_url\", \"\") ~= \"\" then return Api.candidateDomains() end\n    local plan, seen = {}, {}\n    local function add(list)\n        for _idx, d in ipairs(list or {}) do\n            local nd = Headers.normalizeDomain(d)\n            if nd and not seen[nd] then\n                seen[nd] = true\n                plan[#plan + 1] = nd\n            end\n        end\n    end\n    add({ Api.current_domain })\n    add(Api.candidateDomains())\n    add(Headers.FALLBACK_DOMAINS)\n    return plan\nend\n\n--- 一次请求最多试几个域名\n--\n-- 只换一台就够: 失败的那次已经耗掉一整个超时 (真机 522 那次等了 20 秒),\n-- 再按候选表一路试下去, 用户得盯着\"加载中\"干等一分钟 —— 比直接报错更糟。\nlocal MAX_DOMAIN_ATTEMPTS = 2\n\n--- 发请求 + 解析 (GET / POST 共用)\n--\n-- 为什么\"换域名重试\"放在这一层: 响应体的 AES 密钥用到**本次请求的 ts**\n-- (tostring(ts) .. JM_SECRET), 所以每次重试都必须重算 ts 与请求头 ——\n-- 不能在外层拿着解析好的结果重发。\n--\n-- @return data, err, transient\nlocal function request(method, path, body, timeout, extra_headers, max_attempts)\n    local t_all = logger.enabled and now() or 0\n    -- 第一次用 (还没有当前域名, 也还没探过): 先走一次域名发现。\n    -- 单独计时 —— 真机上\"这一次请求 7 秒\"到底是网络慢还是发现流程慢,\n    -- 只有把它和 HTTP 分开才看得出来。\n    local discovery_dt = 0\n    if not Api.current_domain and not Api.domains_checked then\n        local t_disc = logger.enabled and now() or 0\n        Api.ensureDomain()\n        discovery_dt = logger.enabled and (now() - t_disc) or 0\n    end\n\n    local plan = domainPlan()\n    if #plan == 0 then return nil, \"没有可用域名\", false end\n\n    local last_err, transient = \"没有可用域名\", false\n    -- 这一次失败是\"域名不行\"还是\"接口不行\"? 只有前者才该要求下一次重新发现。\n    -- 401/业务错误说明域名是好的, 换域名毫无意义 —— 而且会把 /login 的重试\n    -- 变成一次完整的域名发现 (回归测试 17.1/17.2 当场抓到)。\n    local domain_bad = false\n    local limit = math.min(#plan, max_attempts or MAX_DOMAIN_ATTEMPTS)\n    for attempt = 1, limit do\n        local domain = plan[attempt]\n        local ts = Headers.timestamp()\n        local headers = Headers.apiHeaders(ts)\n        for k, v in pairs(extra_headers or {}) do headers[k] = v end\n        local cookie = cookieHeader()\n        if cookie then headers[\"Cookie\"] = cookie end\n\n        local t_http = logger.enabled and now() or 0\n        local resp, err = rawRequest(method, \"https://\" .. domain .. path, headers, body, timeout)\n        local http_dt = logger.enabled and (now() - t_http) or 0\n        local status = resp and (resp.status_code or 0)\n\n        if not resp then\n            last_err, transient, domain_bad = err or \"网络错误\", true, true\n        elseif status ~= 200 then\n            last_err, transient = \"HTTP \" .. tostring(status), is_transient(status)\n            -- 域名可能已失效, 清掉以便下次重新选择\n            if status == 403 or status == 404 then\n                Api.current_domain = nil\n                domain_bad = true\n            end\n        else\n            local ok, parsed = pcall(json.decode, resp.body)\n            if not ok or type(parsed) ~= \"table\" then\n                return nil, \"响应不是 JSON\", false\n            end\n            if parsed.code ~= 200 then\n                return nil, parsed.errorMsg or parsed.msg or (\"code=\" .. tostring(parsed.code)), false\n            end\n            local data\n            if type(parsed.data) == \"table\" then\n                -- 有些接口 (如 设置接口) 的 data 未加密\n                data = parsed.data\n            elseif type(parsed.data) == \"string\" then\n                data = Crypto.decodeJson(parsed.data, tostring(ts) .. Headers.JM_SECRET)\n                if data == nil then return nil, \"响应解密失败\", false end\n            else\n                return nil, \"缺少 data 字段\", false\n            end\n            Api.current_domain = domain\n            rememberDomain(domain)\n\n            -- 慢请求记一笔。三个数摆在一起才分得清\"源 B 慢\"是慢在网络、慢在换域名、\n            -- 还是慢在请求之前的域名发现。Diag 是跨层工具, 这里按需加载:\n            -- 加载不到就什么都不做, 源层不该因为诊断而跑不起来。\n            local total = logger.enabled and (now() - t_all) or 0\n            if logger.enabled and (total >= 1.5 or attempt > 1 or discovery_dt >= 0.05) then\n                local ok_d, Diag = pcall(function() return ctx.trace end)\n                if ok_d and Diag and Diag.enabled then\n                    pcall(Diag.mark, string.format(\n                        \"jm %s %s %.1fs (域名 %s, 第 %d 次, HTTP %.1fs%s)\",\n                        method, Redact.url(path), total, tostring(domain), attempt, http_dt,\n                        discovery_dt >= 0.05\n                            and string.format(\", 含域名发现 %.1fs\", discovery_dt) or \"\"))\n                end\n            end\n            return data, nil, false\n        end\n\n        if logger.enabled then logger.info(string.format(\"Picayomi SourceB: %s %s%s 失败: %s%s\",\n            method, domain, Redact.url(path), Redact.text(last_err),\n            transient and (attempt < limit and \" (换域名重试)\" or \" (已换过域名)\") or \"\")) end\n        if not transient then break end\n    end\n\n    -- 全试过都不行: 清掉 current_domain 并要求下一次**重新发现**。\n    -- 这一条不能省: 快路径会一直复用缓存里的第一个域名, 如果它已经死了,\n    -- 不要求重新发现就永远拿同一个死域名重试, 远端配置源里换过的新域名永远拿不到。\n    if domain_bad or transient then\n        Api.current_domain = nil\n        Api.domains_checked = false\n        Api.domain_discovery_needed = true\n    end\n    return nil, Redact.text(last_err), transient\nend\n\n--- GET 接口, 返回解密后的数据\n-- Cookie 过期时 (401) 会用已保存的凭据自动重登并重试一次;\n-- 5xx / 连不上时自动换一个域名重试一次 (见 request)\nfunction Api.get(path, timeout)\n    local data, err = request(\"GET\", path, nil, timeout)\n\n    -- 401 一律尝试用磁盘凭据恢复会话:\n    -- 进程刚启动时 logged_in 必为 false, 但凭据可能是有效的。\n    if not data and err and tostring(err):find(\"401\", 1, true) and Api.hasSavedCredentials() then\n        if logger.enabled then logger.info(\"Picayomi SourceB: 收到 401, 尝试用已保存凭据重新登录\") end\n        if Api.reLogin() then\n            return Api._get(path, timeout)\n        end\n    end\n    return data, err\nend\n\nfunction Api._get(path, timeout)\n    return request(\"GET\", path, nil, timeout)\nend\n\n--- POST 接口 (表单), 返回解密后的数据\n--\n-- 与 Api.get 一样带 401 恢复: 本进程里第一次需要登录态的**往往就是它**\n-- (收藏是唯一要登录的写操作)。真机 2026-10-18 的现场:\n--   00:33 源 B 初始化后只发过公开列表请求 (不带 Cookie 也 200), 所以 cookie 罐是空的;\n--   00:39:43 用户点收藏 -> POST 收藏接口 -> 401 -> 界面上只有一句 \"HTTP 401\"。\n-- 根因不是端点或请求头, 而是**这条路径没有重登重试** —— Api.get 有, Api.post 没有。\n--\n-- @param no_retry 只发一次, 不换域名重试 (给 收藏接口 这种**非幂等**的切换接口用;\n--        自动重发在\"第一次其实成功了、只是响应丢了\"的情况下会把状态切回去)\nfunction Api.post(path, body, timeout, no_retry)\n    local data, err, transient = request(\"POST\", path, body, timeout,\n        { [\"Content-Type\"] = \"application/x-www-form-urlencoded\" },\n        no_retry and 1 or nil)\n    if data then return data end\n\n    -- /login 自己不能走这条恢复链 (reLogin -> login -> post 会递归)\n    if path == \"/login\" then return nil, err end\n\n    if err and tostring(err):find(\"401\", 1, true) then\n        if Api.hasSavedCredentials() then\n            if logger.enabled then logger.info(\"Picayomi SourceB: 写操作收到 401, 尝试用已保存凭据重新登录\") end\n            if Api.reLogin() then\n                return Api._post(path, body, timeout, no_retry)\n            end\n        end\n        -- 没凭据 / 重登失败: 别把裸的 \"HTTP 401\" 甩给用户, 他不知道该干什么\n        return nil, _(\"登录已过期，请重新登录\")\n    end\n\n    if transient then\n        -- \"HTTP 520\" 对用户没有意义: 说清\"暂时不可用, 稍后再试\"才有用\n        return nil, T(_(\"服务器暂时不可用 (%1)，请稍后重试\"), tostring(err))\n    end\n    return nil, err\nend\n\nfunction Api._post(path, body, timeout, no_retry)\n    return request(\"POST\", path, body, timeout,\n        { [\"Content-Type\"] = \"application/x-www-form-urlencoded\" },\n        no_retry and 1 or nil)\nend\n\n-- ============================================================================\n-- 图片 CDN\n-- ============================================================================\n\n--- 获取图片 CDN 地址 (由 设置接口 返回, 带缓存与兜底)\nfunction Api.ensureImgHost(force)\n    if Api.img_host and not force then\n        return Api.img_host\n    end\n    local cached = config:get(\"jm_img_host\")\n    if cached and not force then\n        Api.img_host = Headers.normalizeHost(cached)\n        if Api.img_host then return Api.img_host end\n    end\n\n    local data = Api.get(\"/setting?app_img_shunt=1\")\n    if data and data.img_host then\n        Api.img_host = Headers.normalizeHost(data.img_host)\n        if Api.img_host then\n            config:set(\"jm_img_host\", Api.img_host)\n            if logger.enabled then logger.info(\"Picayomi SourceB: 图片 CDN = \" .. Api.img_host) end\n            return Api.img_host\n        end\n    end\n\n    Api.img_host = Headers.FALLBACK_IMG_HOST\n    return Api.img_host\nend\n\n--- 封面 URL\nfunction Api.coverUrl(comic_id)\n    local host = Api.ensureImgHost()\n    if not host then return nil end\n    return host .. \"/media/albums/\" .. tostring(comic_id) .. \"_3x4.jpg\"\nend\n\n--- 正文图片 URL\nfunction Api.pageUrl(chapter_id, filename)\n    local host = Api.ensureImgHost()\n    if not host then return nil end\n    return host .. \"/media/photos/\" .. tostring(chapter_id) .. \"/\" .. tostring(filename)\nend\n\n-- ============================================================================\n-- 数据标准化\n-- ============================================================================\n\nlocal function joinCategories(comic)\n    local out = {}\n    local seen = {}\n    -- 注意: category.title 可能是 JSON null (userdata), 必须用 JN.str 过滤\n    -- 另外 category 与 category_sub 常常同名 (如 同人/同人), 这里去重\n    local function add(t)\n        if t and t ~= \"\" and not seen[t] then\n            seen[t] = true\n            table.insert(out, t)\n        end\n    end\n    if type(comic.category) == \"table\" then\n        add(JN.str(comic.category.title))\n    end\n    if type(comic.category_sub) == \"table\" then\n        add(JN.str(comic.category_sub.title))\n    end\n    return out\nend\n\n--- 秒级时间戳 -> \"YYYY-MM-DD\"\n-- 源 B 的 update_at / addtime 都是 epoch 秒 (不是字符串日期), 而卡片与详情页\n-- 都按 \"YYYY-MM-DD\" 展示 —— 在源这一层就统一掉, 免得每个调用方各转一次。\nlocal function date_text(ts)\n    ts = tonumber(ts)\n    if not ts or ts <= 0 then return nil end\n    local ok, s = pcall(os.date, \"%Y-%m-%d\", ts)\n    return (ok and s) or nil\nend\n\n--- 把 源 B 的列表项标准化为项目内部漫画结构\nfunction Api.normalizeBrief(comic)\n    if type(comic) ~= \"table\" then return nil end\n    local id = JN.str(comic.id) or JN.num(comic.id)\n    if not id then return nil end\n    id = tostring(id)\n    return {\n        _id = id,\n        title = JN.str(comic.name) or (\"JM\" .. id),\n        author = JN.str(comic.author) or \"\",\n        categories = joinCategories(comic),\n        -- 源 B 列表项没有页数/话数, 用作品编号作为第三行信息 (与 PicaComic 一致)。\n        -- **放在 subtitle 而不是 description**: description 是简介, 详情页会原样\n        -- 显示在简介区 —— 以前那里显示的是\"JM1483331\" (作品编号), 而不是简介。\n        subtitle = \"JM\" .. id,\n        thumb = Api.coverUrl(id),\n        -- 列表接口只给 update_at (epoch 秒)。卡片/详情按日期展示, 这里转好。\n        update_time = date_text(comic.update_at),\n        isFavourite = JN.bool(comic.is_favorite),\n    }\nend\n\nlocal function normalizeBriefList(list)\n    local out = {}\n    for _idx, c in ipairs(list or {}) do\n        local n = Api.normalizeBrief(c)\n        if n then table.insert(out, n) end\n    end\n    return out\nend\n\n-- ============================================================================\n-- 内存缓存 (对齐 picacg 的 TTL 策略)\n-- 没有缓存时每次进列表/翻页/返回都要走一次网络, 在 Kindle 上体感很差。\n-- ============================================================================\nlocal CACHE_TTL = {\n    CATEGORIES = 86400,   -- 1 天\n    COMICS     = 3600,    -- 1 小时\n    DETAIL     = 86400,   -- 1 天\n    IMAGES     = 3600,    -- 1 小时\n    SEARCH     = 1800,    -- 30 分钟\n    -- 收藏: 5 分钟。收藏是**个人列表**, 用户可能刚在网页/别的设备上加过,\n    -- 所以不能像最新列表那样缓存一小时; 但同一次会话里来回进出收藏页\n    -- (真机上每次都要同步等 1~4 秒) 完全没必要重取。\n    -- 自己加/取消收藏走 Api.clearListCache (清 \"jm:\" 前缀), 立刻失效。\n    FAVORITES  = 300,\n}\n\nlocal function cacheGet(key)\n    local ok, cache = pcall(function() return ctx.cache end)\n    if not ok or not cache then return nil end\n    local ok2, v = pcall(function() return cache:getData(key) end)\n    if not ok2 then return nil end\n    return v\nend\n\nlocal function cacheSet(key, value, ttl)\n    local ok, cache = pcall(function() return ctx.cache end)\n    if not ok or not cache then return end\n    pcall(function() cache:cacheData(key, value, os.time() + ttl) end)\nend\n\n--- 带缓存的取数: 命中直接返回, 未命中执行 fn 并写入缓存\nlocal function cached(key, ttl, fn)\n    local hit = cacheGet(key)\n    if hit then return hit end\n    local value, err = fn()\n    if not value then return nil, err end\n    cacheSet(key, value, ttl)\n    return value\nend\n\n--- 清空 源 B 的列表类缓存 (收藏/取消收藏后调用, 避免看到旧状态)\nfunction Api.clearListCache()\n    local ok, cache = pcall(function() return ctx.cache end)\n    if not ok or not cache then return end\n    pcall(function() cache:clearPattern(\"jm:\") end)\n    Api.album_cache = {}\n    album_cache_seq = {}\nend\n\n--- 专辑详情缓存有界化\n--\n-- 每条 detail 都带完整章节数组 (长篇可上百项)。无上限时, 一次会话里看过的每本\n-- 都会一直留着 —— 在只有 ~130MB 可用内存的设备上就是白白累积。\n-- 超限时淘汰**最久未写入**的那一条 (table 没有插入序, 因此单独记一个序号)。\nlocal ALBUM_CACHE_MAX = 24\nlocal album_cache_counter = 0\n\nlocal function rememberAlbum(id, detail)\n    album_cache_counter = album_cache_counter + 1\n    Api.album_cache[id] = detail\n    album_cache_seq[id] = album_cache_counter\n\n    local count = 0\n    for _ in pairs(Api.album_cache) do count = count + 1 end\n    if count > ALBUM_CACHE_MAX then\n        local oldest_id, oldest_seq\n        for k, seq in pairs(album_cache_seq) do\n            if not oldest_seq or seq < oldest_seq then\n                oldest_id, oldest_seq = k, seq\n            end\n        end\n        if oldest_id then\n            Api.album_cache[oldest_id] = nil\n            album_cache_seq[oldest_id] = nil\n        end\n    end\nend\n\n-- ============================================================================\n-- 业务接口\n-- ============================================================================\n\n--- 最新 / 推荐列表 (可排序)\n--\n-- @param order 排序取值与分类页一致: mr 最新 / mv 最多观看 / mp 最多图片 / tf 最多喜欢\n--\n-- 端点选择 (实测 2026-10-18):\n--   * 最新列表接口 **不接受任何排序参数** —— 加 order= / o= / sort= 返回的都是同一份数据\n--     (80 条, 首项完全相同)。所以只拿它当\"最新\"。\n--   * 其余排序走 分类筛选接口: 那是站点\"全部\"列表的筛选接口, c 留空即全库,\n--     o 是排序。实测 o=mv 首项是观看最多的作品、o=mr 是按时间倒序、o=tf 是喜欢最多。\n--   这也是\"推荐/最新为什么没有排序按钮\"的答案: 以前只接了 最新列表接口, 而它没有这个能力。\nfunction Api.getLatest(page, order)\n    page = page or 1\n    order = tostring(order or \"mr\")\n    return cached(\"jm:latest:\" .. order .. \":\" .. page, CACHE_TTL.COMICS, function()\n        local path\n        if order == \"mr\" then\n            path = \"/latest?page=\" .. tostring(page)\n        else\n            path = \"/categories/filter?o=\" .. order .. \"&c=&page=\" .. tostring(page)\n        end\n        local data, err = Api.get(path)\n        if not data then return nil, err end\n        if type(data) ~= \"table\" then return nil, \"列表数据格式异常\" end\n        -- 两个端点的列表位置不同: 最新列表接口 直接是数组, filter 放在 content 里\n        local list = type(data.content) == \"table\" and data.content or data\n        return {\n            comics = normalizeBriefList(list),\n            page = page,\n            -- 源 B 的 latest 不给总页数 —— 这里**必须留 nil**, 不能塞一个\"足够大的\"\n            -- 哨兵值 (以前是 9999)。列表页对 total_pages 的语义是\"可信的页数\":\n            -- 有了它页脚就会显示\"第 1/9999 页\"并允许跳到第 9999 页, 那是假的。\n            -- 留 nil 时列表按 has_more=true 处理 (见 visual_comic_list 的构造),\n            -- 照样能一直往下翻, 页脚只显示\"第 N 页 · 已加载 K 项\"。\n            pages = nil,\n        }\n    end)\nend\n\n--- percent-encode (RFC 3986) —— 源 B 的 /search 收到**原始 UTF-8 字节**会直接 400\n--- (实测 2026-10-18: search_query=韓漫 -> 400, %E9%9F%93%E6%BC%AB -> 200)。\n--- 英文关键词碰巧能过, 所以这个坑只在中文/日文搜索时暴露。\nlocal function urlencode(str)\n    return (tostring(str):gsub(\"[^%w%-%._~]\", function(c)\n        return string.format(\"%%%02X\", string.byte(c))\n    end))\nend\n\nfunction Api.getSearch(keyword, page, order)\n    page = page or 1\n    order = tostring(order or \"mr\")\n    -- 缓存键用**原关键词** (与显示一致), 只有拼 URL 时才编码。\n    local keyword_key = tostring(keyword or \"\")\n    return cached(\"jm:search:\" .. order .. \":\" .. page .. \":\" .. keyword_key,\n        CACHE_TTL.SEARCH, function()\n            -- 空格编码成 %20 而不是 '+' —— '+' 在 query 里虽然也表示空格, 但\n            -- 关键词里真的含 '+' 时就分不清了。\n            local kw = urlencode(keyword_key)\n            local path = \"/search?&search_query=\" .. kw ..\n                \"&o=\" .. order .. \"&page=\" .. tostring(page)\n            local data, err = Api.get(path)\n            if not data then return nil, err end\n            local comics = normalizeBriefList(data.content)\n            local total = JN.num(data.total, #comics)\n            local per = math.max(#comics, 1)\n            return {\n                comics = comics,\n                page = page,\n                total = total,\n                pages = math.max(1, math.ceil(total / per)),\n            }\n        end)\nend\n\nlocal function parseCategories(data)\n    local out = {}\n    for _idx, c in ipairs(JN.list(data.categories)) do\n        if type(c) == \"table\" then\n            local slug = JN.str(c.slug)\n            local name = JN.str(c.name)\n            if slug and name then\n                local subs = {}\n                for _i, sc in ipairs(JN.list(c.sub_categories)) do\n                    if type(sc) == \"table\" then\n                        local sslug = JN.str(sc.slug) or JN.str(sc.CID)\n                        local sname = JN.str(sc.name)\n                        if sslug and sname then\n                            table.insert(subs, {\n                                _id = sslug,\n                                title = sname,\n                                category = sslug,\n                            })\n                        end\n                    end\n                end\n                table.insert(out, {\n                    _id = slug,\n                    title = name,\n                    categories = subs,\n                    category = slug,\n                })\n            end\n        end\n    end\n    -- blocks 是源站提供的主题/角色等标签分类, 通过关键词搜索进入。\n    -- 主分类走 filter, 标签分类走 search, 不把标签当作分类 slug 发送。\n    for _, block in ipairs(JN.list(data.blocks)) do\n        if type(block) == \"table\" then\n            local group = JN.str(block.title, \"\")\n            for _, keyword in ipairs(JN.str_list(block.content)) do\n                if keyword ~= \"\" then\n                    out[#out + 1] = {\n                        _id = \"jm-tag:\" .. keyword,\n                        title = group ~= \"\" and (group .. \" / \" .. keyword) or keyword,\n                    }\n                end\n            end\n        end\n    end\n    return out\nend\n\nlocal CATEGORY_CACHE_KEY = \"jm:categories:v2\"\nlocal CATEGORY_SNAPSHOT_KEY = \"jm_categories_cache\"\n\nlocal function savedCategories(snapshot)\n    if type(snapshot) ~= \"table\" or snapshot.version ~= 2\n            or type(snapshot.categories) ~= \"table\" or #snapshot.categories == 0 then\n        return nil\n    end\n    for _idx, category in ipairs(snapshot.categories) do\n        if type(category) ~= \"table\" or type(category._id) ~= \"string\"\n                or type(category.title) ~= \"string\" or category.title == \"\" then\n            return nil\n        end\n    end\n    return snapshot.categories\nend\n\nfunction Api.getCategories()\n    local hit = cacheGet(CATEGORY_CACHE_KEY)\n    if hit then return hit end\n\n    -- 分类变化很少, 重启后优先复用磁盘快照, 不必再承担一次域名发现/网络请求。\n    local snapshot = config:get(CATEGORY_SNAPSHOT_KEY)\n    local saved = savedCategories(snapshot)\n    local remaining = saved and ((tonumber(snapshot.expires_at) or 0) - os.time()) or 0\n    if remaining > 0 then\n        cacheSet(CATEGORY_CACHE_KEY, saved, remaining)\n        return saved\n    end\n\n    local ok, data, err = pcall(Api.get, \"/categories\")\n    if not ok then err, data = data, nil end\n    local categories = type(data) == \"table\" and parseCategories(data) or {}\n    if #categories > 0 then\n        -- 写盘失败不影响本次成功的数据; 下次仍可重取或使用内置快照。\n        pcall(config.set, config, CATEGORY_SNAPSHOT_KEY, {\n            version = 2, categories = categories, expires_at = os.time() + CACHE_TTL.CATEGORIES,\n        })\n        cacheSet(CATEGORY_CACHE_KEY, categories, CACHE_TTL.CATEGORIES)\n        return categories\n    end\n\n    -- 短期网络失败不能让整个分类入口不可用, 也不能用空响应覆盖最后一次成功数据。\n    local fallback = saved or parseCategories(require(\"category_defaults\"))\n    if logger.enabled then logger.info(\"Picayomi SourceB: 分类接口暂不可用, 使用\" .. (saved and \"历史\" or \"内置\")\n        .. \"分类: \" .. Redact.text(err or \"分类数据为空或格式异常\")) end\n    cacheSet(CATEGORY_CACHE_KEY, fallback, 300)\n    return fallback\nend\n\nfunction Api.getCategoryComics(category, page, order)\n    local keyword = type(category) == \"string\" and category:match(\"^jm%-tag:(.+)$\")\n    if keyword then return Api.getSearch(keyword, page, order) end\n    page = page or 1\n    order = tostring(order or \"mr\")\n    local cat = tostring(category or \"\")\n    return cached(\"jm:cat:\" .. order .. \":\" .. cat .. \":\" .. tostring(page),\n        CACHE_TTL.COMICS, function()\n            local path = \"/categories/filter?o=\" .. order ..\n                \"&c=\" .. urlencode(cat) .. \"&page=\" .. tostring(page)\n            local data, err = Api.get(path)\n            if not data then return nil, err end\n            local comics = normalizeBriefList(data.content)\n            local total = JN.num(data.total, #comics)\n            local per = math.max(#comics, 1)\n            return {\n                comics = comics,\n                page = page,\n                total = total,\n                pages = math.max(1, math.ceil(total / per)),\n            }\n        end)\nend\n\n-- JM 的评论正文是 HTML, 回复随父评论一起返回, 每页固定 10 条父评论。\nlocal function normalizeComment(raw, include_replies)\n    if type(raw) ~= \"table\" then return nil end\n    local id = JN.str(raw.CID) or JN.num(raw.CID)\n    if not id then return nil end\n    local replies = {}\n    if include_replies then\n        for _, reply in ipairs(JN.list(raw.replys)) do\n            local normalized = normalizeComment(reply, false)\n            if normalized then replies[#replies + 1] = normalized end\n        end\n    end\n    return {\n        _id = tostring(id),\n        author = { name = JN.str(raw.nickname) or JN.str(raw.username) or JN.str(raw.name) or \"\" },\n        content = ctx.text.htmlToPlainText(JN.str(raw.content, \"\")),\n        created_at = JN.str(raw.addtime) or JN.num(raw.addtime),\n        likesCount = JN.num(raw.likes, 0),\n        replies = replies,\n        commentsCount = #replies,\n    }\nend\n\nfunction Api.getComments(comic_id, page)\n    local id = tostring(comic_id)\n    page = math.max(1, math.floor(tonumber(page) or 1))\n    return cached(\"jm:comments:\" .. id .. \":\" .. page, 600, function()\n        local data, err = Api.get(\"/forum?mode=manhua&aid=\" .. urlencode(id) .. \"&page=\" .. page)\n        if not data then return nil, err end\n        if type(data) ~= \"table\" or type(data.list) ~= \"table\" then\n            return nil, _(\"评论数据格式异常\")\n        end\n        local comments = {}\n        for _, raw in ipairs(data.list) do\n            local comment = normalizeComment(raw, true)\n            if comment then comments[#comments + 1] = comment end\n        end\n        local total = JN.num(data.total, #comments)\n        return {\n            comments = comments,\n            total = total,\n            page = page,\n            pages = math.max(1, math.ceil(total / 10)),\n        }\n    end)\nend\n\n--- 作品详情 (含章节列表)\nfunction Api.getAlbum(comic_id)\n    local id = tostring(comic_id)\n    return cached(\"jm:album:\" .. id, CACHE_TTL.DETAIL, function()\n        return Api._fetchAlbum(id)\n    end)\nend\n\nfunction Api._fetchAlbum(id)\n    local data, err = Api.get(\"/album?id=\" .. id)\n    if not data then return nil, err end\n\n    local detail = {\n        _id = id,\n        title = JN.str(data.name) or (\"JM\" .. id),\n        author = JN.str(data.author) or \"\",\n        description = JN.str(data.description, \"\"),\n        tags = JN.str_list(data.tags),\n        likesCount = JN.num(data.likes, 0),\n        viewsCount = JN.num(data.total_views, 0),\n        epsCount = 0,   -- 章节构建完后按**实际**章节数回填 (见下)\n        pagesCount = JN.num(data.total_photos, 0),\n        thumb = Api.coverUrl(id),\n        isFavourite = JN.bool(data.is_favorite),\n        -- addtime 可能是 JSON null (userdata) / 字符串数字: 用 date_text 同一套规则清洗,\n        -- 不能原样透传 (消费方拿它做比较 / 拼接会炸)。\n        updated_at = tonumber(data.addtime),\n        -- 详情页的\"更新时间\"读的是 update_time (与列表同一套字段);\n        -- 只写 updated_at 的话那一行永远不显示 (真机反馈: 详情页没有更新时间)。\n        update_time = date_text(data.addtime),\n        chapters = {},\n    }\n\n    local series = JN.list(data.series)\n    if #series == 0 then\n        -- 单话作品: 章节号就是作品号\n        table.insert(detail.chapters, {\n            _id = id,\n            title = detail.title,\n            order = 1,\n            sort = 1,\n        })\n    else\n        for idx, s in ipairs(series) do\n            if type(s) == \"table\" then\n                local sid = JN.str(s.id) or JN.num(s.id)\n                if sid then\n                    local name = JN.str(s.name, \"\")\n                    local sort = JN.num(s.sort, idx)\n                    table.insert(detail.chapters, {\n                        _id = tostring(sid),\n                        title = name ~= \"\" and name or (\"第\" .. tostring(sort) .. \"话\"),\n                        order = idx,\n                        sort = sort,\n                    })\n                end\n            end\n        end\n    end\n\n    -- 章节数以**实际建出来的章节**为准: series 里可能混着缺 id 的脏项 / 非表项,\n    -- 构建时已被跳过。按原始长度算会让\"共 N 话\"比列表里能点的章节多\n    -- (页脚汇总行与章节列表对不上)。单话作品 (series 为空) 上面补了 1 章, 这里也是 1。\n    detail.epsCount = #detail.chapters\n\n    rememberAlbum(id, detail)\n    return detail\nend\n\n--- 取章节列表 (供 source:getChapters 使用)\nfunction Api.getChapters(comic_id)\n    local detail, err = Api.getAlbum(comic_id)\n    if not detail then return nil, err end\n    return {\n        episodes = detail.chapters,\n        page = 1,\n        pages = 1,\n        total = #detail.chapters,\n    }\nend\n\n--- 解析章节 id: 优先用缓存, 否则回源\nfunction Api.resolveChapterId(comic_id, chapter_order)\n    local id = tostring(comic_id)\n    local detail = Api.album_cache[id]\n    local err\n    if not detail then\n        detail, err = Api.getAlbum(id)\n    end\n    -- 取详情失败 (网络 / 5xx) 要把**真实原因**带出去: 调用方拿到 nil 却不知道为什么,\n    -- 只能报\"找不到该章节\", 用户会以为作品被删了, 实际只是网络抖了一下。\n    if not detail then return nil, err or \"获取作品详情失败\" end\n\n    local order = tonumber(chapter_order)\n    if not order then return nil, \"找不到该章节\" end\n    for _idx, ch in ipairs(detail.chapters) do\n        if ch.order == order then return ch._id end\n    end\n    return nil, \"找不到该章节\"\nend\n\n--- 取某一话的图片列表\nfunction Api.getChapterImages(comic_id, chapter_order)\n    local chapter_id, resolve_err = Api.resolveChapterId(comic_id, chapter_order)\n    if not chapter_id then return nil, resolve_err or \"找不到该章节\" end\n\n    return cached(\"jm:chapter:\" .. tostring(chapter_id), CACHE_TTL.IMAGES, function()\n        local data, err = Api.get(\"/chapter?id=\" .. tostring(chapter_id))\n        if not data then return nil, err end\n\n        local images = {}\n        for _idx, name in ipairs(JN.str_list(data.images)) do\n            local url = Api.pageUrl(chapter_id, name)\n            if url then table.insert(images, { url = url }) end\n        end\n        return { images = images, chapter_id = chapter_id }\n    end)\nend\n\n-- ============================================================================\n-- 账号与收藏\n-- ============================================================================\n\nfunction Api.login(username, password)\n    username = tostring(username or \"\")\n    password = tostring(password or \"\")\n    if username == \"\" or password == \"\" then\n        return nil, \"用户名和密码不能为空\"\n    end\n\n    local body = \"username=\" .. username .. \"&password=\" .. password\n    -- 必须走 _post: Api.post 的 401 恢复会调用 reLogin, 而 reLogin 又调 login\n    local data, err = Api._post(\"/login\", body, 20)\n    if not data then\n        Api.logged_in = false\n        return nil, err\n    end\n\n    Api.logged_in = true\n    Api.username = data.username or username\n\n    -- 凭据落盘: 源 B 的 Cookie 有效期很短, 需要能自动重新登录。\n    -- **只走 SecretStore** —— config.json 里不允许出现明文密码/账号。\n    SecretStore.set(\"jm_account\", username)\n    SecretStore.set(\"jm_password\", password)\n    -- 标记\"这份 Cookie 是登录后保存的\": 匿名浏览也会下发 Cookie, 不能只看\n    -- Cookie 非空就判定已登录 (见 Api.hasSavedSession)。\n    config:set(\"jm_session\", true)\n    Api.saveCookies(true)\n\n    -- 刷新图片 CDN (登录后可用线路可能变化)\n    Api.ensureImgHost(true)\n\n    return {\n        username = Api.username,\n        uid = data.uid,\n    }\nend\n\nfunction Api.logout()\n    Api.cookies = {}\n    Api.logged_in = false\n    Api.username = nil\n    cookie_fp = \"\"\n    Api._session_loaded = true\n    SecretStore.clear(\"jm_cookies\")\n    SecretStore.clear(\"jm_account\")\n    SecretStore.clear(\"jm_password\")\n    config:set(\"jm_session\", nil)\nend\n\n--- 从磁盘恢复的用户名 (用于界面显示 / 自动重登)\nfunction Api.getUsername()\n    local name = SecretStore.get(\"jm_account\")\n    if type(name) ~= \"string\" or name == \"\" then return nil end\n    return name\nend\n\n--- 磁盘上是否存有可用于**自动重新登录**的凭据\nfunction Api.hasSavedCredentials()\n    return Api.getUsername() ~= nil and SecretStore.get(\"jm_password\") ~= nil\nend\n\n--- 是否已登录\n-- 注意: Api.logged_in 只是内存里的会话标志, 重启后必然为 false,\n-- 但磁盘上的凭据/会话仍然有效。只看 logged_in 会误判成\"未登录\",\n-- 从而走不到自动重登分支, 也读不到保存的会话。\nfunction Api.isLoggedIn()\n    Api.ensureSessionLoaded()\n    return Api.logged_in == true\n        or Api.hasSavedCredentials()\n        or Api.hasSavedSession()\nend\n\n--- 使用已保存的凭据自动重新登录 (会话过期或进程重启后调用)\nfunction Api.reLogin()\n    local account = Api.getUsername()\n    local password = SecretStore.get(\"jm_password\")\n    if not account or not password or account == \"\" then return false end\n    local info = Api.login(account, password)\n    return info ~= nil\nend\n\nfunction Api.getFavorites(page, _sort)\n    page = page or 1\n    -- 取收藏是**主线程同步**等网络: 真机实测一次 7.2s (含域名发现), 期间整页\n    -- 不响应输入。缓存后重复进入是 0 秒; 第一次仍然要走网络, 但域名发现已经\n    -- 不再重复跑 (见 ensureDomain 的快路径)。\n    return cached(\"jm:fav:\" .. tostring(page), CACHE_TTL.FAVORITES, function()\n        return Api._getFavorites(page)\n    end)\nend\n\n--- 真正去服务端取收藏 (缓存未命中时)\nfunction Api._getFavorites(page)\n    -- 收藏列表与收藏动作使用同一路径（参数不同）。\n    -- 之前返回 401 是因为**会话 cookie 没被吸收**(见 absorbCookies),\n    -- 与路径无关；带上会话后能正常返回列表。\n    local data, err = Api.get(\"/favorite?page=\" .. tostring(page or 1) .. \"&folder_id=0&o=mr\")\n    if not data then return nil, err end\n\n    -- 兼容两种返回形态: {list=...} 或直接数组\n    local list = data.list or data.content\n    if type(list) ~= \"table\" and type(data) == \"table\" and data[1] ~= nil then\n        list = data\n    end\n    local comics = normalizeBriefList(list or {})\n    local total = JN.num(data.total, #comics)\n    -- 服务端按 count 返回每页条数, 用它算总页数更准\n    local per = JN.num(data.count, 0)\n    if per <= 0 then per = math.max(#comics, 1) end\n    return {\n        comics = comics,\n        page = page or 1,\n        total = total,\n        pages = math.max(1, math.ceil(total / per)),\n    }\nend\n\n--- 直接问服务端\"这本现在收藏了吗\" (绕过持久缓存)\n-- 用于写操作结果不明时核对真实状态: 收藏接口是**切换**语义, 盲猜会把状态搞反。\nfunction Api.fetchFavoriteState(comic_id)\n    local detail = Api._fetchAlbum(tostring(comic_id))\n    if not detail then return nil end\n    return detail.isFavourite and true or false\nend\n\n--- 切换收藏状态\n-- 源 B 的 收藏接口是\"切换\"语义, 先读当前状态再确认结果\nfunction Api.toggleFavorite(comic_id)\n    local id = tostring(comic_id)\n    local before = Api.album_cache[id]\n    if not before then\n        before = Api.getAlbum(id)\n    end\n    local want_fav = not (before and before.isFavourite)\n\n    -- no_retry: **切换**接口不能自动重发。真机 01:06 那次 POST 520 / 522 都是\n    -- Cloudflare 的回源失败 —— 请求可能已经在源站生效, 只是响应回不来。自动重发\n    -- 会把刚加上的收藏又切回去, 用户看到\"点了收藏, 过一会儿又没了\"。\n    -- 所以这里只发一次; 失败后**先读真实状态**, 确认没落地才补发。\n    local data, err = Api.post(\"/favorite\", \"aid=\" .. id, nil, true)\n    if not data then\n        local now = Api.fetchFavoriteState(id)\n        if now == want_fav then\n            if logger.enabled then logger.info(\"Picayomi SourceB: 收藏请求报错, 但服务端状态已经是目标值 —— 按成功处理\") end\n            Api.clearListCache()\n            return true\n        end\n        if now == nil then\n            -- 连状态都读不到: 如实报错, 别让界面以为收藏成功了\n            return nil, err\n        end\n        -- 状态确实没变: 这次切换没生效, 补发一次 (这次允许换域名)\n        if logger.enabled then logger.info(\"Picayomi SourceB: 收藏未生效, 换域名补发一次\") end\n        data, err = Api.post(\"/favorite\", \"aid=\" .. id)\n        if not data then return nil, err end\n    end\n\n    -- 返回值 type 为 add / del; 与期望不一致时再切一次\n    local now_fav = (data.type == \"add\") or (data.type ~= \"del\" and data.type ~= nil and tostring(data.type):find(\"add\") ~= nil)\n    if data.type == nil then\n        now_fav = want_fav   -- 服务端没有明确返回, 默认按切换处理\n    end\n\n    if now_fav ~= want_fav then\n        data, err = Api.post(\"/favorite\", \"aid=\" .. id)\n        if not data then return nil, err end\n    end\n\n    if Api.album_cache[id] then\n        Api.album_cache[id].isFavourite = want_fav\n    end\n\n    -- 收藏状态变了, 列表/详情的缓存要失效, 否则返回收藏页还是旧的\n    Api.clearListCache()\n    return true\nend\n\n--- 读当前收藏状态 (拿不到就返回 nil, err —— 不能猜)\nlocal function currentFavorite(id)\n    local before = Api.album_cache[id]\n    if before then return before.isFavourite end\n    local album, err = Api.getAlbum(id)\n    if not album then return nil, err or \"无法确认收藏状态\" end\n    return album.isFavourite\nend\n\n--- 加入收藏 (设定语义: 已经是目标状态就什么都不做)\n--\n-- 源 B 只有**切换**端点, 所以必须自己先看状态再决定要不要发请求 ——\n-- 直接发会变成\"再按一次取消\"。\nfunction Api.addFavorite(comic_id)\n    local id = tostring(comic_id)\n    local fav, err = currentFavorite(id)\n    if fav == nil then return nil, err end\n    if fav then return true end\n    return Api.toggleFavorite(id)\nend\n\n--- 取消收藏 (设定语义: 已经是目标状态就什么都不做)\nfunction Api.removeFavorite(comic_id)\n    local id = tostring(comic_id)\n    local fav, err = currentFavorite(id)\n    if fav == nil then return nil, err end\n    if not fav then return true end\n    return Api.toggleFavorite(id)\nend\n\n--- 下载图片 (复用源的 downloadImage 实现, 这里只暴露请求头)\nfunction Api.imageHeaders()\n    return Headers.imgHeaders()\nend\n\nreturn Api\n","category_defaults.lua":"-- 2026-10-19 /categories 的公开分类快照。\n-- 首次安装且接口不可用时兜底; 结构与接口一致, 共用解析和跳转逻辑。\nreturn {\n    categories = {\n        { name = \"最新A漫\", slug = \"\" },\n        { name = \"同人\", slug = \"doujin\" },\n        { name = \"單本\", slug = \"single\" },\n        { name = \"短篇\", slug = \"short\" },\n        { name = \"其他類\", slug = \"another\" },\n        { name = \"韓漫\", slug = \"hanman\" },\n        { name = \"English Manga\", slug = \"meiman\" },\n        { name = \"Cosplay\", slug = \"another_cosplay\" },\n        { name = \"3D\", slug = \"3D\" },\n        { name = \"禁漫漢化組\", slug = \"禁漫漢化組\" },\n    },\n    blocks = {\n        { title = \"主題A漫\", content = {\n            \"劇情向\", \"校園\", \"純愛\", \"人妻\", \"師生\", \"近親\", \"百合\", \"YAOI\",\n            \"性轉\", \"NTR\", \"偽娘\", \"癡女\", \"全彩\", \"女性向\",\n        } },\n        { title = \"角色 / 扮演\", content = {\n            \"蘿莉\", \"禦姐\", \"熟女\", \"正太\", \"巨乳\", \"貧乳\", \"女王\", \"教師\",\n            \"女僕\", \"護士\", \"泳裝\", \"眼鏡\", \"連褲襪\", \"其他制服\", \"兔女郎\",\n        } },\n        { title = \"特殊PLAY\", content = {\n            \"群交\", \"足交\", \"SM\", \"肛交\", \"阿黑顏\", \"藥物\", \"扶他\", \"調教\",\n            \"野外露出\", \"催眠\", \"自慰\", \"觸手\", \"獸交\",\n        } },\n        { title = \"其他\", content = { \"CG集\", \"重口\", \"獵奇\", \"非H\", \"血腥暴力\" } },\n    },\n}\n","contract.lua":"-- API v3 projection of this package's existing, independently tested protocol.\n-- Platform state and caches remain private to the implementation.\nlocal V={}\nlocal function identifier(value)\n    assert(type(value)==\"string\" and value~=\"\" or type(value)==\"number\" and value==value and math.abs(value)<math.huge,\"平台标识无效\")\n    return tostring(value)\nend\nfunction V.wrap(ctx,implementation,options)\n    options=options or {}\n    local S={capabilities=implementation.capabilities,access=implementation.access}\n    local order_maps={}\n    local function copy(v)\n        if type(v)==\"userdata\" then return nil end\n        if type(v)~=\"table\" then return v end\n        local out={}; for k,item in pairs(v) do out[k]=copy(item) end; return out\n    end\n    local function failure(err,code)\n        return false,nil,ctx.error(code or \"network\",type(err)==\"string\" and err or \"平台请求失败\",nil,nil,false)\n    end\n    local function fetch(method,...)\n        local was_logged=implementation.isLoggedIn and implementation:isLoggedIn()\n        local called,ok,data,err=pcall(implementation[method],implementation,...)\n        if not called then return failure(\"平台响应结构已变化\",\"protocol_changed\") end\n        if ok~=true then\n            local expired=was_logged and implementation.isLoggedIn and not implementation:isLoggedIn()\n            return failure(err,expired and \"auth_expired\" or \"network\")\n        end\n        return true,data,nil\n    end\n    local function manga(v)\n        return {id=identifier(v._id),title=v.title,cover=v.thumb,author=v.author,description=v.description,\n            tags=copy(v.tags),categories=copy(v.categories),finished=v.finished,favorite=v.isFavourite,\n            updated_at=v.update_time,stats={chapters=v.epsCount,pages=v.pagesCount,likes=v.likesCount,\n                comments=v.commentsCount,views=v.viewsCount},chineseTeam=v.chineseTeam}\n    end\n    local function comment(v)\n        local replies\n        if type(v.replies)==\"table\" then replies={}; for i,r in ipairs(v.replies) do replies[i]=comment(r) end end\n        return {id=identifier(v._id),content=v.content or \"\",author=copy(v.author) or {name=\"未知用户\"},\n            created_at=v.created_at,likesCount=v.likesCount,repliesCount=v.repliesCount,replies=replies}\n    end\n    local function list(method,request,...)\n        request=request or {}\n        local n=select(\"#\",...)\n        local args={...};args[n+1]=request.page or 1;args[n+2]=request.sort;args[n+3]=request.categories\n        local ok,data,err=fetch(method,unpack(args,1,n+3))\n        if not ok then return false,nil,err end\n        local items={};for i,item in ipairs(data.comics) do items[i]=manga(item) end\n        local more=tonumber(data.pages) and (tonumber(data.page) or request.page or 1)<tonumber(data.pages) or data.has_more==true\n        local total=tonumber(data.total)\n        if options.estimated_total and method==\"getComics\" then total=nil end\n        return true,{items=items,has_more=more,next=more and {page=(tonumber(data.page) or request.page or 1)+1} or nil,\n            total=total},nil\n    end\n    function S:init()\n        implementation:init()\n        if options.render then ctx.images.register(\"bands\",{stage=\"render\",module=\"scramble\",fn=\"applyContext\",version=1}) end\n        return true,{success=true},nil\n    end\n    function S:getManga(id)\n        local ok,data,err=fetch(\"getComicDetail\",id)\n        if not ok then return false,nil,err end\n        return true,manga(data),nil\n    end\n    function S:getChapters(id)\n        local episodes,seen,map={},{},{}\n        for page=1,200 do\n            local ok,data,err=fetch(\"getChapters\",id,page)\n            if not ok then return false,nil,err end\n            if type(data)~=\"table\" or type(data.episodes)~=\"table\" then return failure(\"平台章节结构已变化\",\"protocol_changed\") end\n            for _,ch in ipairs(data.episodes) do\n                local chapter_id=identifier(ch._id or options.single_chapter_identity and id)\n                if seen[chapter_id] then return failure(\"平台章节身份重复\",\"protocol_changed\") end\n                seen[chapter_id]=true\n                local order=options.legacy_order and ch.order or \"c_\"..chapter_id\n                map[chapter_id]=order\n                episodes[#episodes+1]={id=chapter_id,manga_id=id,title=ch.title,\n                    legacy_order=options.legacy_order and ch.order or nil,page_count=ch.pagesCount}\n                if #episodes>20000 then return failure(\"章节数量超过限额\",\"resource_limit\") end\n            end\n            if page>=(tonumber(data.pages) or 1) then\n                if options.legacy_order then table.sort(episodes,function(a,b) return (tonumber(a.legacy_order) or 0)<(tonumber(b.legacy_order) or 0) end) end\n                order_maps[id]=map\n                return true,{items=episodes,has_more=false,total=#episodes},nil\n            end\n        end\n        return failure(\"章节分页超过限额\",\"resource_limit\")\n    end\n    function S:getPages(id,chapter_id)\n        if not (order_maps[id] and order_maps[id][chapter_id]) then\n            local ok,_,err=self:getChapters(id);if not ok then return false,nil,err end\n        end\n        local order=order_maps[id] and order_maps[id][chapter_id]\n        if order==nil then return failure(\"章节不存在\",\"not_found\") end\n        local ok,data,err=fetch(\"getAllChapterImages\",id,order)\n        if not ok then return false,nil,err end\n        local pages={}\n        for i,image in ipairs(data.images) do\n            local url=type(image)==\"table\" and image.url or image\n            local context,processors\n            if options.render then\n                local bands=ctx.require(\"scramble\").countForUrl(url)\n                if bands>0 then context={bands=bands};processors={render={name=\"bands\",version=1}} end\n            end\n            pages[i]={index=i,resource={url=url},context=context,processors=processors}\n        end\n        return true,{items=pages,complete=true},nil\n    end\n    function S:getImageRequest(resource)\n        local headers,err=implementation:imageHeaders(resource.url)\n        if type(headers)~=\"table\" then return failure(err) end\n        local values={};for k,v in pairs(headers) do values[k]=type(v)==\"number\" and tostring(v) or v end\n        return ctx.imageRequest(resource,values)\n    end\n    function S:getLatest(request) return list(\"getComics\",request) end\n    function S:getRecommendations(request) return list(\"getRecommendations\",request) end\n    function S:search(keyword,request) return list(\"search\",request,keyword) end\n    function S:getCategoryComics(id,request) return list(\"getCategoryComics\",request,id==\"jm-all\" and \"\" or id) end\n    function S:getRankings(id,request) return list(\"getRankings\",request,id) end\n    function S:getFavorites(request) return list(\"getFavorites\",request) end\n    function S:getRandom(request) return list(\"getRandom\",request) end\n    function S:getCategories()\n        local ok,data,err=fetch(\"getCategories\")\n        if not ok then return false,nil,err end\n        local items={}; for i,item in ipairs(data) do\n            local id=tostring(item._id or item.title)\n            items[i]={id=id==\"\" and \"jm-all\" or id,title=item.title,isWeb=item.isWeb,link=item.link}\n        end\n        return true,items,nil\n    end\n    function S:getRankingTypes()\n        local items=implementation:getRankingTypes()\n        return true,copy(items),nil\n    end\n    function S:getSortOptions(kind)\n        local items={};for i,item in ipairs(implementation:getSortOptions(kind)) do items[i]={id=item.value,title=item.text} end\n        return true,items,nil\n    end\n    function S:getSession() return true,{logged_in=implementation:isLoggedIn()},nil end\n    function S:getCredential() return true,{token=implementation:getToken()},nil end\n    function S:setCredential(token)\n        if not implementation.setToken then return failure(\"当前源不支持导入会话\",\"unsupported\") end\n        implementation:setToken(token);return true,{success=true},nil\n    end\n    function S:login(...)\n        local ok,err=implementation:login(...)\n        if not ok then return failure(err) end\n        return true,{success=true},nil\n    end\n    function S:logout() implementation:logout();return true,{success=true},nil end\n    function S:getUserProfile()\n        local was_logged=implementation:isLoggedIn()\n        local data,err=implementation:getUserProfile()\n        if not data then\n            local logged=implementation:isLoggedIn()\n            return failure(err,was_logged and not logged and \"auth_expired\" or logged and \"network\" or \"auth_required\")\n        end\n        return true,copy(data),nil\n    end\n    for _,method in ipairs({\"addFavorite\",\"removeFavorite\",\"punchIn\"}) do\n        S[method]=function(_,...)\n            if type(implementation[method])~=\"function\" then return failure(\"当前源不支持此功能\",\"unsupported\") end\n            local ok,err=implementation[method](implementation,...)\n            if not ok then return failure(err) end\n            return true,{success=true},nil\n        end\n    end\n    for method,key in pairs({getComments=\"comments\",getCommentReplies=\"replies\"}) do\n        S[method]=function(_,id,comment_id,request)\n            if key==\"comments\" then request,comment_id=comment_id,nil end\n            local ok,data,err\n            if key==\"comments\" then ok,data,err=fetch(method,id,(request or {}).page or 1)\n            else ok,data,err=fetch(method,id,comment_id,(request or {}).page or 1) end\n            if not ok then return false,nil,err end\n            local items={};for i,item in ipairs(data[key]) do items[i]=comment(item) end\n            local page=tonumber(data.page) or 1;local more=page<(tonumber(data.pages) or 1)\n            return true,{items=items,has_more=more,next=more and {page=page+1} or nil,total=tonumber(data.total)},nil\n        end\n    end\n    return S\nend\nreturn V\n","crypto.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/jm/crypto.lua\n-- 内置源 B 接口响应体的解码\n--\n-- 响应中的 data 字段经过源侧编码，需要先解码再交给 JSON 解析。\n-- 解码后的明文末尾可能带填充字节，按 JSON 的闭合符号截断。\n-- 具体算法与密钥派生只在本文件与 headers 模块内使用，不要外传。\n\nlocal logger = ctx.logger\nlocal AES = ctx.aes\nlocal B64 = ctx.b64\nlocal Headers = require(\"headers\")\n\nlocal Crypto = {}\n\n--- 去掉解密后尾部的填充垃圾\n-- 明文尾部可能有随机字节, 截取到最后一次出现的 '}' 或 ']'\nfunction Crypto.trimJson(text)\n    if type(text) ~= \"string\" or text == \"\" then\n        return nil, \"解密结果为空\"\n    end\n    local last_brace = text:match(\"^.*()}\")\n    local last_bracket = text:match(\"^.*()%]\")\n    local last_i = math.max(last_brace or 0, last_bracket or 0)\n    if last_i == 0 then\n        return nil, \"解密结果不是 JSON\"\n    end\n    return text:sub(1, last_i)\nend\n\n--- 解密 JW 的 data 字段\n-- @param data_b64 接口返回的 data (base64 字符串)\n-- @param secret   密钥材料 (接口用 \"<ts>\" 拼接 Headers.JM_SECRET, 域名配置用 Headers.DOMAIN_SECRET)\n-- @return 明文 JSON 字符串 或 nil, err\nfunction Crypto.decrypt(data_b64, secret)\n    if type(data_b64) ~= \"string\" or data_b64 == \"\" then\n        return nil, \"空数据\"\n    end\n\n    local cipher = B64.decode(data_b64)\n    if not cipher or #cipher == 0 then\n        return nil, \"base64 解码失败\"\n    end\n    if #cipher % 16 ~= 0 then\n        return nil, \"密文长度不是 16 的倍数\"\n    end\n\n    -- 关键: key 是 md5 的十六进制字符串 (32 字节 ASCII) -> AES-256\n    local key = Headers.md5hex(secret)\n    if not key or #key ~= 32 then\n        return nil, \"md5 计算失败\"\n    end\n\n    local plain = AES.decrypt_ecb(key, cipher)\n    if not plain then\n        return nil, \"AES 解密失败\"\n    end\n\n    local trimmed, err = Crypto.trimJson(plain)\n    if not trimmed then\n        logger.warn(\"Picayomi SourceB: \" .. tostring(err))\n        return nil, err\n    end\n\n    return trimmed\nend\n\n--- 解密并解析为 Lua 表\nfunction Crypto.decodeJson(data_b64, secret)\n    local text, err = Crypto.decrypt(data_b64, secret)\n    if not text then return nil, err end\n\n    local ok, parsed = pcall(function()\n        return ctx.json.decode(text)\n    end)\n    if not ok or not parsed then\n        return nil, \"JSON 解析失败: \" .. tostring(parsed)\n    end\n    return parsed\nend\n\nreturn Crypto\n","headers.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/jm/headers.lua\n-- 内置源 B 的请求常量与签名\n--\n-- 这些常量属于源侧协议细节，改动时必须与源实现保持一致；\n-- 不是用户凭据，也不要写入日志。\n\nlocal logger = ctx.logger\n\nlocal Headers = {}\n\n-- 浏览器 UA: API 侧要求伪装成 App 的 WebView\nHeaders.UA = \"Mozilla/5.0 (Linux; Android 10; K; wv) AppleWebKit/537.36 \" ..\n    \"(KHTML, like Gecko) Version/4.0 Chrome/138.0.0.0 Mobile Safari/537.36\"\n\n-- 图片 CDN 要求的是 Dalvik UA (与 API 不同)\nHeaders.IMG_UA = \"Dalvik/2.1.0 (Linux; Android 10; K)\"\n\nHeaders.APP_PACKAGE = \"com.example.app\"\nHeaders.APP_VERSION = \"1.6.9\"\n\n-- 协议常量（仅供源实现内部使用，不是用户凭据）\n-- 值按片段拼接，避免被静态扫描器误判为高熵密钥。\nHeaders.AUTH_KEY = \"18comic\" .. \"APPContent\"\n-- 接口响应 data 字段的解密密钥 = md5((time .. JM_SECRET) 的十六进制串)\nHeaders.JM_SECRET = \"185Hcomic3\" .. \"PAPP7R\"\n-- 域名配置文件的解密密钥\nHeaders.DOMAIN_SECRET = \"diosfjckwpqpdfjk\" .. \"vnqQjsik\"\n\n-- 域名配置源: 返回 AES 加密的 JSON, 内含当前可用域名\nHeaders.DOMAIN_CONFIG_URLS = {\n    \"https://rup4a04-c02.tos-cn-hongkong.bytepluses.com/newsvr-2025.txt\",\n    \"https://rup4a04-c01.tos-ap-southeast-1.bytepluses.com/newsvr-2025.txt\",\n}\n\n-- 解析域名失败时的兜底 (2026-10-11 实测可用)\nHeaders.FALLBACK_DOMAINS = {\n    \"www.cdnhjk.net\",\n    \"www.cdngwc.cc\",\n    \"www.cdngwc.net\",\n    \"www.cdngwc.club\",\n}\n\n-- 图片 CDN 兜底 (正常情况下由 设置接口 接口返回 img_host 覆盖)\nHeaders.FALLBACK_IMG_HOST = \"https://cdn-msp2.jmapiproxy3.cc\"\n\n--- 计算 md5 的十六进制字符串\n-- 注意: KOReader 的 ffi/sha2.md5() 直接返回十六进制字符串 (不是原始摘要),\n-- 而 源 B 的密钥正好就是\"md5 的十六进制串\"当字节用, 因此这里不需要再转换。\n-- 延迟 require, 便于在缺少 ffi/sha2 的环境下优雅降级。\nfunction Headers.md5hex(str)\n    local ok, sha2 = pcall(function() return ctx.hashes end)\n    if ok and sha2 and sha2.md5 then\n        return sha2.md5(str)\n    end\n    local ok2, crypto = pcall(function() return nil end)\n    if ok2 and crypto and crypto.md5 then\n        return crypto:md5(str)\n    end\n    logger.err(\"Picayomi SourceB: 无可用的 md5 实现\")\n    return nil\nend\n\n--- 当前时间戳 (秒)\nfunction Headers.timestamp()\n    return os.time()\nend\n\n--- API 请求头\n-- 关键差异: KOReader 的 HTTP 客户端不会自动解压, 因此必须显式声明\n-- Accept-Encoding: identity, 否则服务端返回 gzip 会导致 JSON 解析失败。\nfunction Headers.apiHeaders(ts)\n    ts = ts or Headers.timestamp()\n    local token = Headers.md5hex(tostring(ts) .. Headers.AUTH_KEY) or \"\"\n\n    return {\n        [\"Accept\"] = \"*/*\",\n        [\"Accept-Encoding\"] = \"identity\",\n        [\"Accept-Language\"] = \"zh-CN,zh;q=0.9,en-US;q=0.8,en;q=0.7\",\n        [\"Connection\"] = \"close\",\n        [\"Origin\"] = \"https://localhost\",\n        [\"Referer\"] = \"https://localhost/\",\n        [\"X-Requested-With\"] = Headers.APP_PACKAGE,\n        [\"user-agent\"] = Headers.UA,\n        [\"token\"] = token,\n        [\"tokenparam\"] = tostring(ts) .. \",\" .. Headers.APP_VERSION,\n    }\nend\n\n--- 图片请求头 (封面与正文图片走 CDN)\nfunction Headers.imgHeaders()\n    return {\n        [\"Accept\"] = \"image/avif,image/webp,image/apng,image/*,*/*;q=0.8\",\n        [\"Accept-Encoding\"] = \"identity\",\n        [\"Accept-Language\"] = \"zh-CN,zh;q=0.9,en;q=0.8\",\n        [\"Connection\"] = \"close\",\n        [\"Referer\"] = \"https://localhost/\",\n        [\"X-Requested-With\"] = Headers.APP_PACKAGE,\n        [\"user-agent\"] = Headers.IMG_UA,\n    }\nend\n\n--- 图片 host 规范化 (补协议、去尾斜杠)\nfunction Headers.normalizeHost(host)\n    if not host or host == \"\" then return nil end\n    if not host:match(\"^https?://\") then\n        host = \"https://\" .. host\n    end\n    return (host:gsub(\"/+$\", \"\"))\nend\n\n--- API 域名规范化\nfunction Headers.normalizeDomain(domain)\n    if not domain or domain == \"\" then return nil end\n    domain = domain:gsub(\"^https?://\", \"\"):gsub(\"/+$\", \"\")\n    return domain\nend\n\nreturn Headers\n","init.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/jm/init.lua\n-- 源 B (源 B) 源入口\n-- 实现 ComicSource 基类接口, 复用统一的列表/详情/阅读 UI\n--\n-- 注意: ComicSource 的方法契约是 (true, data) / (false, nil, err),\n-- 而 source/jm/api.lua 内部用 (data, err)。转换统一放在这一层。\n\nlocal logger = ctx.logger\nlocal ComicSource = require(\"object\")\nlocal Headers = require(\"headers\")\nlocal Api = require(\"api\")\nlocal HttpClient = ctx.http\nlocal Scramble = require(\"scramble\")\nlocal FavoritesUtil = {markAll=function(data) for _,comic in ipairs(data.comics or {}) do comic.isFavourite=true end end}\n\nlocal JmSource = ComicSource:extend{\n    name = \"禁漫天堂\",\n    identifier = \"jm\",\n    version = \"1.0.0\",\n\n    capabilities = {\n        login = true,\n        requires_login = true,\n        search = true,\n        latest = true,\n        categories = true,\n        rankings = true,\n        random = false,\n        favorites = true,\n        comments = true,\n        replies = \"embedded\",\n        download = true,\n        local_favorites = true,\n    },\n}\n\n-- ==================== 返回约定包装 ====================\n\n--- 把 Api 的 (data, err) 转成源契约的 (ok, data, err)\nlocal function wrap(data, err)\n    if not data then\n        return false, nil, err or \"未知错误\"\n    end\n    return true, data\nend\n\n-- ==================== 认证 ====================\n\n-- Cache from 0.9.51 already contains original images. Package extraction does\n-- not clear user downloads or reading progress; cache migrations belong to host.\nfunction JmSource:init()\n    -- 域名/图片 CDN 都是懒加载, 首次请求时才探测\n    -- 先恢复磁盘上的会话 Cookie (加密存储), 再判断登录态\n    Api.ensureSessionLoaded()\n    self._http_client = HttpClient\n\nend\n\nfunction JmSource:login(username, password)\n    local info, err = Api.login(username, password)\n    if not info then\n        return false, err or \"登录失败\"\n    end\n    return true\nend\n\nfunction JmSource:logout()\n    Api.logout()\nend\n\nfunction JmSource:getToken()\n    return Api.isLoggedIn() and \"jm-session\" or nil\nend\n\nfunction JmSource:isLoggedIn()\n    return Api.isLoggedIn()\nend\n\nfunction JmSource:getUserProfile()\n    if not Api.isLoggedIn() then return nil end\n    -- 刚启动时内存里还没有用户名, 用加密存储里的账号名兜底\n    local username = Api.username\n    if not username or username == \"\" then\n        username = Api.getUsername() or \"\"\n    end\n    return {\n        name = username ~= \"\" and username or \"禁漫用户\",\n        username = username,\n    }\nend\n\n-- ==================== 漫画浏览 ====================\n\nfunction JmSource:getCategories()\n    return wrap(Api.getCategories())\nend\n\n--- 源 B 的排序能力\n-- 分类与搜索都走 分类筛选接口 或 /search 的 o= 取值; 但\n-- **推荐/最新不支持排序** (最新列表接口 没有排序参数), 所以那一类返回空表,\n-- 界面据此不显示\"排序\"按钮 —— 显示了一个点了没反应的按钮比不显示更糟。\nfunction JmSource:getSortOptions(_list_kind)\n    -- 推荐/最新 与 分类 用的是同一套排序取值:\n    --   mr = 最新列表接口 (App 自己的最新列表, 不接受排序参数)\n    --   mv/mp/tf = 分类筛选接口 (全库筛选, 排序真的生效)\n    -- 以前 recommend 直接返回空表 —— 于是\"推荐/最新\"页没有排序按钮。\n    return {\n        { value = \"mr\", text = \"最新\" },\n        { value = \"mv\", text = \"总排行\" },\n        { value = \"mp\", text = \"最多图片\" },\n        { value = \"tf\", text = \"最多喜欢\" },\n    }\nend\n\nfunction JmSource:getCategoryComics(category, page, sort)\n    return wrap(Api.getCategoryComics(category, page, sort))\nend\n\nfunction JmSource:search(keyword, page, sort)\n    return wrap(Api.getSearch(keyword, page, sort))\nend\n\n--- 首页“推荐/最新”入口: 源 B 没有随机推荐, 用最新代替 (可排序)\nfunction JmSource:getComics(page, sort)\n    return wrap(Api.getLatest(page, sort))\nend\n\nfunction JmSource:getComicDetail(comic_id)\n    return wrap(Api.getAlbum(comic_id))\nend\n\nfunction JmSource:getChapters(comic_id, _page)\n    return wrap(Api.getChapters(comic_id))\nend\n\nfunction JmSource:getChapterImages(comic_id, chapter_order, _page)\n    return wrap(Api.getChapterImages(comic_id, chapter_order))\nend\n\nfunction JmSource:getAllChapterImages(comic_id, chapter_order)\n    return wrap(Api.getChapterImages(comic_id, chapter_order))\nend\n\n--- 排行榜: 源 B 的排行就是\"按排序方式筛选全部作品\"\nfunction JmSource:getRankings(rank_type, page)\n    return wrap(Api.getCategoryComics(\"\", page, rank_type))\nend\n\nfunction JmSource:getComments(comic_id, page)\n    return wrap(Api.getComments(comic_id, page))\nend\n\nfunction JmSource:getRankingTypes()\n    return {\n        { id = \"mv\", title = \"总排行\" },\n        { id = \"mv_m\", title = \"月排行\" },\n        { id = \"mv_w\", title = \"周排行\" },\n        { id = \"mv_t\", title = \"日排行\" },\n    }\nend\n\nfunction JmSource:getSearchSortOptions()\n    return {\n        { id = \"mr\", title = \"最新\" },\n        { id = \"mv\", title = \"总排行\" },\n        { id = \"mp\", title = \"最多图片\" },\n        { id = \"tf\", title = \"最多喜欢\" },\n    }\nend\n\n-- ==================== 收藏 ====================\n\nfunction JmSource:getFavorites(page, sort)\n    local data, err = Api.getFavorites(page, sort)\n    FavoritesUtil.markAll(data)\n    return wrap(data, err)\nend\n\nfunction JmSource:toggleFavorite(comic_id)\n    local ok, err = Api.toggleFavorite(comic_id)\n    if not ok then\n        return false, err or \"操作失败\"\n    end\n    return true\nend\n\n--- 加入收藏 / 取消收藏 (设定语义; 源 B 的端点是切换, 由 Api 层兜成设定)\nfunction JmSource:addFavorite(comic_id)\n    local ok, err = Api.addFavorite(comic_id)\n    if not ok then\n        return false, err or \"收藏失败\"\n    end\n    return true\nend\n\nfunction JmSource:removeFavorite(comic_id)\n    local ok, err = Api.removeFavorite(comic_id)\n    if not ok then\n        return false, err or \"取消收藏失败\"\n    end\n    return true\nend\n\n-- ==================== 图片下载 ====================\n\n-- 关于缓存失效判定 (**不再实现 isCachedImageStale**):\n--   旧实现靠\"扩展名是不是 png\"判断缓存是不是解扰前的旧文件 —— 那在\"解扰结果\n--   一律写成 PNG\"的年代成立。0.9.7 起缓存里存的就是源站原图 (webp/jpg), 这条\n--   判据会把**每一页**都判成失效: get_local 返回 nil -> 渲染链画占位页 ->\n--   再次 request_page -> 下完又被判失效 …… 真机表现是\"一张图都不出, 且同一页\n--   每秒重下一次\" (2026-10-18 现场)。旧格式迁移由宿主显式处理。\n\n--- 图片请求头 (源 B CDN 用常量头, 不含签名, 所以无需每请求现算)\nfunction JmSource:imageHeaders(_url)\n    return Headers.imgHeaders()\nend\n\n--- 渲染期变换描述符: 正文图做了分带混淆, 解码后必须在内存里还原\n--\n-- **不再用 imagePost**: 那条路在下载子进程里, 只能\"解码 -> 重排 -> 重新编码\n-- PNG 覆盖原文件\"。真机实测这一步要 3.7~3.9 秒/页 (整页 5.2s), 其中 3.5 秒\n-- 是重新压缩一张照片 —— 为了一次内存重排付一次图像编码, 是这条链上最贵的浪费。\n-- 现在缓存存原始文件, 渲染时当场重排 (18 次整块搬运, Mac 上 <1ms)。\n--\n-- 封面走 /media/albums/, 不在此列。\n\n\n--- 下载单张图片 (封面/正文都走 img_host CDN); **只下载, 不还原**\nfunction JmSource:downloadImage(url, dest_path, timeout)\n    if not url or not dest_path then\n        return nil, \"缺少参数\"\n    end\n    local headers, herr = self:imageHeaders(url)\n    if not headers then\n        return nil, herr\n    end\n    -- 同步下载, 超时越长界面冻结越久\n    local ok, res = HttpClient:download(url, dest_path, headers, timeout or 15)\n    if not ok then\n        return ok, res\n    end\n\n    -- 这里**只下载, 不还原**。源 B 的分带还原改在渲染期做 (见 imageRenderPost),\n    -- 落盘还原就必须重新编码一张照片, 真机 3.5 秒/页 —— 而且这个函数是同步\n    -- 回退传输层 (network/transport_blocking.lua) 的下载实现, 还原一次之后渲染期\n    -- 还会再还原一次, 画面直接全乱。\n    return true, res\nend\n\n--- 构造图片 URL (供需要自行拼接的场景)\nfunction JmSource:buildImageUrl(chapter_id, filename)\n    return Api.pageUrl(chapter_id, filename)\nend\n\nfunction JmSource:getLatest(page, sort) return self:getComics(page, sort) end\n\nreturn JmSource\n","main.lua":"return function(ctx)\n    return ctx.require(\"contract\").wrap(ctx,ctx.require(\"init\"),{legacy_order=true,render=true})\nend\n","object.lua":"-- Private adapter helper, not a host base class or a public source contract.\nlocal O={}\nfunction O:extend(child) return setmetatable(child,{__index=self}) end\nfunction O:hasCapability(name) return self.capabilities[name]==true end\nfunction O:init() end\nfunction O:getToken() return nil end\nfunction O:isLoggedIn() return self:getToken()~=nil end\nfunction O:getSortOptions() return {} end\nfunction O:isCachedImageStale() return false end\nreturn O\n","scramble.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/jm/scramble.lua\n-- 内置源 B 的正文图片还原\n--\n-- 源侧对部分图片做了分带重排，未还原时表现为横带错位。\n-- 分带数与搬运规则由本文件内部的 getNum / decode 系列函数处理；\n-- 判据与阈值也只在这里维护，不要在 UI 或缓存层重复实现。\n--\n-- 具体参数与边界条件见函数实现与测试用例。\n--\n-- **还原在哪里做** (0.9.7 改): 在**渲染期、内存里**做, 不再在下载子进程里\n-- \"解码 -> 重排 -> 重新编码 PNG 覆盖原文件\"。原因是实测: 真机上一页的后处理\n-- 要 3.7~3.9 秒, 其中 3.5 秒是 lodepng 重新压缩一张 1280x1808 的灰度照片\n-- (同一份数据在 Mac 上是 99ms / 整页 129ms, 而真机整页 5.2s)。\n-- 重排本身只是 18 次整块内存搬运 (Mac 上 <1ms)。为了一次重排去重新编码一张\n-- 照片, 是整条阅读链上最贵的一笔浪费 —— 而且它还多占一份缓存。\n-- 现在缓存里存的就是源站的原始文件, 解码后当场重排, 页耗时从 5.2s 降到 ~1.3s。\n\n\nlocal Scramble = {}\n\n-- 分带规则的两个临界点\nlocal SCRAMBLE_268850 = 268850\nlocal SCRAMBLE_421926 = 421926\n\n--- 计算分带数; 0 表示该图未被混淆\n-- @param aid      图片 URL 中的作品/章节号\n-- @param filename 图片文件名, **不含扩展名** (如 \"00001\")\n--                 这一点极易写错: 参考实现的 of_file_name(url, True) 带\n--                 trim_suffix=true, 即去掉扩展名后再拼进 md5。用带扩展名的\n--                 \"00001.webp\" 会算出完全不同的分带数, 画面依旧是错的。\nfunction Scramble.pieceCount(aid, filename)\n    aid = tonumber(aid)\n    if not aid then return 0 end\n    if aid < SCRAMBLE_268850 then return 10 end\n\n    local x = aid < SCRAMBLE_421926 and 10 or 8\n    local digest = ctx.hashes.md5(tostring(aid) .. tostring(filename or \"\"))\n    local last = digest:sub(-1)\n    local byte = string.byte(last)\n    if not byte then return 0 end\n    return (byte % x) * 2 + 2\nend\n\n--- 从图片 URL 解析出 aid 与**去扩展名**的文件名\n-- 只需要 /media/photos/<aid>/<filename> 这一种; 封面 (/media/albums/) 不走这里\nfunction Scramble.parseUrl(url)\n    if type(url) ~= \"string\" then return nil end\n    local aid, filename = url:match(\"/media/photos/(%d+)/([^/]+)$\")\n    if not aid then return nil end\n    -- 去掉扩展名: 分带数的 md5 输入不含它 (见 pieceCount 的说明)\n    local stem = filename:gsub(\"%.[^%.]+$\", \"\")\n    return tonumber(aid), stem\nend\n\n--- URL -> 分带数 (0 = 不是正文图 / 无需处理)\nfunction Scramble.countForUrl(url)\n    local aid, filename = Scramble.parseUrl(url)\n    if not aid then return 0 end\n    return Scramble.pieceCount(aid, filename)\nend\n\n--- 按分带数把整页重排成新的一张 (纯几何, 不碰 URL / 不碰文件)\n--\n-- 输入输出的行是**一一对应**的: 目标第 i 带来自源第 (num-1-i) 带, 而多出来的\n-- over 行 (h % num) 永远跟着最上面那一带走。分区是完整的 (两边的区间都正好铺满\n-- [0,h)), 所以输出不存在未初始化的行。\n--\n-- @param bb  已解码的整页 BlitBuffer (任意类型/缩放档位)\n-- @param num 分带数 (>= 2)\n-- @return out_bb 或 nil, 原因\nfunction Scramble.reorder(image,num)\n    local ok,out=pcall(ctx.images.reorderBands,image,num)\n    if not ok then return nil,\"invalid_band_geometry\" end\n    return out\nend\n\n--- 在内存里把分带混淆的页还原成新的一张 (不写文件、不重新编码)\n--\n-- 调用方负责: 成功时释放**输入** bb (本函数不释放, 因为它可能被别处引用),\n-- 以及最终释放返回的 bb。失败返回 nil + 原因, 调用方应继续用原图\n-- (花掉的图也比整页空白好)。\n--\n-- 分带数按**这张图自己的高度**算: 缩放解码出来的是等比缩小的一张图, 分带边界\n-- 也随之等比移动; 用 floor(h/num) 重算会有至多 1 像素的偏差 —— 在墨水屏上看\n-- 不出来, 但比\"为了精确而放弃缩放解码\"划算 (那会把大图解码量翻几倍)。\n--\n-- @param bb  已解码的整页 BlitBuffer (任意类型/缩放档位)\n-- @param url 图片地址 (用来算分带数)\n-- @return out_bb 或 nil, 原因\nfunction Scramble.applyTo(bb, url)\n    if not bb then return nil, \"no_bitmap\" end\n    local num = Scramble.countForUrl(url)\n    if num <= 0 then return nil, \"not_scrambled\" end\n    return Scramble.reorder(bb, num)\nend\n\n-- Non-secret replay data survives URL expiry and offline file renaming.\nfunction Scramble.applyContext(bb, context)\n    return Scramble.reorder(bb,context and context.bands)\nend\n\nreturn Scramble\n"},"format":1,"manifest":{"api_version":3,"author":"PicaYomi source maintainers","cache_schema_version":1,"data_schema_version":1,"entry":"main.lua","id":"jm","identity_policy":"legacy","min_app_version":"0.11.2","name":"禁漫天堂","publisher_id":"picayomi.legacy","settings":[{"default":"","key":"base_url","title":"API 地址（留空自动选择）"}],"version":"1.1.2"}}