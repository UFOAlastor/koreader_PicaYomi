{"files":{"api.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/picacg/api.lua\n-- 源 A API 方法\n-- 从 api/comic.lua 重构，统一响应处理\n\nlocal logger = ctx.logger\nlocal json = ctx.json\nlocal config = ctx.config\nlocal cache = ctx.cache\nlocal JN = ctx.values\nlocal B64 = ctx.b64\n\nlocal PicacgAPI = {}\n\n-- 缓存有效期 (秒)\nlocal CACHE_TTL = {\n    CATEGORIES = 86400,   -- 1 天\n    COMICS     = 3600,    -- 1 小时\n    DETAIL     = 86400,   -- 1 天\n    EPISODES   = 3600,    -- 1 小时\n    IMAGES     = 3600,    -- 1 小时\n    SEARCH     = 1800,    -- 30 分钟\n    FAVORITES  = 1800,    -- 30 分钟\n    RANKING    = 3600,    -- 1 小时\n    COMMENTS   = 600,     -- 10 分钟 (评论变动快, 缓存短一些)\n}\n\n--- 统一 API 请求\n-- @param http_client: HttpClient 实例\n-- @param headers: Headers 模块\n-- @param auth: Auth 模块\n-- @param method: \"GET\"/\"POST\"/\"DELETE\"\n-- @param path: API 路径 (如 \"comics/xxx\" 或 \"auth/sign-in\")\n-- @param body: 请求体 (POST 时传入)\n-- @return: response_data 表 (有 code/message/data) 或 nil, err\nfunction PicacgAPI:request(http_client, headers, auth, method, path, body)\n    local token = auth:getToken()\n    -- 允许部分接口无 token (如登录)\n    local req_headers = headers:build(path, method, token)\n    if not req_headers then\n        return nil, \"请求头构造失败\"\n    end\n\n    local url = headers:buildUrl(path)\n    local response, err = http_client:requestWithRetry(method, url, req_headers, body, 15)\n\n    if not response then\n        return nil, \"网络请求失败: \" .. tostring(err)\n    end\n\n    -- 解析 JSON\n    local data = http_client:parseJsonResponse(response)\n    if not data then\n        -- 可能是非 JSON 响应 (如 HTML 错误页)\n        logger.err(\"Picayomi SourceAAPI: JSON 解析失败, path=\" .. path ..\n            \", status=\" .. tostring(response.status_code) ..\n            \", body_len=\" .. #(response.body or \"\"))\n        return nil, \"响应解析失败\"\n    end\n\n    -- 标准化响应: 确保有 code/message/data\n    if data.code == nil then data.code = response.status_code end\n    if data.data == nil then data.data = {} end\n\n    return data\nend\n\n--- 判断响应是否成功\nlocal function isOk(data)\n    return data and (data.code == 200 or data.message == \"success\")\nend\n\n--- 从漫画表提取标准化字段\n-- 注意: KOReader 的 rapidjson 把 JSON null 解码为真值 userdata,\n-- 因此不能用 `x or \"默认值\"`, 必须用 JN 系列做类型过滤。\n--- 只保留日期部分: 源 A 给的是 ISO 串 (\"2025-05-04T13:04:31.435Z\")\n-- 卡片与详情页都按 \"YYYY-MM-DD\" 展示; 认不出格式就原样返回 (至少不丢信息)。\nlocal function date_only(v)\n    local s = JN.str(v)\n    if not s or s == \"\" then return nil end\n    return s:match(\"^(%d%d%d%d%-%d%d%-%d%d)\") or s\nend\n\nlocal function normalizeComic(comic)\n    if not comic or type(comic) ~= \"table\" then return nil end\n\n    local thumb_url = \"\"\n    if type(comic.thumb) == \"table\" then\n        local fs = JN.str(comic.thumb.fileServer)\n        local path = JN.str(comic.thumb.path)\n        if fs and path then\n            thumb_url = fs .. \"/static/\" .. path\n        end\n    elseif type(comic.thumb) == \"string\" then\n        thumb_url = comic.thumb\n    end\n\n    local tags = JN.str_list(comic.tags)\n    for _idx, c in ipairs(JN.str_list(comic.categories)) do\n        table.insert(tags, c)\n    end\n\n    local id = JN.str(comic._id) or JN.str(comic.id) or JN.num(comic._id) or JN.num(comic.id)\n\n    return {\n        _id = id and tostring(id) or \"\",\n        title = JN.str(comic.title) or \"未知标题\",\n        author = JN.str(comic.author) or \"未知作者\",\n        thumb = thumb_url,\n        tags = tags,\n        pagesCount = JN.num(comic.pagesCount, JN.num(comic.pages, 0)),\n        epsCount = JN.num(comic.epsCount, 0),\n        finished = JN.bool(comic.finished),\n        likesCount = JN.num(comic.likesCount, JN.num(comic.totalLikes, 0)),\n        viewsCount = JN.num(comic.viewsCount, JN.num(comic.totalViews, 0)),\n        categories = JN.str_list(comic.categories),\n        description = JN.str(comic.description, \"\"),\n        chineseTeam = JN.str(comic.chineseTeam, \"\"),\n        -- 列表与详情都返回 updated_at (ISO 串); 以前没接, 卡片与详情页都没有\n        -- \"更新时间\"这一项 (三个源里只有源 C 显示了它)。\n        update_time = date_only(comic.updated_at),\n        -- **收藏状态必须带上**。列表接口不返回 isFavourite (只有收藏列表接口的条目\n        -- 才被 util/favorites.markAll 补成\"已收藏\"), 所以详情页靠\"问源\"这一次来\n        -- 拿到真实状态 (ui/common/comic_detail.lua:syncFavoriteStateFromSource)。\n        -- 这里漏掉它, 那条路径就永远拿到 nil, 直接 return —— 表现是**已收藏的漫画\n        -- 从搜索/排行榜/分类进去都显示成「收藏」** (用户报的就是这个)。\n        -- 字段名以 docs/05_API参考手册.md 的 /comics/{id} 响应为准。\n        isFavourite = JN.bool(comic.isFavourite),\n    }\nend\n\n--- 提取漫画列表 (标准分页格式)\nlocal function extractComicList(data)\n    if not data or not data.data then return nil end\n    local comics_raw = nil\n    local total, page, pages = 0, 1, 1\n\n    -- 标准: data.comics.docs\n    --\n    -- total/page/pages 必须是 **number**: 源会把它们当字符串 (\"2\") 返回, 也可能给 JSON\n    -- null (rapidjson 解成真值 userdata, `x or 1` 挡不住)。下游 (列表补货 / 页脚) 会拿\n    -- 它们做比较 —— v0.8.6 的\"点返回闪退\"就是 `number < string` 在 scheduleIn 任务里炸。\n    -- 与 JM 源一致, 在源这一层就清洗干净, 不指望每个消费方都记得 tonumber。\n    if type(data.data.comics) == \"table\" and type(data.data.comics.docs) == \"table\" then\n        comics_raw = data.data.comics.docs\n        total = JN.num(data.data.comics.total, #comics_raw)\n        page = JN.num(data.data.comics.page, 1)\n        pages = JN.num(data.data.comics.pages, 1)\n\n    -- 数组: data.comics 直接是数组\n    elseif data.data.comics and type(data.data.comics) == \"table\" and #data.data.comics > 0 then\n        comics_raw = data.data.comics\n        total = #comics_raw\n        pages = 1\n\n    -- 遍历 data 找数组\n    elseif type(data.data) == \"table\" then\n        for k, v in pairs(data.data) do\n            if type(v) == \"table\" and #v > 0 and v[1] and (v[1].title or v[1]._id) then\n                comics_raw = v\n                total = #v\n                pages = 1\n                if logger.enabled then logger.dbg(\"PicacgAPI: 从 data.\" .. k .. \" 提取漫画列表\") end\n                break\n            end\n        end\n    end\n\n    if not comics_raw then return nil end\n\n    local comics = {}\n    for _, c in ipairs(comics_raw) do\n        local nc = normalizeComic(c)\n        if nc then table.insert(comics, nc) end\n    end\n\n    return {\n        comics = comics,\n        total = total,\n        page = page,\n        pages = pages,\n    }\nend\n\n-- 无分类 ID 的条目是网页/特殊推荐入口, 不能传给分类搜索接口。\n-- 缓存命中也要过滤, 升级后无需等待旧分类缓存过期。\nlocal function comicCategories(categories)\n    local result = {}\n    for _, category in ipairs(categories) do\n        if type(category) == \"table\" and JN.str(category._id)\n                and category._id ~= \"\" and not JN.bool(category.isWeb)\n                and category.active ~= false then\n            result[#result + 1] = category\n        end\n    end\n    return result\nend\n\n--- 获取分类\nfunction PicacgAPI:getCategories(http_client, headers, auth)\n    local cache_key = \"picacg_categories\"\n    local cached = cache:getData(cache_key)\n    if cached then return true, comicCategories(cached) end\n\n    local data = self:request(http_client, headers, auth, \"GET\", \"categories\")\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取分类失败\" end\n\n    local categories = {}\n    if data.data and data.data.categories then\n        categories = data.data.categories\n    elseif type(data.data) == \"table\" then\n        for _, v in pairs(data.data) do\n            if type(v) == \"table\" then\n                for _, item in ipairs(v) do\n                    if type(item) == \"string\" then\n                        table.insert(categories, item)\n                    end\n                end\n            end\n        end\n    end\n\n    categories = comicCategories(categories)\n    cache:cacheData(cache_key, categories, os.time() + CACHE_TTL.CATEGORIES)\n    return true, categories\nend\n\n--- 获取漫画列表 (首页推荐)\nfunction PicacgAPI:getComics(http_client, headers, auth, page, sort)\n    page = page or 1\n    sort = sort or \"dd\"\n    local cache_key = \"picacg_comics_\" .. page .. \"_\" .. sort\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"comics?page=\" .. page .. \"&s=\" .. sort\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取漫画列表失败\" end\n\n    local result = extractComicList(data)\n    if not result then\n        return false, nil, \"漫画列表数据格式异常\"\n    end\n\n    cache:cacheData(cache_key, result, os.time() + CACHE_TTL.COMICS)\n    return true, result\nend\n\n--- 把分类 id 解析为分类标题\n-- 重要: 源 A 的 advanced-search 接口接收的是分类\"标题\"(如 \"短篇\")，\n-- 传 _id 会返回 200 但结果为空 (曾导致所有分类都显示\"没有漫画\")。\n-- UI 层传的是 id，这里做一次映射 (分类列表有缓存，开销很低)。\n-- @return: 分类标题, 或原值 (无法解析时)\nfunction PicacgAPI:resolveCategoryName(http_client, headers, auth, category)\n    if category == nil then return nil end\n    local s = tostring(category)\n    if s == \"\" then return s end\n\n    -- ObjectId 形如 24 位十六进制\n    if not s:match(\"^%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x%x$\") then\n        return s\n    end\n\n    local ok, cats = self:getCategories(http_client, headers, auth)\n    if ok and type(cats) == \"table\" then\n        for _i, c in ipairs(cats) do\n            if tostring(c._id) == s then\n                return c.title\n            end\n        end\n    end\n    return s\nend\n\n--- 获取分类下的漫画\n-- 分类浏览与搜索共用 comics/advanced-search，注意两点:\n--   1. categories 要传分类\"标题\"而非 id\n--   2. page 必须放在查询串 (?page=N), 放在 body 里会被服务端忽略\nfunction PicacgAPI:getCategoryComics(http_client, headers, auth, category, page, sort)\n    page = page or 1\n    sort = sort or \"dd\"\n\n    local category_name = self:resolveCategoryName(http_client, headers, auth, category)\n    if not category_name then\n        return false, nil, \"无效的分类\"\n    end\n\n    local cache_key = \"picacg_cat_v2_\" .. category_name .. \"_\" .. page .. \"_\" .. sort\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"comics/advanced-search?page=\" .. page\n    local body = json.encode({\n        keyword = \"\",\n        sort = sort,\n        categories = { category_name },\n    })\n\n    local data = self:request(http_client, headers, auth, \"POST\", path, body)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取分类漫画失败\" end\n\n    local result = extractComicList(data)\n    if not result then return false, nil, \"分类漫画数据格式异常\" end\n\n    cache:cacheData(cache_key, result, os.time() + CACHE_TTL.COMICS)\n    return true, result\nend\n\n--- 搜索漫画\nfunction PicacgAPI:search(http_client, headers, auth, keyword, page, sort, categories)\n    page = page or 1\n    sort = sort or \"dd\"\n    local cache_key = \"picacg_search_\" .. keyword .. \"_\" .. page .. \"_\" .. sort\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    -- 注意: page 必须放在查询串, 放 body 里会被服务端忽略 (分页失效)\n    local path = \"comics/advanced-search?page=\" .. page\n    local body = json.encode({\n        keyword = keyword,\n        sort = sort,\n        categories = categories or {},\n    })\n\n    local data = self:request(http_client, headers, auth, \"POST\", path, body)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"搜索失败\" end\n\n    local result = extractComicList(data)\n    if not result then return false, nil, \"搜索结果数据格式异常\" end\n\n    cache:cacheData(cache_key, result, os.time() + CACHE_TTL.SEARCH)\n    return true, result\nend\n\n--- 获取随机漫画\nfunction PicacgAPI:getRandom(http_client, headers, auth, page)\n    page = page or 1\n    local cache_key = \"picacg_random_\" .. page\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"comics/random?page=\" .. page\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取随机漫画失败\" end\n\n    local result = extractComicList(data)\n    if not result then\n        result = { comics = {}, total = 0, page = page, pages = 1 }\n    end\n\n    cache:cacheData(cache_key, result, os.time() + CACHE_TTL.COMICS)\n    return true, result\nend\n\n--- 获取漫画详情\nfunction PicacgAPI:getComicDetail(http_client, headers, auth, comic_id)\n    local cache_key = \"picacg_detail_\" .. comic_id\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"comics/\" .. comic_id\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取详情失败\" end\n\n    -- comic 缺失 / 为 JSON null (userdata, `or {}` 挡不住) / 不是表: 判失败。\n    -- 旧写法会造出一条 _id=\"\" 的\"详情\"并缓存一天 (之后每次进来都是空白详情);\n    -- comic 为 null 时 normalizeComic 返回 nil, 下一行索引 nil 直接抛异常。\n    local detail = type(data.data) == \"table\" and type(data.data.comic) == \"table\"\n        and normalizeComic(data.data.comic) or nil\n    if not detail or detail._id == \"\" then\n        return false, nil, \"详情数据格式异常\"\n    end\n    detail.description = detail.description or \"暂无描述\"\n    detail.chineseTeam = detail.chineseTeam or \"\"\n\n    cache:cacheData(cache_key, detail, os.time() + CACHE_TTL.DETAIL)\n    return true, detail\nend\n\n--- 获取章节列表\nfunction PicacgAPI:getEpisodes(http_client, headers, auth, comic_id, page)\n    page = page or 1\n    local cache_key = \"picacg_eps_\" .. comic_id .. \"_\" .. page\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"comics/\" .. comic_id .. \"/eps?page=\" .. page\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取章节失败\" end\n\n    local eps = { episodes = {}, total = 0, page = page, pages = 1 }\n    if data.data and type(data.data.eps) == \"table\" then\n        -- docs 可能是 JSON null (userdata): 下游对它 ipairs / # 都会炸, 用 JN.list 过滤\n        eps.episodes = JN.list(data.data.eps.docs)\n        eps.total = JN.num(data.data.eps.total, #eps.episodes)\n        eps.page = JN.num(data.data.eps.page, page)\n        eps.pages = JN.num(data.data.eps.pages, 1)\n    end\n\n    cache:cacheData(cache_key, eps, os.time() + CACHE_TTL.EPISODES)\n    return true, eps\nend\n\n-- ============================================================================\n-- 图片地址: 图片代理 缩略图 -> 原图\n-- ============================================================================\n\n--- 图片代理 地址里那一段 base64 就是原图地址\n--\n-- 2026-10-18 真机实测 (抓的是 章节图片接口 的真实响应):\n--   media.path 已经**不是**静态文件路径, 而是源 A 自己的 图片代理 签名地址:\n--     <fs>带缩放的签名图片地址\n--   直接下它拿到的是**服务端缩放到 800 的缩略图**:\n--     缩略图 566x800 / 66KB   原图 1200x1695 / 480KB\n--   源 C 给的是原图 (1444x2048), 所以\"源 A 比源 C 糊\" —— 根因不在解码,\n--   而在我们下的本来就不是原图。\n--\n-- 图片代理 的 rs:fit 参数在签名里, 改不了; 但 g:ce 之后那一段就是原图地址本身,\n-- 解出来直接请求静态文件即可 (实测 200, 且不需要任何签名头)。\n--\n-- @param url 接口给的地址 (可能本来就是普通静态地址, 这时原样返回)\n-- @return 原图地址 或 nil (不是 图片代理 形式 / 解不出来)\nfunction PicacgAPI.originalImageUrl(url)\n    if type(url) ~= \"string\" or url == \"\" then return nil end\n    if not url:find(\"/tobeimg/\", 1, true) then return nil end\n\n    -- 取最后一段, 去掉 .jpg (扩展名是 图片代理 按输出格式加的, 原图可能是 png)\n    local tail = url:match(\"([^/]+)$\")\n    if not tail then return nil end\n    tail = tail:gsub(\"%.[%a]+$\", \"\")\n    if tail == \"\" then return nil end\n\n    -- 这段是 base64url (含 - 和 _), 且经常缺 '=' 填充\n    tail = tail:gsub(\"%-\", \"+\"):gsub(\"_\", \"/\")\n    local ok, decoded = pcall(B64.decode, tail)\n    if not ok or type(decoded) ~= \"string\" then return nil end\n    if not decoded:match(\"^https?://\") then return nil end\n    return decoded\nend\n\n--- 该不该下原图 (图片质量设置)\n--\n-- 源 A 的图片有两档可选: 服务端缩略图 (图片代理, ~800px) 与**原图**。\n-- 中间档拿不到 —— 缩放参数在签名里。所以设置项只有两档 (见 ui/settings/reading.lua)。\n-- 旧配置里的 medium / high 一律按原图处理 (high 以前写进 image-quality 头,\n-- 但那个头对图床无效, 等于什么都没做)。\nfunction PicacgAPI.preferOriginal()\n    local q = config:get(\"image_quality\")\n    return q ~= \"low\"\nend\n\n--- 获取章节图片 (单页)\nfunction PicacgAPI:getEpisodeImages(http_client, headers, auth, comic_id, order, page)\n    page = page or 1\n    -- 画质进缓存键: 图片列表里存的已经是**解析好的最终地址** (原图 / 图片代理 缩略图),\n    -- 而列表要缓存 1 小时。不带画质的话, 用户切到「缩略图」后再进同一话, 拿到的还是\n    -- 上一小时的原图地址 —— 表现就是\"这个设置没用\"。带上之后切换立刻生效, 切回去\n    -- 也还能命中原来那份。\n    local quality_tag = PicacgAPI.preferOriginal() and \"orig\" or \"thumb\"\n    local cache_key = \"picacg_images_\" .. comic_id .. \"_\" .. order .. \"_\" .. page\n        .. \"_\" .. quality_tag\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"comics/\" .. comic_id .. \"/order/\" .. order .. \"/pages?page=\" .. page\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取图片失败\" end\n\n    local images_data = { images = {}, pages = 1, page = page, total = 0 }\n    if data.data and type(data.data.pages) == \"table\" then\n        local pages_data = data.data.pages\n        images_data.pages = JN.num(pages_data.pages, 1)\n        images_data.page = JN.num(pages_data.page, page)\n        images_data.total = JN.num(pages_data.total, 0)\n\n        if type(pages_data.docs) == \"table\" then\n            for i, doc in ipairs(pages_data.docs) do\n                if type(doc) == \"table\" and type(doc.media) == \"table\" and doc.media.path then\n                    local url = (doc.media.fileServer or \"\") .. \"/static/\" .. (doc.media.path or \"\")\n                    -- 默认下原图; 只有用户显式选了「低」才用服务端缩略图\n                    -- (见 PicacgAPI.originalImageUrl 的实测数据)\n                    if PicacgAPI.preferOriginal() then\n                        url = PicacgAPI.originalImageUrl(url) or url\n                    end\n                    table.insert(images_data.images, {\n                        _id = doc._id or (\"image_\" .. i),\n                        url = url,\n                        index = i,\n                    })\n                end\n            end\n        end\n    end\n\n    cache:cacheData(cache_key, images_data, os.time() + CACHE_TTL.IMAGES)\n    return true, images_data\nend\n\n--- 获取章节所有图片 (自动分页)\nfunction PicacgAPI:getAllEpisodeImages(http_client, headers, auth, comic_id, order)\n    local ok, first_page = self:getEpisodeImages(http_client, headers, auth, comic_id, order, 1)\n    if not ok or not first_page or not first_page.images or #first_page.images == 0 then\n        return false, nil, \"获取图片失败\"\n    end\n\n    local total_pages = first_page.pages or 1\n    if total_pages <= 1 then\n        first_page.total_pages = 1\n        return true, first_page\n    end\n\n    local all_images = {\n        images = {},\n        total_pages = total_pages,\n    }\n    for _, img in ipairs(first_page.images) do\n        table.insert(all_images.images, img)\n    end\n\n    for p = 2, total_pages do\n        local p_ok, p_data, p_err = self:getEpisodeImages(http_client, headers, auth, comic_id, order, p)\n        if p_ok and p_data and p_data.images then\n            for _, img in ipairs(p_data.images) do\n                table.insert(all_images.images, img)\n            end\n        else\n            -- 中间某页取失败: **整体报失败**, 不返回残缺列表。\n            -- 旧实现 warn + break 后仍返回成功, 后果是两头都错:\n            --   * 下载: 把只有前几页的章节标成\"已完成\", 缺的页永远补不上;\n            --   * 阅读: 章节凭空变短, 读到\"最后一页\"就弹\"读完了/下一话\"。\n            -- 已取回的页在 getEpisodeImages 里按页缓存, 用户重试几乎零成本。\n            logger.warn(\"PicacgAPI: 第 \" .. p .. \"/\" .. total_pages .. \" 页图片列表获取失败: \"\n                .. tostring(p_err))\n            return false, nil, string.format(\"第 %d/%d 页图片列表获取失败: %s\",\n                p, total_pages, tostring(p_err or \"未知错误\"))\n        end\n    end\n\n    if logger.enabled then logger.info(\"PicacgAPI: 总共 \" .. #all_images.images .. \" 张图片\") end\n    return true, all_images\nend\n\n-- ==================== 评论 ====================\n\n--- 获取评论列表\n--\n-- 注意 page 必须放在**查询串**里: 源 A 的服务端会忽略请求体里的分页参数\n-- (与 search/getCategoryComics 同一个坑, 见那边的注释)。\nfunction PicacgAPI:getComments(http_client, headers, auth, comic_id, page)\n    page = page or 1\n    local cache_key = \"picacg_comments_\" .. comic_id .. \"_\" .. page\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"comics/\" .. comic_id .. \"/comments?page=\" .. page\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取评论失败\" end\n\n    local comments = { comments = {}, total = 0, page = page, pages = 1 }\n    if data.data and type(data.data.comments) == \"table\" then\n        local raw = data.data.comments\n        comments.comments = JN.list(raw.docs)\n        comments.total = JN.num(raw.total, #comments.comments)\n        comments.page = JN.num(raw.page, page)\n        comments.pages = JN.num(raw.pages, 1)\n    end\n\n    cache:cacheData(cache_key, comments, os.time() + CACHE_TTL.COMMENTS)\n    return true, comments\nend\n\n--- 获取某条评论的回复\n-- 端点与请求体格式同 getComments (同样把 page 放查询串)。\nfunction PicacgAPI:getCommentReplies(http_client, headers, auth, comic_id, comment_id, page)\n    page = page or 1\n    local cache_key = \"picacg_comment_replies_\" .. comment_id .. \"_\" .. page\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"comics/\" .. comic_id .. \"/comments/\" .. comment_id .. \"/childrens?page=\" .. page\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取回复失败\" end\n\n    local replies = { replies = {}, total = 0, page = page, pages = 1 }\n    if data.data and type(data.data.comments) == \"table\" then\n        local raw = data.data.comments\n        replies.replies = JN.list(raw.docs)\n        replies.total = JN.num(raw.total, #replies.replies)\n        replies.page = JN.num(raw.page, page)\n        replies.pages = JN.num(raw.pages, 1)\n    end\n\n    cache:cacheData(cache_key, replies, os.time() + CACHE_TTL.COMMENTS)\n    return true, replies\nend\n\n--- 获取网络收藏\nfunction PicacgAPI:getFavorites(http_client, headers, auth, page, sort)\n    page = page or 1\n    sort = sort or \"dd\"\n    local cache_key = \"picacg_favs_\" .. page .. \"_\" .. sort\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"users/favourite?page=\" .. page .. \"&s=\" .. sort\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取收藏失败\" end\n\n    local result = extractComicList(data)\n    if not result then\n        result = { comics = {}, total = 0, page = page, pages = 1 }\n    end\n\n    cache:cacheData(cache_key, result, os.time() + CACHE_TTL.FAVORITES)\n    return true, result\nend\n\n--- 添加收藏\nfunction PicacgAPI:addFavorite(http_client, headers, auth, comic_id)\n    local path = \"comics/\" .. comic_id .. \"/favourite\"\n    local data = self:request(http_client, headers, auth, \"POST\", path, \"{}\")\n    if not data then return false, \"网络请求失败\" end\n    if not isOk(data) then return false, data.message or \"收藏失败\" end\n\n    -- 详情缓存里存着 isFavourite, 不一起作废的话: 加完收藏 -> 退回列表 -> 再进详情,\n    -- 详情页\"问源\"拿到的还是那条**旧缓存**(收藏前建的), 按钮又变回「收藏」。\n    cache:clear(\"picacg_detail_\" .. comic_id)\n    cache:clearPattern(\"picacg_favs_\")\n    return true\nend\n\n--- 取消收藏\nfunction PicacgAPI:removeFavorite(http_client, headers, auth, comic_id)\n    local path = \"comics/\" .. comic_id .. \"/favourite\"\n    local data = self:request(http_client, headers, auth, \"DELETE\", path, \"{}\")\n    if not data then return false, \"网络请求失败\" end\n    if not isOk(data) then return false, data.message or \"取消收藏失败\" end\n\n    -- 同 addFavorite: 详情缓存里的 isFavourite 必须一起作废\n    cache:clear(\"picacg_detail_\" .. comic_id)\n    cache:clearPattern(\"picacg_favs_\")\n    return true\nend\n\n--- 获取排行榜\n-- 服务端对该接口的参数校验很严格 (缺参会返回 validation error):\n--   ct 必填，取值 VC / CC\n--   tt 必填，取值 H24 / D7 / D30\n--   page 不被接受 (一次返回约 40 条，无分页)\n-- @param rank_type: 时间维度 \"H24\"/\"D7\"/\"D30\"\nfunction PicacgAPI:getRanking(http_client, headers, auth, rank_type, page)\n    rank_type = rank_type or \"H24\"\n    local cache_key = \"picacg_rank_\" .. rank_type\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"comics/leaderboard?ct=VC&tt=\" .. rank_type\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取排行榜失败\" end\n\n    local result = extractComicList(data)\n    if not result then\n        result = { comics = {}, total = 0, page = 1, pages = 1 }\n    end\n    -- 该接口无分页\n    result.page = 1\n    result.pages = 1\n\n    cache:cacheData(cache_key, result, os.time() + CACHE_TTL.RANKING)\n    return true, result\nend\n\n--- 获取搜索热词\nfunction PicacgAPI:getSearchKeywords(http_client, headers, auth)\n    local cache_key = \"picacg_keywords\"\n    local cached = cache:getData(cache_key)\n    if cached then return true, cached end\n\n    local path = \"search/leaderboard\"\n    local data = self:request(http_client, headers, auth, \"GET\", path)\n    if not data then return false, nil, \"网络请求失败\" end\n    if not isOk(data) then return false, nil, data.message or \"获取热词失败\" end\n\n    local keywords = {}\n    if data.data and data.data.keywords then\n        keywords = data.data.keywords\n    end\n\n    cache:cacheData(cache_key, keywords, os.time() + CACHE_TTL.CATEGORIES)\n    return true, keywords\nend\n\nreturn PicacgAPI\n","auth.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/picacg/auth.lua\n-- 源 A 认证模块\n-- 从 api/auth.lua 迁移\n\nlocal logger = ctx.logger\nlocal SecretStore = ctx.secrets\nlocal json = ctx.json\n\nlocal PicacgAuth = {}\n\n-- 配置键前缀\nlocal CONFIG_PREFIX = \"source.picacg\"\nlocal TOKEN_KEY = CONFIG_PREFIX .. \".token\"\nlocal USERNAME_KEY = CONFIG_PREFIX .. \".username\"\n\n--- 获取 Token (加密存储; 兼容旧明文的 key)\nfunction PicacgAuth:getToken()\n    local token = SecretStore.get(TOKEN_KEY)\n    if token and token ~= \"\" then\n        return token\n    end\n    -- 兼容旧格式 (\"token\" 明文键由 SecretStore 就地迁移)\n    return SecretStore.get(\"token\")\nend\n\n--- 设置 Token\nfunction PicacgAuth:setToken(token)\n    if token == nil or token == \"\" then\n        SecretStore.clear(TOKEN_KEY)\n        SecretStore.clear(\"token\")\n        return\n    end\n    SecretStore.set(TOKEN_KEY, token)\n    -- 新版本只写一个键; 旧明文键必须清掉, 否则迁移逻辑会再次见到它\n    SecretStore.clear(\"token\")\nend\n\n--- 是否已登录\nfunction PicacgAuth:isLoggedIn()\n    return self:getToken() ~= nil\nend\n\n--- 登录\n-- @param username: 用户名/邮箱\n-- @param password: 密码\n-- @param http_client: HttpClient 实例\n-- @param headers: Headers 模块\n-- @return: true 或 nil, err\nfunction PicacgAuth:login(username, password, http_client, headers)\n    if not username or not password then\n        return nil, \"用户名和密码不能为空\"\n    end\n\n    local body = json.encode({\n        email = username,\n        password = password,\n    })\n\n    local path = \"auth/sign-in\"\n    local url = headers:buildUrl(path)\n    local req_headers = headers:build(path, \"POST\", nil)\n\n    if not req_headers then\n        return nil, \"请求头构造失败\"\n    end\n\n    if logger.enabled then logger.info(\"Picayomi SourceAAuth: 登录请求\") end\n\n    local response, err = http_client:requestWithRetry(\"POST\", url, req_headers, body, 15)\n    if not response then\n        return nil, \"网络请求失败: \" .. tostring(err)\n    end\n\n    local data = http_client:parseJsonResponse(response)\n    if not data then\n        return nil, \"响应解析失败\"\n    end\n\n    if data.code == 200 and data.message == \"success\" then\n        local token = data.data and data.data.token\n        if token and token ~= \"\" then\n            self:setToken(token)\n            -- 账号名也是 PII, 不写明文\n            SecretStore.set(USERNAME_KEY, username)\n            if logger.enabled then logger.info(\"Picayomi SourceAAuth: 登录成功\") end\n            return true\n        end\n    end\n\n    local msg = data.message or \"登录失败\"\n    logger.err(\"Picayomi SourceAAuth: 登录失败: \" .. msg)\n    return nil, msg\nend\n\n--- 退出登录\nfunction PicacgAuth:logout()\n    SecretStore.clear(TOKEN_KEY)\n    SecretStore.clear(\"token\")\n    SecretStore.clear(USERNAME_KEY)\n    if logger.enabled then logger.info(\"Picayomi SourceAAuth: 已退出登录\") end\nend\n\n--- 获取用户信息\nfunction PicacgAuth:getUserProfile(http_client, headers)\n    local token = self:getToken()\n    if not token then\n        return nil, \"未登录\"\n    end\n\n    local path = \"users/profile\"\n    local url = headers:buildUrl(path)\n    local req_headers = headers:build(path, \"GET\", token)\n\n    local response, err = http_client:get(url, req_headers, 10)\n    if not response then\n        return nil, \"网络请求失败: \" .. tostring(err)\n    end\n\n    local data = http_client:parseJsonResponse(response)\n    if not data then\n        return nil, \"响应解析失败\"\n    end\n\n    if data.code == 200 and data.data and data.data.user then\n        local user = data.data.user\n\n        -- 规范化用户资料, 统一各源的 profile 字段\n        local profile = {\n            id = user._id or \"unknown_id\",\n            name = user.name or \"未知用户\",\n            email = user.email or \"\",\n            level = tonumber(user.level) or 1,\n            exp = tonumber(user.exp) or 0,\n            title = user.title or \"\",\n            slogan = user.slogan or \"\",\n            isPunched = user.isPunched or false,\n            character = user.character or \"\",\n        }\n\n        -- 头像地址拼接\n        if user.avatar then\n            if type(user.avatar) == \"table\" and user.avatar.fileServer and user.avatar.path then\n                profile.avatar = user.avatar.fileServer .. \"/static/\" .. user.avatar.path\n            elseif type(user.avatar) == \"string\" then\n                profile.avatar = user.avatar\n            end\n        end\n\n        return profile\n    end\n\n    return nil, data.message or \"获取用户信息失败\"\nend\n\n--- 打卡\nfunction PicacgAuth:punchIn(http_client, headers)\n    local token = self:getToken()\n    if not token then\n        return nil, \"未登录\"\n    end\n\n    local path = \"users/punch-in\"\n    local url = headers:buildUrl(path)\n    local req_headers = headers:build(path, \"POST\", token)\n\n    local response, err = http_client:post(url, req_headers, \"{}\", 10)\n    if not response then\n        return nil, \"网络请求失败: \" .. tostring(err)\n    end\n\n    local data = http_client:parseJsonResponse(response)\n    if data and data.code == 200 then\n        return true\n    end\n\n    return nil, (data and data.message) or \"打卡失败\"\nend\n\nreturn PicacgAuth\n","contract.lua":"-- API v3 projection of this package's existing, independently tested protocol.\n-- Platform state and caches remain private to the implementation.\nlocal V={}\nlocal function identifier(value)\n    assert(type(value)==\"string\" and value~=\"\" or type(value)==\"number\" and value==value and math.abs(value)<math.huge,\"平台标识无效\")\n    return tostring(value)\nend\nfunction V.wrap(ctx,implementation,options)\n    options=options or {}\n    local S={capabilities=implementation.capabilities,access=implementation.access}\n    local order_maps={}\n    local function copy(v)\n        if type(v)==\"userdata\" then return nil end\n        if type(v)~=\"table\" then return v end\n        local out={}; for k,item in pairs(v) do out[k]=copy(item) end; return out\n    end\n    local function failure(err,code)\n        return false,nil,ctx.error(code or \"network\",type(err)==\"string\" and err or \"平台请求失败\",nil,nil,false)\n    end\n    local function fetch(method,...)\n        local was_logged=implementation.isLoggedIn and implementation:isLoggedIn()\n        local called,ok,data,err=pcall(implementation[method],implementation,...)\n        if not called then return failure(\"平台响应结构已变化\",\"protocol_changed\") end\n        if ok~=true then\n            local expired=was_logged and implementation.isLoggedIn and not implementation:isLoggedIn()\n            return failure(err,expired and \"auth_expired\" or \"network\")\n        end\n        return true,data,nil\n    end\n    local function manga(v)\n        return {id=identifier(v._id),title=v.title,cover=v.thumb,author=v.author,description=v.description,\n            tags=copy(v.tags),categories=copy(v.categories),finished=v.finished,favorite=v.isFavourite,\n            updated_at=v.update_time,stats={chapters=v.epsCount,pages=v.pagesCount,likes=v.likesCount,\n                comments=v.commentsCount,views=v.viewsCount},chineseTeam=v.chineseTeam}\n    end\n    local function comment(v)\n        local replies\n        if type(v.replies)==\"table\" then replies={}; for i,r in ipairs(v.replies) do replies[i]=comment(r) end end\n        return {id=identifier(v._id),content=v.content or \"\",author=copy(v.author) or {name=\"未知用户\"},\n            created_at=v.created_at,likesCount=v.likesCount,repliesCount=v.repliesCount,replies=replies}\n    end\n    local function list(method,request,...)\n        request=request or {}\n        local n=select(\"#\",...)\n        local args={...};args[n+1]=request.page or 1;args[n+2]=request.sort;args[n+3]=request.categories\n        local ok,data,err=fetch(method,unpack(args,1,n+3))\n        if not ok then return false,nil,err end\n        local items={};for i,item in ipairs(data.comics) do items[i]=manga(item) end\n        local more=tonumber(data.pages) and (tonumber(data.page) or request.page or 1)<tonumber(data.pages) or data.has_more==true\n        local total=tonumber(data.total)\n        if options.estimated_total and method==\"getComics\" then total=nil end\n        return true,{items=items,has_more=more,next=more and {page=(tonumber(data.page) or request.page or 1)+1} or nil,\n            total=total},nil\n    end\n    function S:init()\n        implementation:init()\n        if options.render then ctx.images.register(\"bands\",{stage=\"render\",module=\"scramble\",fn=\"applyContext\",version=1}) end\n        return true,{success=true},nil\n    end\n    function S:getManga(id)\n        local ok,data,err=fetch(\"getComicDetail\",id)\n        if not ok then return false,nil,err end\n        return true,manga(data),nil\n    end\n    function S:getChapters(id)\n        local episodes,seen,map={},{},{}\n        for page=1,200 do\n            local ok,data,err=fetch(\"getChapters\",id,page)\n            if not ok then return false,nil,err end\n            if type(data)~=\"table\" or type(data.episodes)~=\"table\" then return failure(\"平台章节结构已变化\",\"protocol_changed\") end\n            for _,ch in ipairs(data.episodes) do\n                local chapter_id=identifier(ch._id or options.single_chapter_identity and id)\n                if seen[chapter_id] then return failure(\"平台章节身份重复\",\"protocol_changed\") end\n                seen[chapter_id]=true\n                local order=options.legacy_order and ch.order or \"c_\"..chapter_id\n                map[chapter_id]=order\n                episodes[#episodes+1]={id=chapter_id,manga_id=id,title=ch.title,\n                    legacy_order=options.legacy_order and ch.order or nil,page_count=ch.pagesCount}\n                if #episodes>20000 then return failure(\"章节数量超过限额\",\"resource_limit\") end\n            end\n            if page>=(tonumber(data.pages) or 1) then\n                if options.legacy_order then table.sort(episodes,function(a,b) return (tonumber(a.legacy_order) or 0)<(tonumber(b.legacy_order) or 0) end) end\n                order_maps[id]=map\n                return true,{items=episodes,has_more=false,total=#episodes},nil\n            end\n        end\n        return failure(\"章节分页超过限额\",\"resource_limit\")\n    end\n    function S:getPages(id,chapter_id)\n        if not (order_maps[id] and order_maps[id][chapter_id]) then\n            local ok,_,err=self:getChapters(id);if not ok then return false,nil,err end\n        end\n        local order=order_maps[id] and order_maps[id][chapter_id]\n        if order==nil then return failure(\"章节不存在\",\"not_found\") end\n        local ok,data,err=fetch(\"getAllChapterImages\",id,order)\n        if not ok then return false,nil,err end\n        local pages={}\n        for i,image in ipairs(data.images) do\n            local url=type(image)==\"table\" and image.url or image\n            local context,processors\n            if options.render then\n                local bands=ctx.require(\"scramble\").countForUrl(url)\n                if bands>0 then context={bands=bands};processors={render={name=\"bands\",version=1}} end\n            end\n            pages[i]={index=i,resource={url=url},context=context,processors=processors}\n        end\n        return true,{items=pages,complete=true},nil\n    end\n    function S:getImageRequest(resource)\n        local headers,err=implementation:imageHeaders(resource.url)\n        if type(headers)~=\"table\" then return failure(err) end\n        local values={};for k,v in pairs(headers) do values[k]=type(v)==\"number\" and tostring(v) or v end\n        return ctx.imageRequest(resource,values)\n    end\n    function S:getLatest(request) return list(\"getComics\",request) end\n    function S:getRecommendations(request) return list(\"getRecommendations\",request) end\n    function S:search(keyword,request) return list(\"search\",request,keyword) end\n    function S:getCategoryComics(id,request) return list(\"getCategoryComics\",request,id) end\n    function S:getRankings(id,request) return list(\"getRankings\",request,id) end\n    function S:getFavorites(request) return list(\"getFavorites\",request) end\n    function S:getRandom(request) return list(\"getRandom\",request) end\n    function S:getCategories()\n        local ok,data,err=fetch(\"getCategories\")\n        if not ok then return false,nil,err end\n        local items={}; for i,item in ipairs(data) do items[i]={id=tostring(item._id or item.title),title=item.title,isWeb=item.isWeb,link=item.link} end\n        return true,items,nil\n    end\n    function S:getRankingTypes()\n        local items=implementation:getRankingTypes()\n        return true,copy(items),nil\n    end\n    function S:getSortOptions(kind)\n        local items={};for i,item in ipairs(implementation:getSortOptions(kind)) do items[i]={id=item.value,title=item.text} end\n        return true,items,nil\n    end\n    function S:getSession() return true,{logged_in=implementation:isLoggedIn()},nil end\n    function S:getCredential() return true,{token=implementation:getToken()},nil end\n    function S:setCredential(token)\n        if not implementation.setToken then return failure(\"当前源不支持导入会话\",\"unsupported\") end\n        implementation:setToken(token);return true,{success=true},nil\n    end\n    function S:login(...)\n        local ok,err=implementation:login(...)\n        if not ok then return failure(err) end\n        return true,{success=true},nil\n    end\n    function S:logout() implementation:logout();return true,{success=true},nil end\n    function S:getUserProfile()\n        local was_logged=implementation:isLoggedIn()\n        local data,err=implementation:getUserProfile()\n        if not data then\n            local logged=implementation:isLoggedIn()\n            return failure(err,was_logged and not logged and \"auth_expired\" or logged and \"network\" or \"auth_required\")\n        end\n        return true,copy(data),nil\n    end\n    for _,method in ipairs({\"addFavorite\",\"removeFavorite\",\"punchIn\"}) do\n        S[method]=function(_,...)\n            if type(implementation[method])~=\"function\" then return failure(\"当前源不支持此功能\",\"unsupported\") end\n            local ok,err=implementation[method](implementation,...)\n            if not ok then return failure(err) end\n            return true,{success=true},nil\n        end\n    end\n    for method,key in pairs({getComments=\"comments\",getCommentReplies=\"replies\"}) do\n        S[method]=function(_,id,comment_id,request)\n            if key==\"comments\" then request,comment_id=comment_id,nil end\n            local ok,data,err\n            if key==\"comments\" then ok,data,err=fetch(method,id,(request or {}).page or 1)\n            else ok,data,err=fetch(method,id,comment_id,(request or {}).page or 1) end\n            if not ok then return false,nil,err end\n            local items={};for i,item in ipairs(data[key]) do items[i]=comment(item) end\n            local page=tonumber(data.page) or 1;local more=page<(tonumber(data.pages) or 1)\n            return true,{items=items,has_more=more,next=more and {page=page+1} or nil,total=tonumber(data.total)},nil\n        end\n    end\n    return S\nend\nreturn V\n","headers.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/picacg/headers.lua\n-- 内置源 A 的请求头与签名\n-- 签名逻辑集中在这里，其他模块不要各自拼请求头。\n\nlocal logger = ctx.logger\nlocal hmac = ctx.hmac\nlocal config = ctx.config\n\nlocal Headers = {}\n\n-- API 常量\n-- 只有 HTTPS: 源码里不再保留 http:// 基址, 从结构上禁止\"失败就降级到明文\"。\nHeaders.API_BASE_URL = \"https://picaapi.picacomic.com/\"\nHeaders.API_KEY  = \"C69BAF41DA5ABD1FFEDC6D2FEA56B\"\nHeaders.SECRET_KEY = \"~d}$Q7$eIni=V)9\\\\RK/P.RM4;9[7|@/CA}b~OW!3?EV`:<>M7pddUBL5n|0/*Cn\"\n\n-- 默认请求头值\nHeaders.DEFAULT_HEADERS = {\n    [\"accept\"]            = \"application/vnd.picacomic.com.v1+json\",\n    [\"app-channel\"]       = \"2\",\n    [\"app-version\"]      = \"2.2.1.2.3.3\",\n    [\"app-uuid\"]          = \"defaultUuid\",\n    [\"app-platform\"]     = \"android\",\n    [\"app-build-version\"] = \"44\",\n    [\"Content-Type\"]      = \"application/json; charset=UTF-8\",\n    [\"User-Agent\"]        = \"okhttp/3.8.1\",\n    [\"image-quality\"]     = \"original\",\n}\n\n--- 生成签名\n-- @param path: API 路径 (不含前导斜杠，如 \"auth/sign-in\")\n-- @param ts: 字符串时间戳\n-- @param method: HTTP 方法 (将被转为小写，如 \"GET\" → \"get\")\n-- @param nonce: 随机 nonce 字符串\n-- @return: hex 签名字符串\nfunction Headers:generateSignature(path, ts, method, nonce)\n    -- 确保 path 不含前导斜杠\n    if path:sub(1, 1) == \"/\" then\n        path = path:sub(2)\n    end\n\n    -- 构造签名字符串: path + timestamp + nonce + method + api_key\n    local raw = path .. ts .. nonce .. string.lower(method) .. self.API_KEY\n    raw = string.lower(raw)\n\n    local signature = hmac.hmac_sha256_hex(self.SECRET_KEY, raw)\n    if not signature then\n        logger.err(\"Picayomi SourceAHeaders: HMAC签名生成失败\")\n        return nil\n    end\n\n    return signature\nend\n\n--- 构造完整请求头\n-- @param path: API 路径 (不含前导斜杠)\n-- @param method: HTTP 方法 (\"GET\"/\"POST\"/...)\n-- @param token: 可选，用户 token\n-- @return: headers 表\nfunction Headers:build(path, method, token)\n    -- 规范化 path\n    if path:sub(1, 1) == \"/\" then\n        path = path:sub(2)\n    end\n\n    local ts = tostring(os.time())\n    local nonce = \"b1ab87b4800d4d4590a11701b8551afa\"\n    local signature = self:generateSignature(path, ts, method, nonce)\n    if not signature then\n        return nil\n    end\n\n    -- 复制默认头\n    local headers = {}\n    for k, v in pairs(self.DEFAULT_HEADERS) do\n        headers[k] = v\n    end\n\n    -- 添加签名相关头\n    headers[\"api-key\"]    = self.API_KEY\n    headers[\"time\"]       = ts\n    headers[\"nonce\"]      = nonce\n    headers[\"signature\"] = signature\n\n    -- 图片质量\n    --\n    -- 只认 \"original\" / \"low\" 两个值。旧实现直接把设置项写进来 (low/medium/high),\n    -- 而源 A 只认识 original/low —— \"high\" 落进服务端默认分支, 表现就是\n    -- \"选了高清反而更糊\" (真机 2026-10-18)。\n    --\n    -- 注意这个头对**图床**其实无效 (实测同一 URL 带 original/high/low 返回的\n    -- 字节完全相同); 真正决定清晰度的是 media.path 里那个 图片代理 地址 ——\n    -- 见 source/picacg/api.lua 的 originalImageUrl。这里保留正确的取值, 免得\n    -- 哪天服务端开始校验它时又踩一遍。\n    headers[\"image-quality\"] = (config:get(\"image_quality\") == \"low\") and \"low\" or \"original\"\n\n    -- Token\n    if token and token ~= \"\" then\n        headers[\"authorization\"] = token\n    end\n\n    return headers\nend\n\n--- 构造完整 URL (始终 HTTPS)\n-- 曾经允许传 use_https=false 走明文; 那实际上是降级逻辑的入口。现在固定 HTTPS。\n-- @param path: API 路径 (如 \"auth/sign-in\" 或完整 URL)\n-- @return: 完整 URL\nfunction Headers:buildUrl(path)\n    -- 完整 URL 直接返回 (但拒绝明文: 调用方不应把 http:// 传进来)\n    if path:match(\"^https://\") then\n        return path\n    end\n    if path:match(\"^http://\") then\n        logger.warn(\"Picayomi SourceAHeaders: 拒绝明文 API 地址\")\n        return nil\n    end\n\n    -- 规范化 path\n    if path:sub(1, 1) == \"/\" then\n        path = path:sub(2)\n    end\n\n    local base = ctx.getSetting(\"base_url\", self.API_BASE_URL):gsub(\"/+$\", \"\")\n    assert(base:match(\"^https://[%w%.%-]+$\"), \"API 地址必须为 HTTPS 域名\")\n    return base .. \"/\" .. path\nend\n\nreturn Headers\n","init.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/picacg/init.lua\n-- 源 A 源入口\n-- 实现 ComicSource 基类接口\n\nlocal logger = ctx.logger\nlocal ComicSource = require(\"object\")\nlocal PicacgAuth = require(\"auth\")\nlocal PicacgAPI = require(\"api\")\nlocal Headers = require(\"headers\")\nlocal HttpClient = ctx.http\nlocal FavoritesUtil = {markAll=function(data) for _,comic in ipairs(data.comics or {}) do comic.isFavourite=true end end}\n\nlocal PicacgSource = ComicSource:extend{\n    name = \"哔咔漫画\",\n    identifier = \"picacg\",\n    version = \"1.0.0\",\n\n    capabilities = {\n        login = true,\n        requires_login = true,\n        search = true,\n        latest = true,\n        categories = true,\n        rankings = true,\n        random = true,\n        favorites = true,\n        comments = true,\n        replies = \"paged\",\n        download = true,\n        local_favorites = true,\n    },\n}\n\n--- 初始化\nfunction PicacgSource:init()\n    -- 懒加载: 只在实际使用时创建实例\n    self._http_client = HttpClient\n    self._headers = Headers\n    self._auth = PicacgAuth\n    self._api = PicacgAPI\nend\n\n--- 确保已初始化\nfunction PicacgSource:_ensureInit()\n    if not self._http_client then\n        self:init()\n    end\nend\n\n-- ==================== 认证 ====================\n\nfunction PicacgSource:login(username, password)\n    self:_ensureInit()\n    return self._auth:login(username, password, self._http_client, self._headers)\nend\n\nfunction PicacgSource:getToken()\n    return PicacgAuth:getToken()\nend\n\nfunction PicacgSource:isLoggedIn()\n    return PicacgAuth:isLoggedIn()\nend\n\nfunction PicacgSource:logout()\n    PicacgAuth:logout()\nend\n\nfunction PicacgSource:getUserProfile()\n    self:_ensureInit()\n    return self._auth:getUserProfile(self._http_client, self._headers)\nend\n\nfunction PicacgSource:punchIn()\n    self:_ensureInit()\n    return self._auth:punchIn(self._http_client, self._headers)\nend\n\n-- ==================== 漫画浏览 ====================\n\nfunction PicacgSource:getCategories()\n    self:_ensureInit()\n    return self._api:getCategories(self._http_client, self._headers, self._auth)\nend\n\nfunction PicacgSource:getCategoryComics(category, page, sort)\n    self:_ensureInit()\n    return self._api:getCategoryComics(self._http_client, self._headers, self._auth,\n        category, page, sort)\nend\n\nfunction PicacgSource:search(keyword, page, sort, categories)\n    self:_ensureInit()\n    return self._api:search(self._http_client, self._headers, self._auth,\n        keyword, page, sort, categories)\nend\n\nfunction PicacgSource:getRandom(page)\n    self:_ensureInit()\n    return self._api:getRandom(self._http_client, self._headers, self._auth, page)\nend\n\n--- 源 A 的排序能力\n-- 推荐/分类/搜索走的是同一套 s= 取值, 所以三类都支持 (实测接口带 s= 生效)\nfunction PicacgSource:getSortOptions(_list_kind)\n    -- 取值语义已用真实接口实测确认 (对比漫画 id 前缀 —— 源 A id 前缀即 ObjectId 时间戳):\n    --   dd -> 新到旧(按发布时间)     da -> 旧到新\n    --   ua -> 最近更新               ld / vd -> 爱心 / 指名数\n    -- 此前把 ua 标成\"新到旧\"、dd 标成\"旧到新\", **正好写反了** ——\n    -- 用户选\"旧到新\"反而看到最新的作品。\n    return {\n        { value = \"dd\", text = \"新到旧\" },\n        { value = \"da\", text = \"旧到新\" },\n        { value = \"ua\", text = \"最近更新\" },\n        { value = \"ld\", text = \"最多爱心\" },\n        { value = \"vd\", text = \"最多绅士指名\" },\n    }\nend\n\nfunction PicacgSource:getLatest(page, sort) return self:getComics(page, sort) end\n\nfunction PicacgSource:getRankingTypes()\n    return { {id=\"H24\",title=\"24小时热门\"}, {id=\"D7\",title=\"7天热门\"}, {id=\"D30\",title=\"30天热门\"} }\nend\n\nfunction PicacgSource:getComics(page, sort)\n    self:_ensureInit()\n    return self._api:getComics(self._http_client, self._headers, self._auth, page, sort)\nend\n\nfunction PicacgSource:getComicDetail(comic_id)\n    self:_ensureInit()\n    return self._api:getComicDetail(self._http_client, self._headers, self._auth, comic_id)\nend\n\nfunction PicacgSource:getChapters(comic_id, page)\n    self:_ensureInit()\n    return self._api:getEpisodes(self._http_client, self._headers, self._auth, comic_id, page)\nend\n\nfunction PicacgSource:getChapterImages(comic_id, chapter_order, page)\n    self:_ensureInit()\n    return self._api:getEpisodeImages(self._http_client, self._headers, self._auth,\n        comic_id, chapter_order, page)\nend\n\nfunction PicacgSource:getAllChapterImages(comic_id, chapter_order)\n    self:_ensureInit()\n    return self._api:getAllEpisodeImages(self._http_client, self._headers, self._auth,\n        comic_id, chapter_order)\nend\n\nfunction PicacgSource:getRankings(rank_type, page)\n    self:_ensureInit()\n    return self._api:getRanking(self._http_client, self._headers, self._auth,\n        rank_type, page)\nend\n\nfunction PicacgSource:getSearchKeywords()\n    self:_ensureInit()\n    return self._api:getSearchKeywords(self._http_client, self._headers, self._auth)\nend\n\n-- ==================== 收藏 ====================\n\nfunction PicacgSource:getFavorites(page, sort)\n    self:_ensureInit()\n    local ok, data, err = self._api:getFavorites(self._http_client, self._headers,\n        self._auth, page, sort)\n    FavoritesUtil.markAll(data)\n    return ok, data, err\nend\n\n--- 加入收藏 / 取消收藏: 源 A 的端点本身就是明确的增/删, 直接转发\nfunction PicacgSource:addFavorite(comic_id)\n    self:_ensureInit()\n    return self._api:addFavorite(self._http_client, self._headers, self._auth, comic_id)\nend\n\nfunction PicacgSource:removeFavorite(comic_id)\n    self:_ensureInit()\n    return self._api:removeFavorite(self._http_client, self._headers, self._auth, comic_id)\nend\n\nfunction PicacgSource:toggleFavorite(comic_id)\n    self:_ensureInit()\n    -- 先查当前状态\n    local ok, detail = self._api:getComicDetail(self._http_client, self._headers,\n        self._auth, comic_id)\n    if ok and detail and detail.isFavourite then\n        return self._api:removeFavorite(self._http_client, self._headers, self._auth, comic_id)\n    else\n        return self._api:addFavorite(self._http_client, self._headers, self._auth, comic_id)\n    end\nend\n\nfunction PicacgSource:setToken(token)\n    return PicacgAuth:setToken(token)\nend\n\nfunction PicacgSource:legacyProfile()\n    return ctx.secrets.get_json(\"profile\")\nend\n\n-- ==================== 评论 ====================\n\n-- 契约统一为 (ok, data, err) —— 与其余取数方法一致 (旧的裸实现返回 (data, err))。\nfunction PicacgSource:getComments(comic_id, page)\n    self:_ensureInit()\n    return self._api:getComments(self._http_client, self._headers, self._auth,\n        comic_id, page)\nend\n\nfunction PicacgSource:getCommentReplies(comic_id, comment_id, page)\n    self:_ensureInit()\n    return self._api:getCommentReplies(self._http_client, self._headers, self._auth,\n        comic_id, comment_id, page)\nend\n\n-- ==================== 图片下载 ====================\n\n--- 图片请求头\n--\n-- 源 A 的签名含 `ts=os.time()` 与\"由图片 URL 推出的 path\", 所以**每次都要现算**。\n-- 单独抽出来是为了让 fork 出来的下载 worker 也能拿到当下正确的头:\n-- 子进程是父进程的快照, 登录 token 刷新后子进程里还是旧值 —— 由父进程在发起那一刻\n-- 现算并随任务下发, 就不存在过期问题 (见 source/base.lua 的 imageHeaders 说明)。\n-- @return headers 表 或 nil, err\nfunction PicacgSource:imageHeaders(url)\n    self:_ensureInit()\n    local token = self._auth:getToken()\n    local req_headers = self._headers:build(url, \"GET\", token)\n    if not req_headers then\n        return nil, \"请求头构造失败\"\n    end\n    req_headers[\"Connection\"] = \"close\"\n    req_headers[\"Accept-Encoding\"] = \"identity\"\n    return req_headers\nend\n\n--- 下载单张图片\nfunction PicacgSource:downloadImage(url, dest_path, timeout)\n    local req_headers, err = self:imageHeaders(url)\n    if not req_headers then\n        return nil, err\n    end\n    -- 超时保持较短: 下载是同步的, 超时越长界面冻结越久\n    return self._http_client:download(url, dest_path, req_headers, timeout or 15)\nend\n\nreturn PicacgSource\n","main.lua":"return function(ctx)\n    return ctx.require(\"contract\").wrap(ctx,ctx.require(\"init\"),{legacy_order=true})\nend\n","object.lua":"-- Private adapter helper, not a host base class or a public source contract.\nlocal O={}\nfunction O:extend(child) return setmetatable(child,{__index=self}) end\nfunction O:hasCapability(name) return self.capabilities[name]==true end\nfunction O:init() end\nfunction O:getToken() return nil end\nfunction O:isLoggedIn() return self:getToken()~=nil end\nfunction O:getSortOptions() return {} end\nfunction O:isCachedImageStale() return false end\nreturn O\n"},"format":1,"manifest":{"api_version":3,"author":"PicaYomi source maintainers","cache_schema_version":1,"data_schema_version":1,"entry":"main.lua","id":"picacg","identity_policy":"legacy","min_app_version":"0.11.2","name":"哔咔漫画","publisher_id":"picayomi.legacy","settings":[{"default":"https://picaapi.picacomic.com","key":"base_url","title":"API 地址"}],"version":"1.1.1"}}