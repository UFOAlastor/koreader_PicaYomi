{"files":{"api.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/htcomic/api.lua\n-- 内置源 C 的页面解析与取数\n--\n-- 该源以 HTML 页面为主，数据靠 KOReader 自带的 htmlparser (CSS 选择器) 解析。\n-- 页面结构、选择器与分页规则都封装在本文件的 parse* 函数里；外部只依赖\n-- 归一化后的数据结构，不要直接读 HTML 节点。\n--\n-- 约定:\n--   * 列表、分类、搜索、详情、章节各自有独立的解析函数；\n--   * 解析失败返回 nil + 可展示的原因，不要返回半成品；\n--   * 页面结构变化时只改对应解析函数，保持对外字段不变。\n\nlocal logger = ctx.logger\nlocal cache = ctx.cache\nlocal _ = ctx.translate\nlocal Headers = require(\"headers\")\n\n-- htmlparser 默认循环上限较低, 大页面会被截断, 必须提高 (parse 时读取该全局量)\nhtmlparser_opts = { looplimit = 2000000, silent = true }\nlocal htmlparser = ctx.html\n\nlocal HtAPI = {}\n\nHtAPI.BASE_URL = Headers.BASE_URL\n\n--- 分类缓存的键与时长\n--\n-- 分类导航是站点级的 (每个页面都一样), 一天一次足够。不缓存的话每次进「分类浏览」\n-- 都要多花一个 RTT —— 而它现在是一个真实网络请求了 (见 parseCategories 的说明)。\nlocal CATEGORIES_CACHE_KEY = \"htcomic_categories\"\nlocal CATEGORIES_CACHE_TTL = 86400\n\n-- ============================================================================\n-- 工具\n-- ============================================================================\n\n--- 剥标签 + 解 HTML 实体\n--\n-- 单独抽出来是因为**属性值里也有实体**: 列表项的标题优先取 `a[title]`\n-- (比 textonly 干净, 不受内部 <em> 影响), 但那是原始属性值, 不解的话\n-- 菜单里会显示成 \"[Aster C]&nbsp;&nbsp;ショタ勇者\"。\nlocal function unescape(t)\n    t = tostring(t or \"\")\n    t = t:gsub(\"<[^>]*>\", \"\")\n    t = t:gsub(\"&amp;\", \"&\"):gsub(\"&lt;\", \"<\"):gsub(\"&gt;\", \">\")\n        :gsub(\"&quot;\", '\"'):gsub(\"&#39;\", \"'\"):gsub(\"&nbsp;\", \" \")\n    return (t:gsub(\"^%s+\", \"\"):gsub(\"%s+$\", \"\"))\nend\n\n--- 读取节点纯文本 (剥标签与实体)\nlocal function node_text(node)\n    if not node then return \"\" end\n    local t\n    local ok = pcall(function() t = node:textonly() end)\n    if not ok or not t or t == \"\" then\n        pcall(function() t = node:gettext() end)\n    end\n    return unescape(t)\nend\n\nlocal function parse_html(html)\n    if not html or html == \"\" then return nil end\n    local ok, doc = pcall(htmlparser.parse, html)\n    if not ok or not doc then\n        logger.err(\"Picayomi HtAPI: HTML 解析失败: \" .. tostring(doc))\n        return nil\n    end\n    return doc\nend\n\n--- URL 编码 (站点是 UTF-8, 按字节百分号编码即可)\nlocal function urlencode(s)\n    return (tostring(s or \"\"):gsub(\"([^%w%-_%.~])\", function(c)\n        return string.format(\"%%%02X\", string.byte(c))\n    end))\nend\n\n--- 发起 GET 请求并返回响应体\nlocal function http_get(http_client, url, timeout)\n    local h = Headers:build(url)\n    local resp, err = http_client:get(url, h, timeout or 20)\n    if not resp then\n        return nil, \"网络请求失败: \" .. tostring(err)\n    end\n    if resp.status_code and resp.status_code >= 400 then\n        return nil, \"HTTP \" .. tostring(resp.status_code)\n    end\n    return tostring(resp.body or \"\")\nend\n\n--- 列表页的 URL (第 N 页)\n-- 实测: /albums.html -> /albums-index-page-2.html\n--       /albums-index-cate-5.html -> /albums-index-page-2-cate-5.html\nfunction HtAPI.listUrl(id, page)\n    page = tonumber(page) or 1\n    if page <= 1 then\n        return \"/\" .. tostring(id):gsub(\"^/\", \"\") .. \".html\"\n    end\n    local cate = tostring(id):match(\"cate%-(%d+)\")\n    if cate then\n        return \"/albums-index-page-\" .. page .. \"-cate-\" .. cate .. \".html\"\n    end\n    return \"/albums-index-page-\" .. page .. \".html\"\nend\n\n--- 从封面地址取缩略图 (列表页给的是协议相对地址)\nlocal function normalize_thumb(src)\n    return Headers:normalizeImageUrl(src)\nend\n\n-- ============================================================================\n-- 分类\n-- ============================================================================\n\n--- 这个节点所属的**顶层菜单名** (向上找到最近的 li, 取其中第一个链接的文字)\n--\n-- 站点的导航是 `<ul><li><a>同人誌</a><div class=\"drop_dwon\">…子类…</div></li>…`,\n-- 父与子用的是同一个 class (onemenulayout), 只能靠\"祖上是谁\"来分组。\nlocal function top_level_name(node)\n    local p = node and node.parent\n    while p do\n        if p.name == \"li\" then\n            local top = p:select(\"a\")[1]\n            local t = top and node_text(top)\n            return (t ~= \"\" and t) or nil\n        end\n        p = p.parent\n    end\n    return nil\nend\n\n--- 从任一页面里解析分类导航\n--\n-- **不硬编码分类表**。旧实现写死了 9 个, 而站点实际有 20 个 —— 少了\n-- 日語/English/其他/3D漫畫/AI圖集/合集 等整类, 用户根本进不去。\n--\n-- 命名规则: 站点的子类名在多个父类下**重复** (四个「漢化」、三个「日語」、\n-- 三个「English」), 直接列出来分不清是哪个父类下的。所以**只在真的重名时**\n-- 才把顶层菜单名拼进去 (\"單行本 · 漢化\"); 名字唯一的 (CG畫集 / Cosplay / 合集…)\n-- 保持原样 —— 站点把 CG畫集/AI圖集/3D漫畫/Cosplay 也塞在同人誌那个下拉里,\n-- 无差别加前缀会得到\"同人誌 · CG畫集\"这种误导性的名字。\n--\n-- 分类用**站点路径**标识 (不是接口参数), 例如 albums-index-cate-5。\n--\n-- @return { { _id = <路径名>, title = <显示名> }, ... } 或 nil\nfunction HtAPI.parseCategories(html)\n    local doc = parse_html(html)\n    if not doc then return nil end\n\n    -- 作用域限定在导航里 (`ul#album_tabs`): 页面别处也有指向分类的链接\n    -- (页脚/推荐位), 不限定的话同一个分类会出现两次。\n    -- 注意 htmlparser 的 select **不支持逗号列表**, 只能用后代选择器一次拿全:\n    -- 顶层 `<a>` 是 li 的直接子元素, 子类是 li > drop_dwon > onemenulayout 里的 a,\n    -- 两者都被 \"ul#album_tabs a\" 覆盖。\n    local SELECTOR = \"ul#album_tabs a\"\n\n    -- 第一遍: 收集 + 数重名\n    local found, name_count = {}, {}\n    for _i, a in ipairs(doc:select(SELECTOR)) do\n        local href = a.attributes and a.attributes.href or \"\"\n        local cate = href:match(\"^/albums%-index%-cate%-(%d+)%.html$\")\n        local name = node_text(a)\n        if cate and name ~= \"\" and not found[\"albums-index-cate-\" .. cate] then\n            found[\"albums-index-cate-\" .. cate] = { name = name, group = top_level_name(a) }\n            name_count[name] = (name_count[name] or 0) + 1\n        end\n    end\n\n    -- 更新 (/albums.html) 不在分类下拉里, 但它是\"最新\"入口, 一并列出来\n    local cats = { { _id = \"albums\", title = \"最新\" } }\n\n    -- 第二遍: 按文档序产出 (select 的结果已按 index 排序)\n    for _i, a in ipairs(doc:select(SELECTOR)) do\n        local href = a.attributes and a.attributes.href or \"\"\n        local cate = href:match(\"^/albums%-index%-cate%-(%d+)%.html$\")\n        local name = node_text(a)\n        if cate and name ~= \"\" then\n            local id = \"albums-index-cate-\" .. cate\n            local rec = found[id]\n            if rec then\n                found[id] = nil -- 去重: 同一个分类只出一次\n                local title = name\n                if name_count[name] > 1 and rec.group then\n                    title = rec.group .. \" · \" .. name\n                end\n                table.insert(cats, { _id = id, title = title })\n            end\n        end\n    end\n\n    -- 一个分类都没解析出来 => 页面结构变了, 别把\"只剩最新\"当成正常结果交上去\n    if #cats <= 1 then\n        logger.warn(\"Picayomi HtAPI: 分类导航未解析到任何分类\")\n        return nil\n    end\n    return cats\nend\n\n--- 取分类列表 (带缓存; 站点导航每个页面都一样, 取一页就够)\nfunction HtAPI:getCategories(http_client)\n    local cached = cache:getData(CATEGORIES_CACHE_KEY)\n    if cached then return true, cached end\n\n    local html, err = http_get(http_client, Headers:buildUrl(\"/albums.html\"))\n    if not html then\n        return false, nil, err\n    end\n    local cats = self.parseCategories(html)\n    if not cats then\n        return false, nil, \"未解析到分类 (页面结构可能已变化)\"\n    end\n    cache:cacheData(CATEGORIES_CACHE_KEY, cats, os.time() + CATEGORIES_CACHE_TTL)\n    return true, cats\nend\n\n-- ============================================================================\n-- 列表\n-- ============================================================================\n\n--- 列表页的总页数 (取分页器里出现的**最大页码**)\n--\n-- 两个坑:\n--   1. **不能取\"最后一个链接\"**。分页器末尾是「後頁>」, 它的文字里没有数字 ——\n--      旧实现 `node_text(plinks[#plinks]):match(\"(%d+)\")` 于是永远拿不到页码,\n--      pages 停在 1, 列表卡在第一页翻不动。用户看到的就是\n--      \"单行本-汉化不可能才 24 项目\" (页脚只显示\"已加载 24 项\")。\n--   2. 页码要从 **href** 里取, 不是链接文字 —— 文字可能是「後頁」/「末頁」/「Next」。\n--\n-- 站点两类分页器的地址不同, 都要认:\n--   列表/分类: /albums-index-page-694-cate-9.html\n--   搜索:      /search/index.php?q=…&p=694&…\nlocal function parse_last_page(doc, selector)\n    local max_page = 1\n    for _i, a in ipairs(doc:select(selector)) do\n        local href = a.attributes and a.attributes.href or \"\"\n        local n = tonumber(href:match(\"page%-(%d+)\"))\n            or tonumber(href:match(\"[?&]p=(%d+)\"))\n        if n and n > max_page then max_page = n end\n    end\n    return max_page\nend\n\n--- 解析列表页 -> { comics = {...}, pages = N }\nfunction HtAPI.parseComicList(html)\n    local doc = parse_html(html)\n    if not doc then\n        return nil, \"页面解析失败\"\n    end\n\n    local comics = {}\n    for _i, li in ipairs(doc:select(\"div.gallary_wrap > ul.cc > li\")) do\n        local a = li:select(\"div.pic_box a\")[1]\n        local href = a and a.attributes and a.attributes.href\n        local id = href and href:match(\"aid%-(%d+)\")\n        if id then\n            local img = li:select(\"div.pic_box img\")[1]\n            local src = img and img.attributes and\n                (img.attributes.src or img.attributes[\"data-src\"])\n            local ta = li:select(\"div.info div.title a\")[1]\n            local title = \"\"\n            if ta then\n                -- 优先 title 属性 (比 textonly 干净, 不受内部 <em> 影响), 但它不解实体\n                local attr = ta.attributes and ta.attributes.title\n                title = attr and unescape(attr) or node_text(ta)\n            end\n            title = title:gsub(\"<em>\", \"\"):gsub(\"</em>\", \"\")\n            if title == \"\" then\n                title = \"作品 \" .. id\n            end\n\n            local info = node_text(li:select(\"div.info div.info_col\")[1])\n            -- 列表项的 info_col 只有一句统计, 既没有作者也没有分类 —— 以前把它整个\n            -- 塞进 categories, 详情页的分类行就成了那段页面文案 (真机反馈)。\n            -- 作者/分类只有详情页才有, 由详情页打开时补 (见 ComicDetail:syncFromSource)。\n            --\n            -- 这句统计有**两种形态**, 对应两种作品:\n            --   单本: \"25張圖片，創建於2026-10-17\"\n            --   合集: \"11話，更新於2026-10-18 公開漫畫\"   <- 没有单一页数\n            -- 旧实现只认第一种, 合集于是页数恒为 0, 卡片上什么都不显示\n            -- (真机反馈: \"有些漫画显示页数, 有些不显示\")。合集显示章节数更有意义,\n            -- 卡片本来就支持 epsCount -> \"11话\"。\n            local pages = tonumber(info:match(\"(%d+)%s*張\"))\n                or tonumber(info:match(\"(%d+)%s*[Pp]\")) or 0\n            local episodes = tonumber(info:match(\"(%d+)%s*[話话]\"))\n            if episodes then pages = 0 end\n            -- 列表项既没有作者也没有分类 (只有详情页有)。卡片第二行空着会与\n            -- 源 A/源 B 的卡片长得不一样; 这里把 info_col 里的日期拿出来补位\n            -- (\"創建於2026-10-17\" / \"更新於2026-10-18\")。\n            local date = info:match(\"(%d%d%d%d%-%d%d%-%d%d)\")\n\n            table.insert(comics, {\n                _id = id,\n                title = title,\n                author = \"\",\n                categories = nil,\n                description = \"\",\n                thumb = normalize_thumb(src),\n                pagesCount = pages,\n                epsCount = episodes or 0,\n                update_time = date,\n            })\n        end\n    end\n\n    -- 总页数: 分页器里最大的页码 (见 parse_last_page)\n    local page = tonumber(node_text(doc:select(\"div.f_left.paginator span.thispage\")[1]))\n    local pages = math.max(page or 1, parse_last_page(doc, \"div.f_left.paginator a\"))\n\n    return { comics = comics, pages = pages, page = page }\nend\n\n-- List/category/ranking pages expose the last page, but no item count. Count\n-- only the last page, never multiply its capacity into a fabricated exact total.\nlocal function add_list_total(http_client, data, page, first_url, last_url)\n    local pages = tonumber(data.pages)\n    if not pages or pages < page or #data.comics > 20 then return end\n    local key = \"htcomic:list_total:v1:\" .. first_url\n    local minimum = (page - 1) * 20 + #data.comics\n    if page == pages and (#data.comics > 0 or page == 1) then\n        data.total = minimum\n        cache:cacheData(key, { pages = pages, total = minimum }, os.time() + 300)\n        return\n    end\n    local saved = cache:getData(key)\n    if saved and saved.pages == pages then\n        if saved.total == nil then return end -- Failed optional lookup: short cooldown.\n        if saved.total >= minimum then data.total = saved.total; return end\n    end\n    -- One bounded request; a failed count must not hide the main list. Cache\n    -- failures briefly so every subsequent screen does not repeat the lookup.\n    local html = http_get(http_client, last_url, 5)\n    local last = html and HtAPI.parseComicList(html)\n    if last and last.page == pages and last.pages == pages\n        and #last.comics > 0 and #last.comics <= 20 then\n        local total = (pages - 1) * 20 + #last.comics\n        if total >= minimum then data.total = total end\n    end\n    cache:cacheData(key, { pages = pages, total = data.total }, os.time() + (data.total and 300 or 60))\nend\n\n--- 取某一类/某一页的列表 (id 取 parseCategories 给出的 _id, 即站点路径名)\n--\n-- 关于排序: 站点列表页的\"排序\"菜单只做一件事 —— 把偏好写进 Cookie\n-- Mpic_sortset_album 再 reload (statics/js/common.js 的 sort_setting)。\n-- 实测带该 Cookie 直接请求, 返回顺序**完全不变** (换 Cookie 名/加 URL 参数/\n-- 绕缓存都试过), 服务端并没有按它排。所以这里不提供排序, 免得放一个点了\n-- 没反应的按钮。\nfunction HtAPI:getList(http_client, id, page)\n    page = tonumber(page) or 1\n    local url = Headers:buildUrl(self.listUrl(id, page))\n    local html, err = http_get(http_client, url)\n    if not html then\n        return false, nil, err\n    end\n    local data, perr = self.parseComicList(html)\n    if not data then\n        return false, nil, perr\n    end\n    data.page = page\n    add_list_total(http_client, data, page, Headers:buildUrl(self.listUrl(id, 1)),\n        Headers:buildUrl(self.listUrl(id, data.pages)))\n    if #data.comics == 0 then\n        -- **解析成功但没有条目 = 真的到底了**, 不是错误。\n        --\n        -- 以前这里返回 false, 理由是\"页面结构可能已变化\" —— 但列表页把 false 当成\n        -- \"这一页加载失败\", 于是用户翻到最后一页会看到\"加载失败\"并且再也翻不动。\n        -- 页面结构真的变了的话, parseComicList 会返回 nil (上面那条分支),\n        -- 与\"空页\"是两件不同的事。\n        if logger.enabled then logger.info(string.format(\"Picayomi htcomic: 第 %d 页没有条目, 视为到底\", page)) end\n    end\n    return true, data\nend\n\n-- ============================================================================\n-- 排行榜 (收藏榜)\n-- ============================================================================\n--\n-- 站点只有**一种**榜单: 收藏排行榜, 用时间维度分档 (今日/本週/本月/今年)。\n-- 路径规则 (2026-10-17 实测):\n--   第 1 页: 收藏排行榜页面              (本週)\n--            /albums-favorite_ranking-type-<T>.html     (T = day/week/month/year)\n--   第 N 页: /albums-favorite_ranking-page-<N>-type-<T>.html\n-- 条目结构与普通列表页完全一致, 所以解析直接复用 parseComicList。\nHtAPI.RANKING_TYPES = { \"day\", \"week\", \"month\", \"year\" }\n\n--- 排行榜地址 (非法 type 一律退回 week, 免得把参数拼进路径)\nfunction HtAPI:rankingUrl(rtype, page)\n    page = tonumber(page) or 1\n    local t = tostring(rtype or \"week\")\n    local valid = false\n    for _i, v in ipairs(self.RANKING_TYPES) do\n        if v == t then valid = true break end\n    end\n    if not valid then t = \"week\" end\n\n    if page <= 1 then\n        if t == \"week\" then return \"/albums-favorite_ranking.html\" end\n        return \"/albums-favorite_ranking-type-\" .. t .. \".html\"\n    end\n    return string.format(\"/albums-favorite_ranking-page-%d-type-%s.html\", page, t)\nend\n\n--- 取排行榜某一页\n-- @param rtype \"day\" | \"week\" | \"month\" | \"year\"\n-- @return ok, { comics = {...}, pages = N, page = N }\nfunction HtAPI:getRanking(http_client, rtype, page)\n    page = tonumber(page) or 1\n    local url = Headers:buildUrl(self:rankingUrl(rtype, page))\n    local html, err = http_get(http_client, url)\n    if not html then\n        return false, nil, err\n    end\n    local data, perr = self.parseComicList(html)\n    if not data then\n        return false, nil, perr\n    end\n    data.page = page\n    add_list_total(http_client, data, page, Headers:buildUrl(self:rankingUrl(rtype, 1)),\n        Headers:buildUrl(self:rankingUrl(rtype, data.pages)))\n    if #data.comics == 0 then\n        if logger.enabled then logger.info(string.format(\"Picayomi htcomic: 排行榜(%s) 第 %d 页没有条目, 视为到底\",\n            tostring(rtype), page)) end\n    end\n    return true, data\nend\n\n--- 搜索 (站点搜索页每页 24 条，分类/列表为 20 条)\nfunction HtAPI:search(http_client, keyword, page)\n    page = tonumber(page) or 1\n    local url = Headers:buildUrl(\"/search/?q=\" .. urlencode(keyword) ..\n        \"&f=_all&s=create_time_DESC&syn=yes\")\n    if page > 1 then\n        url = url .. \"&p=\" .. page\n    end\n    local html, err = http_get(http_client, url)\n    if not html then\n        return false, nil, err\n    end\n    local data, perr = self.parseComicList(html)\n    if not data then\n        return false, nil, perr\n    end\n    data.page = page\n\n    -- 搜索页的分页器只列到第 10 页, 拿不到真实总页数; 但结果数那行给了总条数\n    -- (\"大約有 13,888 項符合查詢結果\"), 除以每页条数就是总页数 —— 比分页器准。\n    -- 取两者较大值: 分页器给的至少是\"站点确实能翻到的页\", 别把它缩小。\n    local doc = parse_html(html)\n    local total\n    if doc then\n        local result = doc:select(\"p.result b\")[1]\n        -- 千位分隔符必须先去掉: \"13,888\" 直接 match(\"(%d+)\") 只会拿到 \"13\",\n        -- 除以每页 24 条算出来是 1 页 —— 搜索同样翻不动页。\n        total = result and tonumber((node_text(result):gsub(\",\", \"\")):match(\"(%d+)\"))\n        if total then\n            -- A short last page must not become the server's page capacity.\n            data.pages = math.max(data.pages or 1, math.ceil(total / 24))\n            -- 顺手把总条数带出去: 列表页脚据此显示\"共 N 项\"。以前只拿它算页数就丢了,\n            -- 于是页脚永远只有\"第 N 页 · 已加载 K 项\"。\n            data.total = total\n            if total == 0 then\n                data.comics = {}\n                data.pages = 1\n            end\n        end\n    end\n    if total == nil and #data.comics == 0 then\n        return false, nil, \"搜索结果数据格式异常，请稍后重试\"\n    end\n    return true, data\nend\n\n-- ============================================================================\n-- 详情\n-- ============================================================================\n\n--- 解析详情页 HTML (纯函数, 便于测试)\n-- @return { _id, title, author, tags, description, pagesCount, thumb, chapters }\nfunction HtAPI._parseComicDetail(html, comic_id)\n    local doc = parse_html(html)\n    if not doc then\n        return nil, \"页面解析失败\"\n    end\n\n    local title = node_text(doc:select(\"div.userwrap h2\")[1])\n    if title == \"\" then\n        -- 容错: 少数作品页解析不出标题(版式不同 / 内容受限)。\n        -- 不要因此判死整个详情页 —— gallery 页与详情页是独立的,\n        -- 降级后用户往往仍能正常阅读。\n        logger.warn(\"Picayomi HtAPI: 详情页未解析到标题, 降级处理 id=\" ..\n            tostring(comic_id))\n        title = \"作品 \" .. tostring(comic_id)\n    end\n\n    -- 封面 (详情页封面在 uwthumb 里)\n    local cover_img = doc:select(\"div.asTBcell.uwthumb img\")[1]\n    local cover = cover_img and cover_img.attributes and cover_img.attributes.src\n    cover = normalize_thumb(cover)\n\n    -- 分類 / 頁數 / 編號\n    --\n    -- 详情页的这三项都是 <label>: \"分類：同人誌／日語\" / \"頁數：20P\" / \"編號：源站251279\"\n    -- (2026-10-18 抓的页面实测)。\n    --\n    -- **分类必须取「分類」这一项**: 以前把 a.tagshow 的标签串当成 categories,\n    -- 于是一行里挤着十几个标签 (かなミ, FUTA, 扶他, hololive…), 真机上被截断,\n    -- 看起来就是\"分类没东西\"。标签是\"標籤\", 不是分类。\n    local pages_count = 0\n    local category, comic_no\n    local labels = doc:select(\"div.asTBcell.uwconn label\")\n    for _i, lb in ipairs(labels) do\n        local t = node_text(lb)\n        local n = t:match(\"頁數[：:%.%s]*(%d+)\")\n        if n then pages_count = tonumber(n) end\n        local cat = t:match(\"^分類[：:%.%s]*(.+)$\") or t:match(\"^分类[：:%.%s]*(.+)$\")\n        if cat and cat ~= \"\" then category = cat end\n        local no = t:match(\"編號[：:%.%s]*([%w%-_]+)\") or t:match(\"编号[：:%.%s]*([%w%-_]+)\")\n        if no and no ~= \"\" then comic_no = no end\n    end\n\n    -- 标签 (必须限定在 div.addtags 里: 合集页的章节链接也用 tagshow 类,\n    -- 宽选择器会把\"第1話 …\"当成标签, 分类那一行会变成一长串章节名)\n    local tags = {}\n    for _i, a in ipairs(doc:select(\"div.addtags a.tagshow\")) do\n        local t = node_text(a)\n        if t ~= \"\" then table.insert(tags, t) end\n    end\n\n    -- 简介 (页面里带\"簡介：\"前缀, 详情页自己已有简介区, 去掉避免重复)\n    local description = node_text(doc:select(\"div.asTBcell.uwconn p\")[1])\n    -- 不能用 [：:] 字符类: Lua 的字符类按**字节**匹配, 会把全角冒号的多字节\n    -- 序列吃掉一半 (文字变成乱码)。前缀与冒号分开剥。\n    description = description:gsub(\"^%s*簡介%s*\", \"\"):gsub(\"^%s*简介%s*\", \"\")\n    description = description:gsub(\"^：%s*\", \"\"):gsub(\"^:%s*\", \"\")\n\n    -- 上传者\n    local uploader = node_text(doc:select(\"div.asTBcell.uwuinfo a p\")[1])\n\n    -- 合集作品: 详情页把各话列成 /photos-slide-aid-<章节id>-sid-<合集id>.html。\n    -- **合集自己的 gallery 页是没有图片的** (只返回一句\"請加入收藏\"的占位),\n    -- 所以必须把每一话当成独立相册去读 —— 否则就是用户看到的\n    -- \"获取漫画图片失败 / 未解析到图片\"。\n    -- 顺序取标题里的\"第N話\", 不能按 DOM 顺序: 站点按上传时间排, 与话数不同序。\n    local chapters = {}\n    for _i, a in ipairs(doc:select(\"div.sr_compact a.tagshow\")) do\n        local attrs = a.attributes or {}\n        local href = attrs.href or \"\"\n        local chid = href:match(\"photos%-slide%-aid%-(%d+)%-sid%-\") or attrs[\"data-chid\"]\n        if chid then\n            local title_attr = attrs.title or \"\"\n            local text = node_text(a)\n            local order = tonumber(title_attr:match(\"第(%d+)話\"))\n                or tonumber(title_attr:match(\"第(%d+)话\"))\n                or tonumber(text:match(\"第(%d+)\"))\n                or (#chapters + 1)\n            table.insert(chapters, {\n                id = tostring(chid),\n                title = text ~= \"\" and text or title_attr,\n                order = order,\n                pages = tonumber(title_attr:match(\"(%d+)P\")),\n            })\n        end\n    end\n    table.sort(chapters, function(x, y) return x.order < y.order end)\n\n    -- 编号放到 meta_text 里, 由详情页接在简介后面。\n    -- 标签通过 tags 单独显示在可点击的标签栏, 不再重复塞进简介。\n    --\n    -- **页数不写在这里**: 详情页表头已经统一显示「25页」(与列表卡片同一个\n    -- ComicStats.line), 再在简介里写一遍 \"25P\" 就是同一个数字两种写法。\n    local meta_bits = {}\n    if comic_no then table.insert(meta_bits, _(\"编号\") .. \" \" .. comic_no) end\n    local meta_text = table.concat(meta_bits, \" · \")\n\n    return {\n        _id = tostring(comic_id),\n        title = title,\n        author = uploader,\n        tags = tags,\n        categories = category or \"\",\n        meta_text = meta_text ~= \"\" and meta_text or nil,\n        description = description,\n        pagesCount = pages_count,\n        -- 合集没有单一页数, 有章节数: 详情页表头显示「11话」(与列表卡片同一个字段)\n        epsCount = #chapters > 0 and #chapters or nil,\n        thumb = cover,\n        chapters = chapters,\n    }\nend\n\n--- 漫画详情\n-- @return (ok, { _id, title, author, tags, description, pagesCount, thumb, chapters }, err)\nfunction HtAPI:getComicDetail(http_client, comic_id)\n    local url = Headers:buildUrl(\"/photos-index-page-1-aid-\" .. tostring(comic_id) .. \".html\")\n    local html, err = http_get(http_client, url)\n    if not html then\n        return false, nil, err\n    end\n    local detail, perr = HtAPI._parseComicDetail(html, comic_id)\n    if not detail then\n        return false, nil, perr\n    end\n    return true, detail\nend\n\n-- ============================================================================\n-- 章节图片\n-- ============================================================================\n\n--- 整章图片 (站点把整章图片放在一个 gallery 页里)\n-- 图片地址形如协议相对地址 (//host/path)\n-- @return (ok, { images = { {url=...}, ... } }, err)\nfunction HtAPI:getChapterImages(http_client, comic_id)\n    local url = Headers:buildUrl(\"/photos-gallery-aid-\" .. tostring(comic_id) .. \".html\")\n    local html, err = http_get(http_client, url)\n    if not html then\n        return false, nil, err\n    end\n\n    -- 图片地址形如 //host/path?verify=<ts>-<sig>\n    -- **必须带上 ?verify=... 签名**, 否则 CDN 返回 403「鏈接已失效」。\n    -- 地址写在页面的 `document.writeln(... var imglist = [{url: host+\"//...\"}])` 里,\n    -- 故按 \"//host/data/...\" 匹配到引号 / 反斜杠 / 空白为止。\n    -- 排除 /data/t/ (那是列表页的缩略图路径, 不是正文大图)。\n    local images = {}\n    local seen = {}\n    for full in html:gmatch(\"(//[%w%.%-]+/data/[^%s\\\"'\\\\<>]+)\") do\n        if not full:find(\"/data/t/\", 1, true) then\n            local u = \"https:\" .. full\n            if not seen[u] then\n                seen[u] = true\n                table.insert(images, { url = u })\n            end\n        end\n    end\n\n    if #images == 0 then\n        -- 有些作品(受限内容)会跳到登录页, 给用户一个能看懂的提示\n        if html:find(\"登錄\", 1, true) or html:find(\"登入\", 1, true)\n           or html:find(\"users-login\", 1, true) then\n            return false, nil, \"该作品需要登录后才能阅读\"\n        end\n        return false, nil, \"未解析到图片 (作品可能已失效)\"\n    end\n    return true, { images = images }\nend\n\nreturn HtAPI\n","auth.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/htcomic/auth.lua\n-- 内置源 C 的登录\n--\n-- 表单登录；成功后会拿到会话 Cookie，后续请求靠它识别身份。\n-- 具体表单字段与返回格式封装在本文件内，不要散落到 UI。\n--\n-- 重要边界:\n--   * 浏览/搜索/阅读**不需要登录** —— 登录只影响收藏夹 (requires_login = false,\n--     见 source/htcomic/init.lua 的 capabilities)。所以首页不会因为未登录被拦住。\n--   * **不落盘密码**。只存站点给的会话 Cookie 和用户名 (与 util/config.lua 的\n--     注释同一个约定: 记住登录靠可撤销的 token/cookie, 不是密码)。\n--   * 会话过期时, 下一次请求会变成匿名 —— 表现为\"收藏突然没了\", 重新登录即可。\n\nlocal Headers = require(\"headers\")\nlocal SecretStore = ctx.secrets\nlocal logger = ctx.logger\nlocal _ = ctx.translate\nlocal json = ctx.json\n\nlocal HtAuth = {}\n\n-- 账号名 (仅用于界面显示; 判断登录态还要求有 Cookie)\nHtAuth.ACCOUNT_KEY = \"source.htcomic.account\"\n\n--- URL 编码 (站点是 UTF-8, 按字节百分号编码即可)\nlocal function urlencode(s)\n    return (tostring(s or \"\"):gsub(\"([^%w%-_%.~])\", function(c)\n        return string.format(\"%%%02X\", string.byte(c))\n    end))\nend\n\n--- 剥掉错误提示里的标签/实体 (站点把文案放在 JSON 的 html 字段里)\nlocal function plain_text(s)\n    s = tostring(s or \"\")\n    s = s:gsub(\"<[^>]*>\", \"\")\n    s = s:gsub(\"&nbsp;\", \" \"):gsub(\"&amp;\", \"&\"):gsub(\"&lt;\", \"<\"):gsub(\"&gt;\", \">\")\n    return (s:gsub(\"^%s+\", \"\"):gsub(\"%s+$\", \"\"))\nend\n\n--- 是否已登录\n--\n-- 判据是\"有会话 Cookie **且** 记着账号名\": 单看 Cookie 不够 —— 站点/CDN 也会\n-- 下发匿名 Cookie, 单看账号名也不够 —— 会话可能已经过期。\nfunction HtAuth:isLoggedIn()\n    return Headers:getCookieString() ~= nil and SecretStore.get(self.ACCOUNT_KEY) ~= nil\nend\n\n--- 登录\n-- @return ok, err\nfunction HtAuth:login(username, password)\n    username = tostring(username or \"\")\n    password = tostring(password or \"\")\n    if username == \"\" or password == \"\" then\n        return false, _(\"请输入用户名和密码\")\n    end\n\n    local url = Headers:buildUrl(\"/users-check_login.html\")\n    local body = table.concat({\n        \"normal=1\",\n        \"login_name=\" .. urlencode(username),\n        \"login_pass=\" .. urlencode(password),\n        \"remember_pass=1\",\n        \"submit=\" .. urlencode(\"登錄\"),\n    }, \"&\")\n\n    local headers = Headers:build(url)\n    headers[\"Content-Type\"] = \"application/x-www-form-urlencoded\"\n\n    local resp, err = ctx.http:post(url, headers, body, 20)\n    if not resp then\n        logger.warn(\"Picayomi HtAuth: 登录请求失败: \" .. tostring(err))\n        return false, _(\"网络请求失败\")\n    end\n    if resp.status_code and resp.status_code >= 400 then\n        return false, \"HTTP \" .. tostring(resp.status_code)\n    end\n\n    local text = tostring(resp.body or \"\")\n    local ok, data = pcall(json.decode, text)\n    if not ok or type(data) ~= \"table\" then\n        logger.warn(\"Picayomi HtAuth: 登录返回不是 JSON: \" .. text:sub(1, 120))\n        return false, _(\"登录失败（返回格式异常）\")\n    end\n\n    if not data.ret then\n        -- 站点给的文案是繁体, 直接透出比\"登录失败\"有用\n        local msg = plain_text(data.html)\n        if logger.enabled then logger.info(\"Picayomi HtAuth: 登录被拒绝: \" .. msg) end\n        return false, msg ~= \"\" and msg or _(\"用户名或密码错误\")\n    end\n\n    local got_cookie = Headers:mergeSetCookie(resp.headers and resp.headers[\"set-cookie\"])\n    if not got_cookie and not Headers:getCookieString() then\n        -- 登录成功却没拿到会话: 后续请求仍是匿名, 当成失败更诚实\n        logger.warn(\"Picayomi HtAuth: 登录成功但没有会话 Cookie\")\n        return false, _(\"登录成功但没有拿到会话 Cookie\")\n    end\n\n    SecretStore.set(self.ACCOUNT_KEY, username)\n    if logger.enabled then logger.info(\"Picayomi HtAuth: 登录成功\") end\n    return true\nend\n\n--- 退出登录 (清 Cookie 与账号名)\nfunction HtAuth:logout()\n    Headers:clearCookies()\n    SecretStore.clear(self.ACCOUNT_KEY)\n    if logger.enabled then logger.info(\"Picayomi HtAuth: 已退出登录\") end\nend\n\n--- 用户资料 (站点没有\"当前用户\"接口, 用登录时记下的用户名)\nfunction HtAuth:getUserProfile()\n    if not self:isLoggedIn() then return nil end\n    local name = SecretStore.get(self.ACCOUNT_KEY) or \"\"\n    return {\n        name = name ~= \"\" and name or _(\"绅士漫画用户\"),\n        username = name,\n    }\nend\n\nreturn HtAuth\n","contract.lua":"-- API v3 projection of this package's existing, independently tested protocol.\n-- Platform state and caches remain private to the implementation.\nlocal V={}\nlocal function identifier(value)\n    assert(type(value)==\"string\" and value~=\"\" or type(value)==\"number\" and value==value and math.abs(value)<math.huge,\"平台标识无效\")\n    return tostring(value)\nend\nfunction V.wrap(ctx,implementation,options)\n    options=options or {}\n    local S={capabilities=implementation.capabilities,access=implementation.access}\n    local order_maps={}\n    local function copy(v)\n        if type(v)==\"userdata\" then return nil end\n        if type(v)~=\"table\" then return v end\n        local out={}; for k,item in pairs(v) do out[k]=copy(item) end; return out\n    end\n    local function failure(err,code)\n        return false,nil,ctx.error(code or \"network\",type(err)==\"string\" and err or \"平台请求失败\",nil,nil,false)\n    end\n    local function fetch(method,...)\n        local was_logged=implementation.isLoggedIn and implementation:isLoggedIn()\n        local called,ok,data,err=pcall(implementation[method],implementation,...)\n        if not called then return failure(\"平台响应结构已变化\",\"protocol_changed\") end\n        if ok~=true then\n            local expired=was_logged and implementation.isLoggedIn and not implementation:isLoggedIn()\n            return failure(err,expired and \"auth_expired\" or \"network\")\n        end\n        return true,data,nil\n    end\n    local function manga(v)\n        local categories=copy(v.categories)\n        if type(categories)==\"string\" then categories=categories~=\"\" and {categories} or {} end\n        return {id=identifier(v._id),title=v.title,cover=v.thumb,author=v.author,description=v.description,\n            tags=copy(v.tags),categories=categories,finished=v.finished,favorite=v.isFavourite,\n            updated_at=v.update_time,stats={chapters=v.epsCount,pages=v.pagesCount,likes=v.likesCount,\n                comments=v.commentsCount,views=v.viewsCount},chineseTeam=v.chineseTeam}\n    end\n    local function comment(v)\n        local replies\n        if type(v.replies)==\"table\" then replies={}; for i,r in ipairs(v.replies) do replies[i]=comment(r) end end\n        return {id=identifier(v._id),content=v.content or \"\",author=copy(v.author) or {name=\"未知用户\"},\n            created_at=v.created_at,likesCount=v.likesCount,repliesCount=v.repliesCount,replies=replies}\n    end\n    local function list(method,request,...)\n        request=request or {}\n        local n=select(\"#\",...)\n        local args={...};args[n+1]=request.page or 1;args[n+2]=request.sort;args[n+3]=request.categories\n        local ok,data,err=fetch(method,unpack(args,1,n+3))\n        if not ok then return false,nil,err end\n        local items={};for i,item in ipairs(data.comics) do items[i]=manga(item) end\n        local more=tonumber(data.pages) and (tonumber(data.page) or request.page or 1)<tonumber(data.pages) or data.has_more==true\n        local total=tonumber(data.total)\n        if options.estimated_total and method==\"getComics\" then total=nil end\n        local page=tonumber(data.page) or request.page or 1\n        local pages=math.max(page,tonumber(data.pages) or page)\n        return true,{items=items,has_more=more,next=more and {page=page+1} or nil,\n            total=total,pagination={mode=\"page\",page=page,pages=pages,page_size=method==\"search\" and 24 or 20}},nil\n    end\n    function S:init()\n        implementation:init()\n        if options.render then ctx.images.register(\"bands\",{stage=\"render\",module=\"scramble\",fn=\"applyContext\",version=1}) end\n        return true,{success=true},nil\n    end\n    function S:getManga(id)\n        local ok,data,err=fetch(\"getComicDetail\",id)\n        if not ok then return false,nil,err end\n        return true,manga(data),nil\n    end\n    function S:getChapters(id)\n        local episodes,seen,map={},{},{}\n        for page=1,200 do\n            local ok,data,err=fetch(\"getChapters\",id,page)\n            if not ok then return false,nil,err end\n            if type(data)~=\"table\" or type(data.episodes)~=\"table\" then return failure(\"平台章节结构已变化\",\"protocol_changed\") end\n            for _,ch in ipairs(data.episodes) do\n                local chapter_id=identifier(ch._id or options.single_chapter_identity and id)\n                if seen[chapter_id] then return failure(\"平台章节身份重复\",\"protocol_changed\") end\n                seen[chapter_id]=true\n                local order=options.legacy_order and ch.order or \"c_\"..chapter_id\n                map[chapter_id]=order\n                episodes[#episodes+1]={id=chapter_id,manga_id=id,title=ch.title,\n                    legacy_order=options.legacy_order and ch.order or nil,page_count=ch.pagesCount}\n                if #episodes>20000 then return failure(\"章节数量超过限额\",\"resource_limit\") end\n            end\n            if page>=(tonumber(data.pages) or 1) then\n                if options.legacy_order then table.sort(episodes,function(a,b) return (tonumber(a.legacy_order) or 0)<(tonumber(b.legacy_order) or 0) end) end\n                order_maps[id]=map\n                return true,{items=episodes,has_more=false,total=#episodes},nil\n            end\n        end\n        return failure(\"章节分页超过限额\",\"resource_limit\")\n    end\n    function S:getPages(id,chapter_id)\n        if not (order_maps[id] and order_maps[id][chapter_id]) then\n            local ok,_,err=self:getChapters(id);if not ok then return false,nil,err end\n        end\n        local order=order_maps[id] and order_maps[id][chapter_id]\n        if order==nil then return failure(\"章节不存在\",\"not_found\") end\n        local ok,data,err=fetch(\"getAllChapterImages\",id,order)\n        if not ok then return false,nil,err end\n        local pages={}\n        for i,image in ipairs(data.images) do\n            local url=type(image)==\"table\" and image.url or image\n            local context,processors\n            if options.render then\n                local bands=ctx.require(\"scramble\").countForUrl(url)\n                if bands>0 then context={bands=bands};processors={render={name=\"bands\",version=1}} end\n            end\n            pages[i]={index=i,resource={url=url},context=context,processors=processors}\n        end\n        return true,{items=pages,complete=true},nil\n    end\n    function S:getImageRequest(resource)\n        local headers,err=implementation:imageHeaders(resource.url)\n        if type(headers)~=\"table\" then return failure(err) end\n        local values={};for k,v in pairs(headers) do values[k]=type(v)==\"number\" and tostring(v) or v end\n        return ctx.imageRequest(resource,values)\n    end\n    function S:getLatest(request) return list(\"getComics\",request) end\n    function S:getRecommendations(request) return list(\"getRecommendations\",request) end\n    function S:search(keyword,request) return list(\"search\",request,keyword) end\n    function S:getCategoryComics(id,request) return list(\"getCategoryComics\",request,id) end\n    function S:getRankings(id,request) return list(\"getRankings\",request,id) end\n    function S:getFavorites(request) return list(\"getFavorites\",request) end\n    function S:getRandom(request) return list(\"getRandom\",request) end\n    function S:getCategories()\n        local ok,data,err=fetch(\"getCategories\")\n        if not ok then return false,nil,err end\n        local items={}; for i,item in ipairs(data) do items[i]={id=tostring(item._id or item.title),title=item.title,isWeb=item.isWeb,link=item.link} end\n        return true,items,nil\n    end\n    function S:getRankingTypes()\n        local items=implementation:getRankingTypes()\n        return true,copy(items),nil\n    end\n    function S:getSortOptions(kind)\n        local items={};for i,item in ipairs(implementation:getSortOptions(kind)) do items[i]={id=item.value,title=item.text} end\n        return true,items,nil\n    end\n    function S:getSession() return true,{logged_in=implementation:isLoggedIn()},nil end\n    function S:getCredential() return true,{token=implementation:getToken()},nil end\n    function S:setCredential(token)\n        if not implementation.setToken then return failure(\"当前源不支持导入会话\",\"unsupported\") end\n        implementation:setToken(token);return true,{success=true},nil\n    end\n    function S:login(...)\n        local ok,err=implementation:login(...)\n        if not ok then return failure(err) end\n        return true,{success=true},nil\n    end\n    function S:logout() implementation:logout();return true,{success=true},nil end\n    function S:getUserProfile()\n        local was_logged=implementation:isLoggedIn()\n        local data,err=implementation:getUserProfile()\n        if not data then\n            local logged=implementation:isLoggedIn()\n            return failure(err,was_logged and not logged and \"auth_expired\" or logged and \"network\" or \"auth_required\")\n        end\n        return true,copy(data),nil\n    end\n    for _,method in ipairs({\"addFavorite\",\"removeFavorite\",\"punchIn\"}) do\n        S[method]=function(_,...)\n            if type(implementation[method])~=\"function\" then return failure(\"当前源不支持此功能\",\"unsupported\") end\n            local ok,err=implementation[method](implementation,...)\n            if not ok then return failure(err) end\n            return true,{success=true},nil\n        end\n    end\n    for method,key in pairs({getComments=\"comments\",getCommentReplies=\"replies\"}) do\n        S[method]=function(_,id,comment_id,request)\n            if key==\"comments\" then request,comment_id=comment_id,nil end\n            local ok,data,err\n            if key==\"comments\" then ok,data,err=fetch(method,id,(request or {}).page or 1)\n            else ok,data,err=fetch(method,id,comment_id,(request or {}).page or 1) end\n            if not ok then return false,nil,err end\n            local items={};for i,item in ipairs(data[key]) do items[i]=comment(item) end\n            local page=tonumber(data.page) or 1;local more=page<(tonumber(data.pages) or 1)\n            return true,{items=items,has_more=more,next=more and {page=page+1} or nil,total=tonumber(data.total)},nil\n        end\n    end\n    return S\nend\nreturn V\n","headers.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/htcomic/headers.lua\n-- 内置源 C 的请求头与 Cookie 管理\n--\n-- 浏览 / 搜索 / 阅读不需要登录；登录只影响收藏类功能。\n-- Cookie 仅在需要会话的请求里携带，不要写入日志。\n\nlocal SecretStore = ctx.secrets\n\nlocal Headers = {}\n\nHeaders.BASE_URL = \"https://www.wnacg.com\"\nHeaders.CONFIG_PREFIX = \"source.htcomic\"\nHeaders.COOKIE_KEY = Headers.CONFIG_PREFIX .. \".cookies\"\n\n-- 站点对 UA 有要求, 用常见桌面浏览器 UA\nHeaders.USER_AGENT = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) \" ..\n    \"AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\"\n\nfunction Headers:getBaseUrl()\n    local base = ctx.getSetting(\"base_url\", self.BASE_URL):gsub(\"/+$\", \"\")\n    assert(base:match(\"^https://[%w%.%-]+$\"), \"网站地址必须为 HTTPS 域名\")\n    return base\nend\n\n-- The site's image markup can start with four slashes. Canonicalize only\n-- the scheme/authority boundary; preserve image paths and signed queries.\nfunction Headers:normalizeImageUrl(src)\n    if type(src) ~= \"string\" then return nil end\n    src = src:gsub(\"^%s+\", \"\"):gsub(\"%s+$\", \"\")\n    if src == \"\" then return nil end\n    if src:match(\"^//\") then return \"https://\" .. src:gsub(\"^/+\", \"\") end\n    if src:match(\"^/\") then return self:getBaseUrl() .. src end\n    return (src:gsub(\"^(https?:)/+\", \"%1//\"))\nend\n\n--- 读取已保存的 Cookie (加密存储; 形如 \"key=value; key2=value2\")\nfunction Headers:getCookieString()\n    local c = SecretStore.get(self.COOKIE_KEY)\n    if c and c ~= \"\" then\n        return c\n    end\n    return nil\nend\n\nfunction Headers:setCookieString(s)\n    if s == nil or s == \"\" then\n        SecretStore.clear(self.COOKIE_KEY)\n        return\n    end\n    SecretStore.set(self.COOKIE_KEY, s)\nend\n\nfunction Headers:clearCookies()\n    SecretStore.clear(self.COOKIE_KEY)\nend\n\n-- Set-Cookie 里这些是**属性**, 不是 cookie (值里还带逗号, 例如 Expires 的日期)\nlocal COOKIE_ATTRS = {\n    expires = true, path = true, domain = true, [\"max-age\"] = true,\n    samesite = true, secure = true, httponly = true, priority = true,\n}\n\n--- 把响应里的 Set-Cookie 合并进已保存的 Cookie 串\n--\n-- 为什么要自己拼: 我们的 HttpClient 是\"请求-响应\"式的, 没有 cookie jar\n-- (network/http_client.lua 只带我们显式给的 Cookie 头)。登录成功后站点把会话\n-- 写在 Set-Cookie 里, 必须自己收下来, 否则下一个请求又是匿名。\n--\n-- 解析按 \"逗号\" 粗切: 单个 cookie 的 key=value 一定在第一个分号之前, 之后的\n-- 属性 (包括带逗号的 Expires) 一律丢掉, 所以切坏了也不影响结果。\n--\n-- @param raw string 或 {string} (luasocket 对重复头会拼成 \"a, b\")\n-- @return 是否至少合并进一个 cookie\nfunction Headers:mergeSetCookie(raw)\n    if not raw then return false end\n    local chunks = type(raw) == \"table\" and raw or { raw }\n\n    local jar = {}\n    local old = self:getCookieString()\n    if old then\n        for k, v in old:gmatch(\"([^=;%s]+)=([^;]*)\") do\n            jar[k] = v\n        end\n    end\n\n    local added = 0\n    for _i, chunk in ipairs(chunks) do\n        for piece in tostring(chunk):gmatch(\"[^,]+\") do\n            local k, v = piece:match(\"^%s*([^=;%s]+)=([^;]*)\")\n            if k and k ~= \"\" and not COOKIE_ATTRS[k:lower()]\n                and k:match(\"^[%w_%-%.]+$\") then\n                jar[k] = v\n                added = added + 1\n            end\n        end\n    end\n\n    if added == 0 then return false end\n\n    -- 排序后落盘: 同样的 cookie 集合永远得到同一个字符串, 配置里好读也便于测试\n    local out = {}\n    for k, v in pairs(jar) do out[#out + 1] = k .. \"=\" .. v end\n    table.sort(out)\n    self:setCookieString(table.concat(out, \"; \"))\n    return true\nend\n\n--- 构造请求头\n-- @param url: 目标 URL (用于决定 Referer)\n-- @param extra: 额外头 (可选)\nfunction Headers:build(url, extra)\n    local h = {\n        [\"User-Agent\"]      = self.USER_AGENT,\n        [\"Accept\"]          = \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n        [\"Accept-Language\"] = \"zh-CN,zh;q=0.9,en;q=0.8\",\n        [\"Referer\"]         = self:getBaseUrl() .. \"/\",\n    }\n\n    local cookies = self:getCookieString()\n    if cookies then\n        h[\"Cookie\"] = cookies\n    end\n\n    if extra then\n        for k, v in pairs(extra) do\n            h[k] = v\n        end\n    end\n\n    return h\nend\n\n--- 图片请求头 (图片 CDN 会校验 Referer)\nfunction Headers:imageHeaders(url)\n    local h = self:build(url)\n    h[\"Accept\"] = \"image/avif,image/webp,image/apng,image/*,*/*;q=0.8\"\n    h[\"Connection\"] = \"close\"\n    return h\nend\n\n--- 构造完整 URL (支持 //host/path 形式的协议相对地址)\nfunction Headers:buildUrl(path)\n    if not path then return nil end\n    if path:match(\"^https?://\") then\n        return path\n    end\n    if path:match(\"^//\") then\n        return \"https:\" .. path\n    end\n    local base = self:getBaseUrl()\n    if path:sub(1, 1) == \"/\" then\n        return base .. path\n    end\n    return base .. \"/\" .. path\nend\n\nreturn Headers\n","init.lua":"local ctx = assert(ctx, \"source SDK context required\")\n-- source/htcomic/init.lua\n-- 源 C (源站) 漫画源入口\n-- 实现 ComicSource 基类接口\n--\n-- 与源 A/源 B 的差异:\n--   * 站点是 HTML 页面, 数据靠 htmlparser 解析 (见 api.lua)\n--   * 浏览 / 搜索 / 阅读**不需要登录**; 登录只影响收藏夹 (见 requires_login)\n--   * 普通作品: 一个相册即一个\"章节\" (order 固定为 1), 整章图片在一个 gallery 页里\n--   * 合集作品: 详情页列出各话 (每话是独立相册, 有各自的 id)。合集自己的 gallery\n--     页没有图片, 所以取图前必须把话号换成该话的相册 id (见 _albumIdFor)\n--   * 有排行榜: 站点的\"收藏排行榜\" (今日/本週/本月/今年), 见 getRankings\n\nlocal logger = ctx.logger\nlocal _ = ctx.translate\nlocal ComicSource = require(\"object\")\nlocal HtAPI = require(\"api\")\nlocal Headers = require(\"headers\")\nlocal HttpClient = ctx.http\n\nlocal HtComicSource = ComicSource:extend{\n    name = \"绅士漫画\",\n    identifier = \"htcomic\",\n    version = \"1.0.0\",\n\n    capabilities = {\n        -- 支持登录, 但**不要求**登录: 免登录源, 首页不该被登录框拦住\n        -- (requires_login 是\"不登录就用不了\"的源才为 true, 见 ui/home.lua)\n        login = true,\n        requires_login = false,\n        search = true,\n        latest = true,\n        categories = true,\n        rankings = true,      -- 收藏排行榜 (今日/本週/本月/今年)\n        random = false,\n        favorites = false,    -- 网络收藏 (需登录, 未实现)\n        comments = false,\n        download = true,\n        local_favorites = true,\n    },\n}\n\n--- 初始化\nfunction HtComicSource:init()\n    self._http_client = HttpClient\n    self._headers = Headers\nend\n\nfunction HtComicSource:_ensureInit()\n    if not self._http_client then\n        self:init()\n    end\nend\n\n-- ==================== 账号 ====================\n\n--- 登录 (只影响收藏夹; 浏览/阅读不需要登录)\nfunction HtComicSource:login(username, password)\n    return require(\"auth\"):login(username, password)\nend\n\nfunction HtComicSource:logout()\n    require(\"auth\"):logout()\nend\n\nfunction HtComicSource:isLoggedIn()\n    return require(\"auth\"):isLoggedIn()\nend\n\nfunction HtComicSource:getToken()\n    -- 站点没有 token 概念, 会话在 Cookie 里; 这里只用来表达\"登录与否\"\n    return self:isLoggedIn() and \"htcomic-session\" or nil\nend\n\nfunction HtComicSource:getUserProfile()\n    return require(\"auth\"):getUserProfile()\nend\n\n-- ==================== 浏览 ====================\n\n--- 首页列表 (\"最新\")\nfunction HtComicSource:getComics(page, _sort)\n    self:_ensureInit()\n    return HtAPI:getList(self._http_client, \"albums\", page)\nend\n\n--- 排行榜类型 (站点只有\"收藏榜\", 用时间维度分档)\nfunction HtComicSource:getRankingTypes()\n    return {\n        { id = \"day\",   title = _(\"今日收藏榜\") },\n        { id = \"week\",  title = _(\"本周收藏榜\") },\n        { id = \"month\", title = _(\"本月收藏榜\") },\n        { id = \"year\",  title = _(\"今年收藏榜\") },\n    }\nend\n\n--- 排行榜某一页\nfunction HtComicSource:getRankings(rtype, page)\n    self:_ensureInit()\n    return HtAPI:getRanking(self._http_client, rtype, page)\nend\n\nfunction HtComicSource:getCategories()\n    self:_ensureInit()\n    return HtAPI:getCategories(self._http_client)\nend\n\n--- 分类浏览 (category 为 parseCategories 给出的 _id, 即站点的路径名)\nfunction HtComicSource:getCategoryComics(category, page, _sort)\n    self:_ensureInit()\n    if not category or category == \"\" then\n        return false, nil, \"无效的分类\"\n    end\n    return HtAPI:getList(self._http_client, category, page)\nend\n\nfunction HtComicSource:search(keyword, page, _sort)\n    self:_ensureInit()\n    if not keyword or keyword == \"\" then\n        return false, nil, \"请输入关键词\"\n    end\n    return HtAPI:search(self._http_client, keyword, page)\nend\n\nfunction HtComicSource:getComicDetail(comic_id)\n    self:_ensureInit()\n    return HtAPI:getComicDetail(self._http_client, comic_id)\nend\n\n-- ==================== 章节 ====================\n-- 一个相册即一个章节\n\nfunction HtComicSource:getChapters(comic_id, _page)\n    self:_ensureInit()\n\n    local ok, detail, err = HtAPI:getComicDetail(self._http_client, comic_id)\n    if not ok then\n        return false, nil, err\n    end\n\n    -- 合集 (多话): 每一话是一个独立相册, 有自己的 id。\n    -- 记住\"话号 -> 相册 id\", 取图时才能换成正确的 gallery 页 —— 合集本身的\n    -- gallery 页没有图片。\n    local chapters = detail.chapters or {}\n    if #chapters > 0 then\n        self._series = self._series or {}\n        local map = {}\n        local episodes = {}\n        for _i, ch in ipairs(chapters) do\n            local order = tonumber(ch.order) or (#episodes + 1)\n            map[order] = ch.id\n            episodes[#episodes + 1] = {\n                _id = ch.id,\n                title = ch.title,\n                order = order,\n                pagesCount = ch.pages,\n            }\n        end\n        self._series[tostring(comic_id)] = map\n        return true, {\n            episodes = episodes,\n            total = #episodes,\n            page = 1,\n            pages = 1,\n        }\n    end\n\n    return true, {\n        episodes = {\n            {\n                title = detail.title,\n                order = \"1\",\n                pagesCount = detail.pagesCount,\n            },\n        },\n        total = 1,\n        page = 1,\n        pages = 1,\n    }\nend\n\n--- 这一话对应的相册 id\n--\n-- 单本作品就是它自己; 合集要换成该话的相册 id。映射是 getChapters 建的内存表,\n-- 阅读器重启/下载子进程里可能没有 —— 那就重新拉一次详情页重建 (详情页有缓存,\n-- 通常不额外发请求)。\nfunction HtComicSource:_albumIdFor(comic_id, chapter_order)\n    local key = tostring(comic_id)\n    local map = self._series and self._series[key]\n    if not map then\n        local ok = self:getChapters(comic_id)\n        map = ok and self._series and self._series[key] or nil\n    end\n    local order = tonumber(chapter_order)\n    local id = map and order and map[order]\n    return id or key\nend\n\nfunction HtComicSource:getChapterImages(comic_id, chapter_order, _page)\n    return self:getAllChapterImages(comic_id, chapter_order)\nend\n\nfunction HtComicSource:getAllChapterImages(comic_id, chapter_order)\n    self:_ensureInit()\n    local album_id = self:_albumIdFor(comic_id, chapter_order)\n    return HtAPI:getChapterImages(self._http_client, album_id)\nend\n\n-- ==================== 图片下载 ====================\n\n--- 图片请求头 (图片 CDN 校验 Referer)\nfunction HtComicSource:imageHeaders(url)\n    self:_ensureInit()\n    return Headers:imageHeaders(url)\nend\n\n--- 下载单张图片 (图片 CDN 校验 Referer)\nfunction HtComicSource:downloadImage(url, dest_path, timeout)\n    if not url or not dest_path then\n        return nil, \"缺少参数\"\n    end\n    local h, herr = self:imageHeaders(url)\n    if not h then\n        return nil, herr\n    end\n    -- 同步下载: 超时越长界面冻结越久\n    return self._http_client:download(url, dest_path, h, timeout or 20)\nend\n\nfunction HtComicSource:getLatest(page, sort) return self:getComics(page, sort) end\n\nreturn HtComicSource\n","main.lua":"return function(ctx)\n    local source = ctx.require(\"contract\").wrap(ctx,ctx.require(\"init\"),{legacy_order=true,single_chapter_identity=true})\n    local headers = ctx.require(\"headers\")\n    local get_image_request = source.getImageRequest\n    function source:getImageRequest(resource, ...)\n        -- Old history/cache entries may still contain the malformed address.\n        -- Repair it at dispatch too, without rewriting the caller's record.\n        local normalized = {}\n        for key, value in pairs(resource) do normalized[key] = value end\n        normalized.url = headers:normalizeImageUrl(resource.url)\n        return get_image_request(self, normalized, ...)\n    end\n    return source\nend\n","object.lua":"-- Private adapter helper, not a host base class or a public source contract.\nlocal O={}\nfunction O:extend(child) return setmetatable(child,{__index=self}) end\nfunction O:hasCapability(name) return self.capabilities[name]==true end\nfunction O:init() end\nfunction O:getToken() return nil end\nfunction O:isLoggedIn() return self:getToken()~=nil end\nfunction O:getSortOptions() return {} end\nfunction O:isCachedImageStale() return false end\nreturn O\n"},"format":1,"manifest":{"api_version":3,"author":"PicaYomi source maintainers","cache_schema_version":1,"data_schema_version":1,"entry":"main.lua","id":"htcomic","identity_policy":"legacy","min_app_version":"0.11.20","name":"绅士漫画","publisher_id":"picayomi.legacy","settings":[{"default":"https://www.wnacg.com","key":"base_url","title":"网站地址"}],"version":"1.1.5"}}